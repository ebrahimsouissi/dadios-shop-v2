---
export interface Props {
  product: {
    slug: string;
    name: string;
    gender: string;
    family: string;
    featured?: boolean;
    image?: string;
    shortDescription?: string;
  };
  sizes: Array<{ code: string; label: string; price: number }>;
}
const { product, sizes } = Astro.props;
const hasImage = product.image && product.image.length > 0;
---
<a href={`/parfums/${product.slug}`} class="card" data-card-slug={product.slug}>
  <div class="card-img">
    {hasImage ? (
      <img src={product.image} alt={`${product.name} - Dadios Fragrance`} loading="lazy" />
    ) : (
      <svg viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg" aria-label={product.name}>
        <rect x="68" y="34" width="64" height="160" rx="3" fill="#0E3A1F"/>
        <rect x="68" y="34" width="64" height="160" rx="3" fill="none" stroke="rgba(212,175,55,0.5)" stroke-width="0.8"/>
        <rect x="78" y="84" width="44" height="68" fill="#0E3A1F"/>
        <rect x="78" y="84" width="44" height="68" fill="none" stroke="#D4AF37" stroke-width="0.6"/>
        <text x="100" y="108" text-anchor="middle" font-family="Allura, cursive" font-size="20" fill="#D4AF37">Dadios</text>
        <text x="100" y="124" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="6" letter-spacing="3" fill="#D4AF37">FRAGRANCE</text>
        <line x1="86" y1="132" x2="114" y2="132" stroke="#D4AF37" stroke-width="0.4"/>
        <text x="100" y="144" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="5" fill="#D4AF37">{product.name}</text>
        <rect x="84" y="14" width="32" height="22" rx="2" fill="#A87C45"/>
        <rect x="88" y="8" width="24" height="10" rx="1.5" fill="#A87C45"/>
      </svg>
    )}
    <span class="card-gender">{product.gender}</span>
    {product.featured && <span class="card-badge">Bestseller</span>}
    <span
      class="card-heart"
      data-wishlist-toggle
      data-slug={product.slug}
      role="button"
      tabindex="0"
      aria-label="Ajouter aux favoris"
      aria-pressed="false"
    >
      <svg class="heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </span>
  </div>
  <div class="card-body">
    <div class="eyebrow card-family">{product.family}</div>
    <h3 class="card-name">{product.name}</h3>
    <p class="card-desc">{product.shortDescription || ''}</p>
    <div class="card-sizes">
      {sizes.map(s => (
        <span class="size-chip">{s.code} · {s.price} DT</span>
      ))}
    </div>
    <div class="card-cta">Voir le parfum →</div>
  </div>
</a>

<style>
  .card {
    display: block;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: all .3s ease;
    color: inherit;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }
  .card-img {
    position: relative;
    aspect-ratio: 1;
    background: var(--cream-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .card-img svg { width: 60%; height: auto; }
  .card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-gender {
    position: absolute;
    top: 12px;
    left: 14px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--cream-soft);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .card-badge {
    position: absolute;
    bottom: 12px;
    left: 14px;
    background: var(--emerald);
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 0.18em;
    padding: 4px 10px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .card-vip-badge {
    position: absolute;
    bottom: 12px;
    right: 14px;
    background: var(--gold);
    color: var(--emerald-deep);
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 500;
    box-shadow: 0 2px 6px rgba(212, 175, 55, 0.35);
  }
  .card-wholesale {
    background: rgba(14, 58, 31, 0.06);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .card-wholesale-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .card-wholesale-price {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--emerald);
    font-weight: 500;
  }
  .card-heart {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--ink-mute);
    transition: transform .15s ease-out, background .2s, color .2s, border-color .2s;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(5, 26, 14, 0.08);
    user-select: none;
  }
  .card-heart:hover {
    color: var(--emerald);
    background: var(--cream);
  }
  .card-heart .heart-icon { width: 18px; height: 18px; pointer-events: none; }
  .card-heart.filled {
    background: var(--emerald);
    border-color: var(--emerald);
    color: var(--gold);
  }
  .card-heart.filled .heart-icon { fill: var(--gold); stroke: var(--gold); }
  .card-heart.bump { animation: dadiosHeartBump 180ms ease-out; }
  @keyframes dadiosHeartBump {
    0% { transform: scale(1); }
    50% { transform: scale(1.22); }
    100% { transform: scale(1); }
  }
  .card-heart:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 2px;
  }
  .card-body { padding: 20px 22px 22px; }
  .card-family { margin-bottom: 6px; }
  .card-name { font-size: 22px; margin-bottom: 14px; }
  /* Hidden by default — revealed only in the /parfums/ "grid-1" view mode
     via :global() override on the parent .cat-grid.view-grid-1. */
  .card-desc {
    display: none;
    font-size: 13px;
    color: var(--ink-soft);
    margin: -6px 0 14px;
    line-height: 1.55;
  }
  .card-sizes { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .size-chip {
    border: 1px solid var(--border-strong);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--ink);
    background: var(--cream);
  }
  .card-cta {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--emerald);
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
</style>
