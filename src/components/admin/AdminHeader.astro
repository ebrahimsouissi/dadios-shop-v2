---
/**
 * Sticky top bar — burger (mobile) + brand + search + bell + user menu.
 * Markup only; all interactive behavior lives in AdminLayout's inline
 * <script> so each component stays declarative.
 */
---
<header class="admin-topbar">
  <button type="button" class="admin-burger" id="adminBurger"
          aria-label="Ouvrir le menu" aria-controls="adminDrawer" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2"
         fill="none" stroke-linecap="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <a href="/admin" class="admin-topbar-brand">
    <span class="admin-topbar-wordmark">Dadios</span>
    <span class="admin-topbar-tag">Admin</span>
  </a>

  <button type="button" class="admin-search-btn" id="adminSearchBtn" aria-label="Rechercher (Ctrl+K)">
    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2"
         fill="none" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <line x1="21" y1="21" x2="16.5" y2="16.5"/>
    </svg>
    <span class="admin-search-label">Rechercher…</span>
    <kbd class="admin-search-kbd">⌘K</kbd>
  </button>

  <div class="admin-topbar-right">
    <button type="button" class="admin-bell" id="adminBellBtn" aria-label="Notifications" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2"
           fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8A6 6 0 1 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span class="admin-bell-badge" id="adminBellBadge" hidden>0</span>
    </button>

    <button type="button" class="admin-user-btn" id="adminUserBtn" aria-haspopup="true" aria-expanded="false">
      <span class="admin-user-avatar" id="adminUserAvatar" aria-hidden="true">A</span>
      <span class="admin-user-name" id="adminUserName">—</span>
      <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2"
           fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </div>

  <!-- Notifications dropdown (filled by JS) -->
  <div class="admin-bell-menu" id="adminBellMenu" hidden>
    <div class="admin-bell-head">
      <strong>Notifications</strong>
    </div>
    <div class="admin-bell-list" id="adminBellList">
      <div class="admin-bell-empty">Tout est à jour ✨</div>
    </div>
  </div>

  <!-- User menu dropdown -->
  <div class="admin-user-menu" id="adminUserMenu" hidden>
    <a href="/compte/dashboard">Mon profil</a>
    <a href="/" target="_blank" rel="noopener">Voir le site public ↗</a>
    <button type="button" id="adminLogoutBtn">Se déconnecter</button>
  </div>
</header>

<style>
  .admin-topbar {
    grid-area: topbar;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ad-paper);
    border-bottom: 1px solid var(--ad-border);
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 0 16px;
    box-shadow: 0 1px 3px rgba(15, 81, 50, 0.04);
  }
  @media (min-width: 768px) {
    .admin-topbar { grid-template-columns: 44px minmax(0, 1fr) minmax(220px, 480px) auto; padding: 0 24px; }
  }
  @media (min-width: 1024px) {
    .admin-topbar { grid-template-columns: minmax(280px, 480px) 1fr auto; padding: 0 24px; }
  }

  /* Burger only on mobile */
  .admin-burger {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: var(--ad-ink);
    cursor: pointer;
  }
  .admin-burger:hover, .admin-burger:active { background: rgba(15, 81, 50, 0.06); }
  @media (min-width: 1024px) {
    .admin-burger { display: none; }
  }

  .admin-topbar-brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--ad-ink);
    min-width: 0;
    overflow: hidden;
  }
  .admin-topbar-wordmark {
    font-family: var(--ad-font-display);
    font-style: italic;
    font-size: 24px;
    color: var(--ad-gold);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .admin-topbar-tag {
    font-family: var(--ad-font-body);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ad-ink-soft);
  }
  @media (min-width: 1024px) {
    /* Sidebar carries the brand on desktop */
    .admin-topbar-brand { display: none; }
  }

  /* Search button — pill style, opens the modal */
  .admin-search-btn {
    display: none;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--ad-border);
    border-radius: 8px;
    background: var(--ad-cream);
    color: var(--ad-ink-soft);
    cursor: pointer;
    font-family: var(--ad-font-body);
    font-size: 13px;
    min-width: 0;
  }
  .admin-search-btn:hover { border-color: var(--ad-gold); color: var(--ad-ink); }
  .admin-search-label {
    flex: 1;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .admin-search-kbd {
    font-family: var(--ad-font-body);
    font-size: 11px;
    background: var(--ad-paper);
    border: 1px solid var(--ad-border);
    border-radius: 4px;
    padding: 2px 6px;
    color: var(--ad-ink-soft);
  }
  @media (min-width: 768px) {
    .admin-search-btn { display: inline-flex; }
  }

  .admin-topbar-right { display: flex; align-items: center; gap: 6px; position: relative; }

  /* Bell button */
  .admin-bell {
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: var(--ad-ink);
    cursor: pointer;
    border-radius: 8px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .admin-bell:hover { background: rgba(15, 81, 50, 0.06); }
  .admin-bell-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--ad-danger);
    color: white;
    font-size: 10px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    padding: 0 4px;
    box-sizing: border-box;
  }
  .admin-bell-badge[hidden] { display: none; }

  /* User button */
  .admin-user-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 10px 0 6px;
    border: none;
    background: transparent;
    color: var(--ad-ink);
    cursor: pointer;
    border-radius: 8px;
    font-family: var(--ad-font-body);
    font-size: 13px;
  }
  .admin-user-btn:hover { background: rgba(15, 81, 50, 0.06); }
  .admin-user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ad-emerald);
    color: var(--ad-gold);
    font-weight: 600;
    font-size: 13px;
  }
  .admin-user-name { display: none; }
  @media (min-width: 768px) {
    .admin-user-name { display: inline; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }

  /* Dropdowns */
  .admin-user-menu, .admin-bell-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 240px;
    max-width: 340px;
    background: var(--ad-paper);
    border: 1px solid var(--ad-border);
    border-radius: 12px;
    box-shadow: 0 12px 36px -8px rgba(15, 81, 50, 0.18);
    overflow: hidden;
    z-index: 60;
  }
  .admin-user-menu[hidden], .admin-bell-menu[hidden] { display: none; }
  .admin-user-menu a, .admin-user-menu button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    font-size: 14px;
    color: var(--ad-ink);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--ad-font-body);
    text-decoration: none;
  }
  .admin-user-menu a:hover, .admin-user-menu button:hover { background: var(--ad-cream); }
  .admin-user-menu button { color: var(--ad-danger); border-top: 1px solid var(--ad-border); }

  .admin-bell-head {
    padding: 12px 16px 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ad-ink-mute);
  }
  .admin-bell-list { max-height: 360px; overflow-y: auto; padding: 4px; }
  .admin-bell-empty { padding: 24px 16px; text-align: center; color: var(--ad-ink-mute); font-style: italic; }
  .admin-bell-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--ad-ink);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.45;
  }
  .admin-bell-item:hover { background: var(--ad-cream); }
  .admin-bell-icon { font-size: 16px; flex-shrink: 0; }
  .admin-bell-text strong { font-weight: 600; }
</style>
