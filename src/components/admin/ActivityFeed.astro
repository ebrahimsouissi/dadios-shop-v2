---
/**
 * Recent activity timeline. The dashboard JS fills `#activityFeed` with
 * <li> rows (icon + text + relative timestamp) — this component just
 * renders the card shell.
 */
export interface Props {
  id?: string;
  title?: string;
}
const { id = 'activityFeed', title = 'Activité récente' } = Astro.props;
---
<div class="activity-card">
  <div class="activity-head">
    <h3>{title}</h3>
  </div>
  <ul class="activity-list" id={id}>
    <li class="activity-loading">Chargement…</li>
  </ul>
</div>

<style>
  .activity-card {
    background: var(--ad-paper);
    border: 1px solid var(--ad-border);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 1px 3px rgba(15, 81, 50, 0.04);
  }
  .activity-head { margin-bottom: 14px; }
  .activity-head h3 {
    font-family: var(--ad-font-display);
    font-size: 18px;
    margin: 0;
    font-weight: 500;
  }
  .activity-list { list-style: none; padding: 0; margin: 0; }
  .activity-list li {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 10px;
    align-items: start;
    padding: 12px 0;
    border-bottom: 1px dotted var(--ad-border);
    font-size: 13px;
  }
  .activity-list li:last-child { border-bottom: none; }
  .activity-loading, .activity-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 30px 16px;
    color: var(--ad-ink-mute);
    font-style: italic;
    border: none;
  }
  .activity-icon-cell {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--ad-cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }
  .activity-text { line-height: 1.45; color: var(--ad-ink); }
  .activity-text strong { font-weight: 600; }
  .activity-meta {
    font-size: 12px;
    color: var(--ad-ink-mute);
    margin-top: 2px;
  }
  .activity-time {
    color: var(--ad-ink-mute);
    font-size: 11px;
    white-space: nowrap;
    padding-top: 4px;
  }
</style>
