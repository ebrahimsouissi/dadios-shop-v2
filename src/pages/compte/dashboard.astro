</style>

<script>
  import { me, updateProfile, logout, isLoggedIn } from '../../scripts/customerApi.js';
  import { listMyOrders } from '../../scripts/ordersApi.js';
  import { getWishlist, refreshFromServer as refreshWishlist, onWishlistChange } from '../../scripts/wishlist.js';

  const loading = document.getElementById('dashLoading') as HTMLElement;
  const main = document.getElementById('dashMain') as HTMLElement;
  const greeting = document.getElementById('greeting') as HTMLElement;
  const welcomeNote = document.getElementById('welcomeNote') as HTMLElement;
  const viewName = document.getElementById('viewName') as HTMLElement;
  const viewPhone = document.getElementById('viewPhone') as HTMLElement;
  const viewAddress = document.getElementById('viewAddress') as HTMLElement;
  const profileView = document.getElementById('profileView') as HTMLElement;
  const profileEdit = document.getElementById('profileEdit') as HTMLFormElement;
  const editBtn = document.getElementById('editBtn') as HTMLButtonElement;
  const cancelEdit = document.getElementById('cancelEdit') as HTMLButtonElement;
  const saveEdit = document.getElementById('saveEdit') as HTMLButtonElement;
  const editName = document.getElementById('editName') as HTMLInputElement;
  const editPhone = document.getElementById('editPhone') as HTMLInputElement;
  const editAddress = document.getElementById('editAddress') as HTMLTextAreaElement;
  const editErr = document.getElementById('editErr') as HTMLElement;
  const editOk = document.getElementById('editOk') as HTMLElement;
  const loyaltyHas = document.getElementById('loyaltyHas') as HTMLElement;
  const loyaltyNone = document.getElementById('loyaltyNone') as HTMLElement;
  const loyaltyCodeEl = document.getElementById('loyaltyCode') as HTMLElement;
  const stampsRow = document.getElementById('stampsRow') as HTMLElement;
  const stampsLabel = document.getElementById('stampsLabel') as HTMLElement;
  const rewardsLabel = document.getElementById('rewardsLabel') as HTMLElement;
  const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;

  function bounceToLogin() {
    window.location.replace('/compte');
  }

  function renderProfile(c: any) {
    greeting.textContent = c.name ? `Bonjour, ${c.name}` : 'Bonjour, cher client';
    viewName.textContent = c.name || '—';
    viewName.classList.toggle('muted', !c.name);
    viewPhone.textContent = c.phone || '—';
    viewAddress.textContent = c.address || '—';
    viewAddress.classList.toggle('muted', !c.address);

    editName.value = c.name || '';
    editPhone.value = c.phone || '';
    editAddress.value = c.address || '';
  }

  // ===== Tier UI =====
  const tierBadge = document.getElementById('tierBadge') as HTMLElement;
  const conciergeTile = document.getElementById('conciergeTile') as HTMLElement;
  const resellerSection = document.getElementById('resellerSection') as HTMLElement;
  const resCompany = document.getElementById('resCompany') as HTMLInputElement;
  const resMatricule = document.getElementById('resMatricule') as HTMLInputElement;
  const resDelivery = document.getElementById('resDelivery') as HTMLTextAreaElement;
  const resForm = document.getElementById('resellerForm') as HTMLFormElement;
  const resSave = document.getElementById('resSave') as HTMLButtonElement;
  const resErr = document.getElementById('resErr') as HTMLElement;
  const resOk = document.getElementById('resOk') as HTMLElement;
  const loyaltyVipNote = document.getElementById('loyaltyVipNote') as HTMLElement;

  function renderTier(c: any) {
    const tier = c.tier || 'regular';
    if (tier === 'vip') {
      tierBadge.className = 'tier-badge vip';
      tierBadge.innerHTML = '<span>👑 VIP</span><span class="tier-sub">Accès privilégié activé</span>';
      tierBadge.hidden = false;
      if (conciergeTile) conciergeTile.hidden = false;
      if (loyaltyVipNote) loyaltyVipNote.hidden = false;
      if (fidVip) fidVip.hidden = false;
    } else if (tier === 'reseller') {
      tierBadge.className = 'tier-badge reseller';
      tierBadge.innerHTML = '<span>💼 Reseller</span><span class="tier-sub">Compte professionnel</span>';
      tierBadge.hidden = false;
      if (resellerSection) resellerSection.hidden = false;
      resCompany.value = c.companyName || '';
      resMatricule.value = c.matriculeFiscale || '';
      resDelivery.value = c.deliveryAddress || '';
    } else {
      tierBadge.hidden = true;
      tierBadge.innerHTML = '';
    }
  }

  resForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    resErr.hidden = true; resOk.hidden = true;
    resSave.disabled = true;
    resSave.textContent = 'Enregistrement…';
    try {
      const res = await updateProfile({
        // Server preserves existing name/address if we don't pass them,
        // but we DO pass them so the worker's payload stays consistent
        // with the form (it sets these fields explicitly to the values
        // we send). Read current values from the profile-view dts.
        // @ts-ignore — these are sent through updateProfile signature
        // even if it doesn't declare them in TypeScript.
        name: (document.getElementById('viewName')?.textContent || '').replace(/^—$/, ''),
        address: (document.getElementById('viewAddress')?.textContent || '').replace(/^—$/, ''),
        companyName: resCompany.value.trim(),
        matriculeFiscale: resMatricule.value.trim(),
        deliveryAddress: resDelivery.value.trim(),
      } as any);
      if (!res.ok) {
        if (res.error === 'Session invalide') return bounceToLogin();
        resErr.textContent = res.error || 'Enregistrement impossible.';
        resErr.hidden = false;
        return;
      }
      resOk.hidden = false;
      setTimeout(() => { resOk.hidden = true; }, 1800);
    } finally {
      resSave.disabled = false;
      resSave.textContent = 'Enregistrer';
    }
  });

  // Phase 11: card-shaped loyalty card. Element refs grabbed once, reused
  // across renderLoyalty calls (login → me() → renderLoyalty).
  const fidCard = document.getElementById('fidCard') as HTMLElement;
  const fidStamps = document.getElementById('fidStamps') as HTMLElement;
  const fidCount = document.getElementById('fidCount') as HTMLElement;
  const fidName = document.getElementById('fidName') as HTMLElement;
  const fidVip = document.getElementById('fidVip') as HTMLElement;
  const fidFine = document.getElementById('fidFine') as HTMLElement;

  const LOYALTY_PREV_KEY = 'loyalty-last-count';
  const PREFERS_REDUCED = typeof matchMedia === 'function'
    && matchMedia('(prefers-reduced-motion: reduce)').matches;

  // SEAU shape — a simple 4-pointed compass star, fills the stamp circle.
  function seauSvg() {
    return `<svg class="sceau" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 1 L14.4 9.6 L23 12 L14.4 14.4 L12 23 L9.6 14.4 L1 12 L9.6 9.6 Z"/>
    </svg>`;
  }

  function readPrevStampCount(): number {
    try {
      const raw = localStorage.getItem(LOYALTY_PREV_KEY);
      const n = raw == null ? -1 : Number(raw);
      return Number.isFinite(n) ? n : -1;
    } catch { return -1; }
  }
  function writePrevStampCount(n: number) {
    try { localStorage.setItem(LOYALTY_PREV_KEY, String(n)); } catch {}
  }

  // Render the 8 stamps. `stamps` is the count in the *current* 0–7 cycle
  // (the worker rolls over at 8 and increments rewards). The newestIndex
  // (if any) gets .stamp-new for the pulse-glow animation.
  function renderStamps(stamps: number, newestIndex: number | null) {
    fidStamps.innerHTML = '';
    for (let i = 0; i < 8; i++) {
      const cell = document.createElement('div');
      const filled = i < stamps;
      const newest = newestIndex !== null && i === newestIndex;
      cell.className = `fid-stamp ${filled ? 'filled' : 'empty'}`;
      cell.setAttribute('role', 'listitem');
      cell.setAttribute(
        'aria-label',
        filled ? `Tampon n°${i + 1} obtenu` : `Tampon n°${i + 1} à obtenir`,
      );
      if (filled) cell.innerHTML = seauSvg();
      if (!PREFERS_REDUCED) {
        cell.classList.add(newest ? 'stamp-new' : 'stamp-enter');
        if (!newest) cell.style.animationDelay = `${i * 150}ms`;
      }
      fidStamps.appendChild(cell);
    }
  }

  function renderLoyalty(loyalty: any) {
    if (!loyalty || !loyalty.code) {
      loyaltyHas.hidden = true;
      loyaltyNone.hidden = false;
      return;
    }
    loyaltyNone.hidden = true;
    loyaltyHas.hidden = false;
    loyaltyCodeEl.textContent = loyalty.code;

    const stamps = Math.max(0, Math.min(8, Number(loyalty.stamps) || 0));

    // Decide whether the latest stamp should pulse: only if the count
    // strictly increased since the last visit. After the rewards roll-over
    // (stamps was 7, now 0), the user gets a fresh card — skip the pulse
    // since there's no visible "new" stamp.
    const prev = readPrevStampCount();
    let newestIndex: number | null = null;
    if (!PREFERS_REDUCED && stamps > 0 && prev >= 0 && stamps > prev) {
      newestIndex = stamps - 1;
    }
    writePrevStampCount(stamps);

    renderStamps(stamps, newestIndex);
    fidCount.textContent = `${stamps} / 8 tampons`;
    if (stampsLabel) stampsLabel.textContent = `${stamps} / 8 tampons sur cette carte`;
    const rewards = Number(loyalty.rewards) || 0;
    rewardsLabel.textContent = rewards === 0
      ? 'Aucun cadeau pour le moment'
      : rewards === 1
        ? '1 cadeau gagné'
        : `${rewards} cadeaux gagnés`;

    // Conditional message under the card. Three states:
    //   - 0 stamps + 0 rewards = brand-new card → welcome copy
    //   - 8 stamps                              = reward ready to claim
    //   - otherwise                             = standard progress copy
    if (fidFine) {
      fidFine.classList.remove('reward-ready');
      if (stamps === 8) {
        const code = loyalty.code || '';
        fidFine.textContent = `🎁 Félicitations ! Votre cadeau vous attend. Présentez votre code ${code} en boutique pour le récupérer.`;
        fidFine.classList.add('reward-ready');
      } else if (stamps === 0 && rewards === 0) {
        fidFine.textContent = 'Bienvenue dans le programme fidélité Dadios ! Collectez 8 tampons et recevez un cadeau exclusif.';
      } else {
        fidFine.textContent = 'Présentez votre code en boutique pour gagner un tampon à chaque achat. À 8 tampons, votre cadeau est offert.';
      }
    }

    // Card name = customer.name from the most recent renderProfile call.
    // viewName is updated synchronously in renderProfile before us.
    if (fidName) {
      const nameText = (document.getElementById('viewName')?.textContent || '').trim();
      fidName.textContent = nameText && nameText !== '—' ? nameText : '';
    }

    // Trigger card-enter once per visit, not on subsequent re-renders.
    if (!PREFERS_REDUCED && !fidCard.dataset.entered) {
      fidCard.dataset.entered = '1';
      fidCard.classList.add('card-enter');
    }
  }

  // ===== Desktop hover tilt =====
  // Sets CSS vars on the card so the transform stays in sync with the mouse
  // without React-style state. No-ops on touch / reduced-motion.
  function bindCardTilt() {
    if (PREFERS_REDUCED) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;
    const card = fidCard;
    if (!card) return;
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const dx = ((e.clientX - r.left) / r.width) - 0.5;   // -0.5 .. 0.5
      const dy = ((e.clientY - r.top) / r.height) - 0.5;
      card.style.setProperty('--tilt-y', `${dx * 4}deg`);   // ±2deg
      card.style.setProperty('--tilt-x', `${-dy * 4}deg`);  // ±2deg
    });
    card.addEventListener('mouseleave', () => {
      card.style.setProperty('--tilt-y', '0deg');
      card.style.setProperty('--tilt-x', '0deg');
    });
  }
  bindCardTilt();

  function applyWelcomeFlag() {
    const qp = new URLSearchParams(window.location.search);
    const w = qp.get('welcome');
    if (w === 'loyalty') {
      welcomeNote.textContent = '✓ Bienvenue ! Nous avons reconnu votre carte fidélité existante.';
      welcomeNote.hidden = false;
    } else if (w === '1') {
      welcomeNote.textContent = '✓ Bienvenue ! Votre compte est actif.';
      welcomeNote.hidden = false;
    }
    const ordered = qp.get('ordered');
    if (ordered === '1') {
      const orderedNote = document.getElementById('orderedNote');
      if (orderedNote) {
        orderedNote.textContent = '✓ Commande enregistrée. Confirmation par WhatsApp.';
        orderedNote.hidden = false;
      }
    }
    if (w || ordered) {
      const url = new URL(window.location.href);
      url.searchParams.delete('welcome');
      url.searchParams.delete('ordered');
      window.history.replaceState({}, '', url.toString());
    }
  }

  // ===== Orders =====
  const ordersLoading = document.getElementById('ordersLoading') as HTMLElement;
  const ordersEmpty = document.getElementById('ordersEmpty') as HTMLElement;
  const ordersList = document.getElementById('ordersList') as HTMLElement;

  const STATUS_LABEL: Record<string, string> = {
    pending: 'En attente',
    confirmed: 'Confirmée',
    delivered: 'Livrée',
    cancelled: 'Annulée',
  };

  function escHtml(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]);
  }
  function shortId(uuid: string) {
    return String(uuid || '').replace(/-/g, '').substring(0, 8);
  }
  function fmtDate(iso: string) {
    if (!iso) return '';
    try {
      return new Date(iso).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
    } catch { return iso; }
  }

  function renderOrder(o: any) {
    const itemsHtml = (o.items || [])
      .map((i: any) => {
        const sub = (Number(i.price) || 0) * (Number(i.qty) || 1);
        const sizeStr = i.size ? ` (${escHtml(i.size)})` : '';
        return `<li><span class="li-name">${Number(i.qty) || 1}× ${escHtml(i.name)}${sizeStr}</span><span class="li-val">${sub} DT</span></li>`;
      })
      .join('');
    const status = String(o.status || 'pending');
    return `<article class="order-card">
      <header class="order-head">
        <div>
          <span class="order-ref">Commande #${escHtml(shortId(o.id))}</span>
          <span class="order-date">${escHtml(fmtDate(o.createdAt))}</span>
        </div>
        <span class="order-status ${escHtml(status)}">${escHtml(STATUS_LABEL[status] || status)}</span>
      </header>
      <ul class="order-items">${itemsHtml}</ul>
      <div class="order-total"><span class="lbl">Total</span><span class="val">${Number(o.total) || 0} DT</span></div>
    </article>`;
  }

  async function loadOrders() {
    ordersLoading.hidden = false;
    ordersEmpty.hidden = true;
    ordersList.hidden = true;
    const res = await listMyOrders();
    ordersLoading.hidden = true;
    if (!res.ok) {
      // Auth failure handled at mount; here we just degrade quietly.
      ordersEmpty.hidden = false;
      return;
    }
    const orders = (res.orders || []) as any[];
    if (!orders.length) {
      ordersEmpty.hidden = false;
      return;
    }
    ordersList.innerHTML = orders.map(renderOrder).join('');
    ordersList.hidden = false;
  }

  // ===== Favoris count tile =====
  const favorisCountEl = document.getElementById('favorisCount') as HTMLElement;
  function renderFavorisCount() {
    favorisCountEl.textContent = String(getWishlist().length);
  }
  onWishlistChange(renderFavorisCount);

  function showErr(el: HTMLElement, msg: string) { el.textContent = msg; el.hidden = false; }
  function hideErr(el: HTMLElement) { el.hidden = true; el.textContent = ''; }

  // ===== Edit toggling =====
  editBtn.addEventListener('click', () => {
    hideErr(editErr); editOk.hidden = true;
    profileView.hidden = true;
    profileEdit.hidden = false;
    editBtn.hidden = true;
  });
  cancelEdit.addEventListener('click', () => {
    hideErr(editErr); editOk.hidden = true;
    profileEdit.hidden = true;
    profileView.hidden = false;
    editBtn.hidden = false;
  });
  profileEdit.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideErr(editErr); editOk.hidden = true;
    saveEdit.disabled = true;
    saveEdit.textContent = 'Enregistrement…';
    try {
      const res = await updateProfile({
        name: editName.value.trim(),
        address: editAddress.value.trim(),
      });
      if (!res.ok) {
        if (res.error === 'Session invalide') return bounceToLogin();
        showErr(editErr, res.error || 'Enregistrement impossible.');
        return;
      }
      renderProfile(res.customer);
      editOk.hidden = false;
      setTimeout(() => {
        editOk.hidden = true;
        profileEdit.hidden = true;
        profileView.hidden = false;
        editBtn.hidden = false;
      }, 900);
    } finally {
      saveEdit.disabled = false;
      saveEdit.textContent = 'Enregistrer';
    }
  });

  // ===== Logout =====
  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = 'Déconnexion…';
    await logout();
    window.location.replace('/');
  });

  // ===== Initial load — verify session via /me =====
  (async () => {
    if (!isLoggedIn()) return bounceToLogin();
    const res = await me();
    if (!res.ok || !res.customer) return bounceToLogin();
    renderProfile(res.customer);
    renderTier(res.customer);
    renderLoyalty(res.customer.loyalty);
    renderFavorisCount();
    applyWelcomeFlag();
    loading.hidden = true;
    main.hidden = false;
    // Fire-and-forget: load orders + refresh wishlist count from server.
    // Failures are non-fatal — the dashboard already rendered.
    loadOrders().catch(() => {});
    refreshWishlist().then(renderFavorisCount).catch(() => {});
  })();
</script>
