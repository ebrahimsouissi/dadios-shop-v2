---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Mon compte — Dadios Fragrance"
  description="Votre profil et votre fidélité Dadios."
>

<div class="crumb-wrap">
  <nav class="crumbs" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a> <span>·</span>
    <span>Mon compte</span>
  </nav>
</div>

<!-- Loading state shown while we hit /me — body is rendered only after auth -->
<div id="dashLoading" class="dash-loading">
  <p>Chargement…</p>
</div>

<main id="dashMain" class="dash-main" hidden>

  <section class="dash-hero">
    <div class="dash-hero-inner">
      <div class="eyebrow">Espace client</div>
      <h1 id="greeting">Bonjour</h1>
      <div id="tierBadge" class="tier-badge" hidden></div>
      <p id="welcomeNote" class="dash-welcome" hidden></p>
      <p id="orderedNote" class="dash-welcome ordered" hidden></p>
    </div>
  </section>

  <section class="dash-grid">
    <!-- ===== Profile card ===== -->
    <article class="dash-card profile-card">
      <header class="card-head">
        <div>
          <div class="eyebrow">Profil</div>
          <h2>Vos coordonnées</h2>
        </div>
        <button type="button" id="editBtn" class="btn btn-outline btn-sm">Modifier</button>
      </header>

      <dl id="profileView" class="profile-view">
        <div>
          <dt>Nom</dt>
          <dd id="viewName"></dd>
        </div>
        <div>
          <dt>Téléphone</dt>
          <dd id="viewPhone"></dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd id="viewAddress"></dd>
        </div>
      </dl>

      <form id="profileEdit" class="profile-edit" hidden>
        <label>
          <span>Nom</span>
          <input type="text" id="editName" autocomplete="name" />
        </label>
        <label>
          <span>Téléphone</span>
          <input type="tel" id="editPhone" readonly />
          <small>Le téléphone ne peut pas être modifié. Contactez-nous pour un changement.</small>
        </label>
        <label>
          <span>Adresse</span>
          <textarea id="editAddress" rows="3" autocomplete="street-address"></textarea>
        </label>
        <p id="editErr" class="form-err" hidden></p>
        <p id="editOk" class="form-ok" hidden>Profil enregistré ✓</p>
        <div class="edit-actions">
          <button type="button" id="cancelEdit" class="btn btn-outline btn-sm">Annuler</button>
          <button type="submit" id="saveEdit" class="btn btn-primary btn-sm">Enregistrer</button>
        </div>
      </form>
    </article>

    <!-- ===== Loyalty card ===== -->
    <article class="dash-card loyalty-card">
      <header class="card-head">
        <div>
          <div class="eyebrow">Fidélité</div>
          <h2>Carte Dadios</h2>
        </div>
      </header>

      <div id="loyaltyHas" class="loyalty-state" hidden>
        <p class="loyalty-code">
          Code de la carte : <strong id="loyaltyCode"></strong>
        </p>
        <div class="stamps-row" id="stampsRow" aria-label="Progression des tampons"></div>
        <p class="loyalty-progress" id="stampsLabel"></p>
        <p class="loyalty-rewards" id="rewardsLabel"></p>
        <p id="loyaltyVipNote" class="loyalty-vip-note" hidden>
          ✨ Vous gagnez 2× plus de tampons en tant que VIP
        </p>
        <p class="loyalty-fine">
          Présentez votre code en boutique pour gagner un tampon à chaque
          achat. À 8 tampons, votre cadeau est offert.
        </p>
      </div>

      <div id="loyaltyNone" class="loyalty-state" hidden>
        <p>
          Vous n'avez pas encore de carte fidélité.
        </p>
        <p class="muted">
          Demandez-en une lors de votre prochaine visite en boutique — votre
          numéro de téléphone sera lié automatiquement.
        </p>
      </div>
    </article>
  </section>

  <!-- ===== Reseller info (visible only when tier === 'reseller') ===== -->
  <section id="resellerSection" class="reseller-section" hidden>
    <article class="dash-card reseller-card">
      <header class="card-head">
        <div>
          <div class="eyebrow">Compte professionnel</div>
          <h2>Informations Reseller</h2>
        </div>
      </header>
      <form id="resellerForm" class="reseller-form">
        <label>
          <span>Nom de la société</span>
          <input type="text" id="resCompany" autocomplete="organization" />
        </label>
        <label>
          <span>Matricule Fiscale</span>
          <input type="text" id="resMatricule" autocomplete="off" />
        </label>
        <label>
          <span>Adresse de livraison</span>
          <textarea id="resDelivery" rows="2" autocomplete="street-address"></textarea>
        </label>
        <p id="resErr" class="form-err" hidden></p>
        <p id="resOk" class="form-ok" hidden>Informations enregistrées ✓</p>
        <div class="edit-actions">
          <button type="submit" id="resSave" class="btn btn-primary btn-sm">Enregistrer</button>
        </div>
      </form>
    </article>
  </section>

  <!-- ===== Quick tiles row (favoris + VIP concierge) ===== -->
  <section class="dash-quick">
    <a class="quick-tile" href="/compte/favoris">
      <div class="quick-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <div class="quick-text">
        <div class="quick-label">Mes favoris</div>
        <div class="quick-count" id="favorisCount">0</div>
      </div>
      <div class="quick-arrow" aria-hidden="true">→</div>
    </a>

    <a id="conciergeTile" class="quick-tile vip-tile" href="/compte/concierge" hidden>
      <div class="quick-icon vip-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7l3 10h12l3-10-5 3-4-6-4 6-5-3z"/>
        </svg>
      </div>
      <div class="quick-text">
        <div class="quick-label">Concierge VIP</div>
        <div class="quick-sub">Demander un parfum</div>
      </div>
      <div class="quick-arrow" aria-hidden="true">→</div>
    </a>
  </section>

  <!-- ===== Orders section ===== -->
  <section class="orders-section">
    <header class="orders-head">
      <div>
        <div class="eyebrow">Historique</div>
        <h2>Mes commandes</h2>
      </div>
    </header>

    <div id="ordersLoading" class="orders-loading">Chargement de vos commandes...</div>

    <div id="ordersEmpty" class="orders-empty" hidden>
      <p>Aucune commande pour le moment.</p>
      <a href="/parfums" class="btn btn-primary btn-sm">Découvrir nos parfums</a>
    </div>

    <div id="ordersList" class="orders-list" hidden></div>
  </section>

  <!-- ===== Future placeholders ===== -->
  <section class="dash-soon">
    <div class="eyebrow">Bientôt</div>
    <p>Programme VIP · Recommandations personnalisées</p>
  </section>

  <div class="dash-footer">
    <button type="button" id="logoutBtn" class="btn btn-outline btn-sm">Se déconnecter</button>
  </div>

</main>

</Base>

<style>
  .crumb-wrap { max-width: 1280px; margin: 0 auto; padding: 16px 32px 0; }
  .crumbs { font-size: 12px; color: var(--ink-mute); letter-spacing: 0.06em; }
  .crumbs a:hover { color: var(--emerald); }
  .crumbs span { margin: 0 6px; opacity: 0.5; }

  .dash-loading {
    padding: 96px 32px;
    text-align: center;
    color: var(--ink-mute);
    font-style: italic;
  }

  .dash-hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 32px 12px;
  }
  .dash-hero h1 {
    font-size: clamp(32px, 4vw, 44px);
    margin-top: 8px;
  }
  .dash-welcome {
    margin-top: 14px;
    padding: 10px 14px;
    background: rgba(14, 58, 31, 0.06);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    color: var(--emerald);
    display: inline-block;
  }

  .dash-grid {
    max-width: 1280px;
    margin: 24px auto 0;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .dash-card {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px 28px 26px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .card-head h2 {
    font-size: 22px;
    margin-top: 8px;
  }

  /* ===== profile ===== */
  .profile-view {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .profile-view > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .profile-view > div:last-child { border-bottom: none; padding-bottom: 0; }
  .profile-view dt {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-soft);
    font-weight: 500;
  }
  .profile-view dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--ink);
    line-height: 1.4;
  }
  .profile-view dd.muted { color: var(--ink-mute); font-style: italic; font-size: 15px; }

  .profile-edit { display: flex; flex-direction: column; gap: 14px; }
  .profile-edit label { display: block; }
  .profile-edit label > span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .profile-edit input,
  .profile-edit textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    box-sizing: border-box;
  }
  .profile-edit input:focus,
  .profile-edit textarea:focus { outline: none; border-color: var(--emerald); }
  .profile-edit input[readonly] {
    background: var(--cream-warm);
    color: var(--ink-mute);
    cursor: not-allowed;
  }
  .profile-edit small {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    color: var(--ink-mute);
  }
  .edit-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 4px;
  }

  .form-err {
    background: rgba(178, 58, 31, 0.08);
    border: 1px solid #B23A1F;
    color: #8a2a14;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin: 0;
  }
  .form-ok {
    background: rgba(14, 58, 31, 0.06);
    border: 1px solid var(--emerald);
    color: var(--emerald);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin: 0;
  }

  /* ===== loyalty ===== */
  .loyalty-code {
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .loyalty-code strong {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--emerald);
    letter-spacing: 0.16em;
    margin-left: 6px;
  }
  .stamps-row {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 8px;
    margin-bottom: 14px;
  }
  .stamp {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cream);
    border: 1.5px solid var(--border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    font-size: 16px;
    transition: all .2s;
  }
  .stamp.filled {
    background: var(--emerald);
    border-color: var(--emerald);
    color: var(--gold);
  }
  .loyalty-progress {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .loyalty-rewards {
    font-size: 13px;
    color: var(--gold-soft);
    letter-spacing: 0.06em;
    margin-bottom: 16px;
  }
  .loyalty-fine {
    font-size: 12px;
    color: var(--ink-mute);
    line-height: 1.6;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .loyalty-state p { margin-bottom: 12px; line-height: 1.6; }
  .loyalty-state p.muted { color: var(--ink-mute); font-size: 14px; }

  /* ===== quick tile (favoris) ===== */
  .dash-quick {
    max-width: 1280px;
    margin: 24px auto 0;
    padding: 0 32px;
  }
  .quick-tile {
    display: flex;
    align-items: center;
    gap: 18px;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 22px;
    color: inherit;
    transition: all .2s;
    max-width: 360px;
  }
  .quick-tile:hover {
    border-color: var(--emerald);
    transform: translateY(-2px);
  }
  .quick-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--cream-warm);
    border: 1px solid var(--border);
    color: var(--emerald);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .quick-icon svg { width: 22px; height: 22px; }
  .quick-text { flex: 1; min-width: 0; }
  .quick-label {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 2px;
  }
  .quick-count {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--emerald);
    line-height: 1.1;
  }
  .quick-arrow {
    color: var(--gold-soft);
    font-size: 18px;
    flex-shrink: 0;
  }

  /* ===== orders ===== */
  .orders-section {
    max-width: 1280px;
    margin: 32px auto 0;
    padding: 0 32px;
  }
  .orders-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 18px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .orders-head h2 { font-size: 24px; margin-top: 6px; }
  .orders-loading {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px;
    text-align: center;
    color: var(--ink-mute);
    font-style: italic;
  }
  .orders-empty {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 36px 28px;
    text-align: center;
  }
  .orders-empty p {
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .orders-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .order-card {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 22px;
  }
  .order-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .order-ref {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--ink);
  }
  .order-date {
    font-size: 12px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    margin-left: 8px;
  }
  .order-status {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .order-status.pending {
    background: var(--cream-warm);
    color: #A87C45;
    border: 1px solid #c79e62;
  }
  .order-status.confirmed {
    background: var(--gold-light);
    color: var(--emerald);
    border: 1px solid var(--gold);
  }
  .order-status.delivered {
    background: var(--emerald);
    color: var(--cream);
    border: 1px solid var(--emerald);
  }
  .order-status.cancelled {
    background: rgba(120, 104, 80, 0.15);
    color: var(--ink-mute);
    border: 1px solid rgba(120, 104, 80, 0.35);
    text-decoration: line-through;
  }
  .order-items {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .order-items li {
    font-size: 14px;
    color: var(--ink-soft);
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .order-items .li-name { color: var(--ink); }
  .order-total {
    padding-top: 12px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
  }
  .order-total .lbl {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-weight: 500;
  }
  .order-total .val {
    font-size: 22px;
    color: var(--emerald);
  }

  .dash-welcome.ordered {
    background: rgba(212, 175, 55, 0.12);
    border-color: var(--gold);
    color: var(--emerald);
  }

  /* ===== tier badge ===== */
  .tier-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 14px;
    font-weight: 500;
  }
  .tier-badge.vip {
    background: var(--gold);
    color: var(--emerald-deep);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.3);
  }
  .tier-badge.reseller {
    background: var(--emerald);
    color: var(--gold);
    box-shadow: 0 4px 14px rgba(14, 58, 31, 0.2);
  }
  .tier-badge .tier-sub {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: none;
    opacity: 0.85;
    border-left: 1px solid currentColor;
    padding-left: 10px;
    font-weight: 400;
  }

  /* ===== reseller info card ===== */
  .reseller-section {
    max-width: 1280px;
    margin: 24px auto 0;
    padding: 0 32px;
  }
  .reseller-form { display: flex; flex-direction: column; gap: 14px; }
  .reseller-form label > span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .reseller-form input,
  .reseller-form textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    box-sizing: border-box;
  }
  .reseller-form input:focus,
  .reseller-form textarea:focus { outline: none; border-color: var(--emerald); }

  /* ===== VIP concierge tile ===== */
  .quick-tile.vip-tile {
    background: linear-gradient(135deg, var(--cream-soft), rgba(212, 175, 55, 0.08));
    border-color: var(--gold-soft);
  }
  .quick-tile.vip-tile:hover { border-color: var(--gold); }
  .quick-icon.vip-icon {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--emerald-deep);
  }
  .quick-sub {
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 2px;
  }

  /* ===== VIP loyalty note ===== */
  .loyalty-vip-note {
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid var(--gold);
    color: var(--emerald);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin-bottom: 14px;
  }

  /* ===== footer / soon ===== */
  .dash-soon {
    max-width: 1280px;
    margin: 32px auto 0;
    padding: 24px 32px;
    text-align: center;
    color: var(--ink-mute);
    font-size: 14px;
    font-style: italic;
    border-top: 1px solid var(--border);
  }
  .dash-soon .eyebrow {
    font-style: normal;
    margin-bottom: 8px;
    display: block;
  }

  .dash-footer {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 32px 96px;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 880px) {
    .dash-grid { grid-template-columns: 1fr; }
    .dash-grid, .dash-hero, .dash-soon, .dash-footer,
    .dash-quick, .orders-section { padding-left: 16px; padding-right: 16px; }
    .crumb-wrap { padding: 12px 16px 0; }
    .order-head { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
  @media (max-width: 480px) {
    .dash-card { padding: 24px 20px 20px; }
    .stamps-row { gap: 6px; }
    .quick-tile { max-width: 100%; padding: 16px 18px; }
    .order-card { padding: 16px 18px; }
    .order-items li { font-size: 13px; }
  }
</style>

<script>
  import { me, updateProfile, logout, isLoggedIn } from '../../scripts/customerApi.js';
  import { listMyOrders } from '../../scripts/ordersApi.js';
  import { getWishlist, refreshFromServer as refreshWishlist, onWishlistChange } from '../../scripts/wishlist.js';

  const loading = document.getElementById('dashLoading') as HTMLElement;
  const main = document.getElementById('dashMain') as HTMLElement;
  const greeting = document.getElementById('greeting') as HTMLElement;
  const welcomeNote = document.getElementById('welcomeNote') as HTMLElement;
  const viewName = document.getElementById('viewName') as HTMLElement;
  const viewPhone = document.getElementById('viewPhone') as HTMLElement;
  const viewAddress = document.getElementById('viewAddress') as HTMLElement;
  const profileView = document.getElementById('profileView') as HTMLElement;
  const profileEdit = document.getElementById('profileEdit') as HTMLFormElement;
  const editBtn = document.getElementById('editBtn') as HTMLButtonElement;
  const cancelEdit = document.getElementById('cancelEdit') as HTMLButtonElement;
  const saveEdit = document.getElementById('saveEdit') as HTMLButtonElement;
  const editName = document.getElementById('editName') as HTMLInputElement;
  const editPhone = document.getElementById('editPhone') as HTMLInputElement;
  const editAddress = document.getElementById('editAddress') as HTMLTextAreaElement;
  const editErr = document.getElementById('editErr') as HTMLElement;
  const editOk = document.getElementById('editOk') as HTMLElement;
  const loyaltyHas = document.getElementById('loyaltyHas') as HTMLElement;
  const loyaltyNone = document.getElementById('loyaltyNone') as HTMLElement;
  const loyaltyCodeEl = document.getElementById('loyaltyCode') as HTMLElement;
  const stampsRow = document.getElementById('stampsRow') as HTMLElement;
  const stampsLabel = document.getElementById('stampsLabel') as HTMLElement;
  const rewardsLabel = document.getElementById('rewardsLabel') as HTMLElement;
  const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;

  function bounceToLogin() {
    window.location.replace('/compte');
  }

  function renderProfile(c: any) {
    greeting.textContent = c.name ? `Bonjour, ${c.name}` : 'Bonjour, cher client';
    viewName.textContent = c.name || '—';
    viewName.classList.toggle('muted', !c.name);
    viewPhone.textContent = c.phone || '—';
    viewAddress.textContent = c.address || '—';
    viewAddress.classList.toggle('muted', !c.address);

    editName.value = c.name || '';
    editPhone.value = c.phone || '';
    editAddress.value = c.address || '';
  }

  // ===== Tier UI =====
  const tierBadge = document.getElementById('tierBadge') as HTMLElement;
  const conciergeTile = document.getElementById('conciergeTile') as HTMLElement;
  const resellerSection = document.getElementById('resellerSection') as HTMLElement;
  const resCompany = document.getElementById('resCompany') as HTMLInputElement;
  const resMatricule = document.getElementById('resMatricule') as HTMLInputElement;
  const resDelivery = document.getElementById('resDelivery') as HTMLTextAreaElement;
  const resForm = document.getElementById('resellerForm') as HTMLFormElement;
  const resSave = document.getElementById('resSave') as HTMLButtonElement;
  const resErr = document.getElementById('resErr') as HTMLElement;
  const resOk = document.getElementById('resOk') as HTMLElement;
  const loyaltyVipNote = document.getElementById('loyaltyVipNote') as HTMLElement;

  function renderTier(c: any) {
    const tier = c.tier || 'regular';
    if (tier === 'vip') {
      tierBadge.className = 'tier-badge vip';
      tierBadge.innerHTML = '<span>👑 VIP</span><span class="tier-sub">Accès privilégié activé</span>';
      tierBadge.hidden = false;
      if (conciergeTile) conciergeTile.hidden = false;
      if (loyaltyVipNote) loyaltyVipNote.hidden = false;
    } else if (tier === 'reseller') {
      tierBadge.className = 'tier-badge reseller';
      tierBadge.innerHTML = '<span>💼 Reseller</span><span class="tier-sub">Compte professionnel</span>';
      tierBadge.hidden = false;
      if (resellerSection) resellerSection.hidden = false;
      resCompany.value = c.companyName || '';
      resMatricule.value = c.matriculeFiscale || '';
      resDelivery.value = c.deliveryAddress || '';
    } else {
      tierBadge.hidden = true;
      tierBadge.innerHTML = '';
    }
  }

  resForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    resErr.hidden = true; resOk.hidden = true;
    resSave.disabled = true;
    resSave.textContent = 'Enregistrement…';
    try {
      const res = await updateProfile({
        // Server preserves existing name/address if we don't pass them,
        // but we DO pass them so the worker's payload stays consistent
        // with the form (it sets these fields explicitly to the values
        // we send). Read current values from the profile-view dts.
        // @ts-ignore — these are sent through updateProfile signature
        // even if it doesn't declare them in TypeScript.
        name: (document.getElementById('viewName')?.textContent || '').replace(/^—$/, ''),
        address: (document.getElementById('viewAddress')?.textContent || '').replace(/^—$/, ''),
        companyName: resCompany.value.trim(),
        matriculeFiscale: resMatricule.value.trim(),
        deliveryAddress: resDelivery.value.trim(),
      } as any);
      if (!res.ok) {
        if (res.error === 'Session invalide') return bounceToLogin();
        resErr.textContent = res.error || 'Enregistrement impossible.';
        resErr.hidden = false;
        return;
      }
      resOk.hidden = false;
      setTimeout(() => { resOk.hidden = true; }, 1800);
    } finally {
      resSave.disabled = false;
      resSave.textContent = 'Enregistrer';
    }
  });

  function renderLoyalty(loyalty: any) {
    if (!loyalty || !loyalty.code) {
      loyaltyHas.hidden = true;
      loyaltyNone.hidden = false;
      return;
    }
    loyaltyNone.hidden = true;
    loyaltyHas.hidden = false;
    loyaltyCodeEl.textContent = loyalty.code;
    const stamps = Math.max(0, Math.min(8, Number(loyalty.stamps) || 0));
    stampsRow.innerHTML = '';
    for (let i = 0; i < 8; i++) {
      const dot = document.createElement('span');
      dot.className = 'stamp' + (i < stamps ? ' filled' : '');
      dot.textContent = '✦';
      stampsRow.appendChild(dot);
    }
    stampsLabel.textContent = `${stamps} / 8 tampons sur cette carte`;
    const rewards = Number(loyalty.rewards) || 0;
    rewardsLabel.textContent = rewards === 0
      ? 'Aucun cadeau pour le moment'
      : rewards === 1
        ? '1 cadeau gagné'
        : `${rewards} cadeaux gagnés`;
  }

  function applyWelcomeFlag() {
    const qp = new URLSearchParams(window.location.search);
    const w = qp.get('welcome');
    if (w === 'loyalty') {
      welcomeNote.textContent = '✓ Bienvenue ! Nous avons reconnu votre carte fidélité existante.';
      welcomeNote.hidden = false;
    } else if (w === '1') {
      welcomeNote.textContent = '✓ Bienvenue ! Votre compte est actif.';
      welcomeNote.hidden = false;
    }
    const ordered = qp.get('ordered');
    if (ordered === '1') {
      const orderedNote = document.getElementById('orderedNote');
      if (orderedNote) {
        orderedNote.textContent = '✓ Commande enregistrée. Confirmation par WhatsApp.';
        orderedNote.hidden = false;
      }
    }
    if (w || ordered) {
      const url = new URL(window.location.href);
      url.searchParams.delete('welcome');
      url.searchParams.delete('ordered');
      window.history.replaceState({}, '', url.toString());
    }
  }

  // ===== Orders =====
  const ordersLoading = document.getElementById('ordersLoading') as HTMLElement;
  const ordersEmpty = document.getElementById('ordersEmpty') as HTMLElement;
  const ordersList = document.getElementById('ordersList') as HTMLElement;

  const STATUS_LABEL: Record<string, string> = {
    pending: 'En attente',
    confirmed: 'Confirmée',
    delivered: 'Livrée',
    cancelled: 'Annulée',
  };

  function escHtml(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]);
  }
  function shortId(uuid: string) {
    return String(uuid || '').replace(/-/g, '').substring(0, 8);
  }
  function fmtDate(iso: string) {
    if (!iso) return '';
    try {
      return new Date(iso).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
    } catch { return iso; }
  }

  function renderOrder(o: any) {
    const itemsHtml = (o.items || [])
      .map((i: any) => {
        const sub = (Number(i.price) || 0) * (Number(i.qty) || 1);
        const sizeStr = i.size ? ` (${escHtml(i.size)})` : '';
        return `<li><span class="li-name">${Number(i.qty) || 1}× ${escHtml(i.name)}${sizeStr}</span><span class="li-val">${sub} DT</span></li>`;
      })
      .join('');
    const status = String(o.status || 'pending');
    return `<article class="order-card">
      <header class="order-head">
        <div>
          <span class="order-ref">Commande #${escHtml(shortId(o.id))}</span>
          <span class="order-date">${escHtml(fmtDate(o.createdAt))}</span>
        </div>
        <span class="order-status ${escHtml(status)}">${escHtml(STATUS_LABEL[status] || status)}</span>
      </header>
      <ul class="order-items">${itemsHtml}</ul>
      <div class="order-total"><span class="lbl">Total</span><span class="val">${Number(o.total) || 0} DT</span></div>
    </article>`;
  }

  async function loadOrders() {
    ordersLoading.hidden = false;
    ordersEmpty.hidden = true;
    ordersList.hidden = true;
    const res = await listMyOrders();
    ordersLoading.hidden = true;
    if (!res.ok) {
      // Auth failure handled at mount; here we just degrade quietly.
      ordersEmpty.hidden = false;
      return;
    }
    const orders = (res.orders || []) as any[];
    if (!orders.length) {
      ordersEmpty.hidden = false;
      return;
    }
    ordersList.innerHTML = orders.map(renderOrder).join('');
    ordersList.hidden = false;
  }

  // ===== Favoris count tile =====
  const favorisCountEl = document.getElementById('favorisCount') as HTMLElement;
  function renderFavorisCount() {
    favorisCountEl.textContent = String(getWishlist().length);
  }
  onWishlistChange(renderFavorisCount);

  function showErr(el: HTMLElement, msg: string) { el.textContent = msg; el.hidden = false; }
  function hideErr(el: HTMLElement) { el.hidden = true; el.textContent = ''; }

  // ===== Edit toggling =====
  editBtn.addEventListener('click', () => {
    hideErr(editErr); editOk.hidden = true;
    profileView.hidden = true;
    profileEdit.hidden = false;
    editBtn.hidden = true;
  });
  cancelEdit.addEventListener('click', () => {
    hideErr(editErr); editOk.hidden = true;
    profileEdit.hidden = true;
    profileView.hidden = false;
    editBtn.hidden = false;
  });
  profileEdit.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideErr(editErr); editOk.hidden = true;
    saveEdit.disabled = true;
    saveEdit.textContent = 'Enregistrement…';
    try {
      const res = await updateProfile({
        name: editName.value.trim(),
        address: editAddress.value.trim(),
      });
      if (!res.ok) {
        if (res.error === 'Session invalide') return bounceToLogin();
        showErr(editErr, res.error || 'Enregistrement impossible.');
        return;
      }
      renderProfile(res.customer);
      editOk.hidden = false;
      setTimeout(() => {
        editOk.hidden = true;
        profileEdit.hidden = true;
        profileView.hidden = false;
        editBtn.hidden = false;
      }, 900);
    } finally {
      saveEdit.disabled = false;
      saveEdit.textContent = 'Enregistrer';
    }
  });

  // ===== Logout =====
  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = 'Déconnexion…';
    await logout();
    window.location.replace('/');
  });

  // ===== Initial load — verify session via /me =====
  (async () => {
    if (!isLoggedIn()) return bounceToLogin();
    const res = await me();
    if (!res.ok || !res.customer) return bounceToLogin();
    renderProfile(res.customer);
    renderTier(res.customer);
    renderLoyalty(res.customer.loyalty);
    renderFavorisCount();
    applyWelcomeFlag();
    loading.hidden = true;
    main.hidden = false;
    // Fire-and-forget: load orders + refresh wishlist count from server.
    // Failures are non-fatal — the dashboard already rendered.
    loadOrders().catch(() => {});
    refreshWishlist().then(renderFavorisCount).catch(() => {});
  })();
</script>
