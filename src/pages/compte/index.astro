---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Mon compte — Dadios Fragrance"
  description="Connectez-vous à votre compte Dadios ou créez-en un pour suivre votre fidélité."
>

<section class="acc-page">
  <div class="acc-wrap">
    <a href="/" class="acc-logo" aria-label="Retour à l'accueil Dadios">Dadios</a>
    <div class="acc-tagline">— Tunis · Fragrances —</div>

    <h1 class="acc-title">Mon compte</h1>
    <p class="acc-sub">Connectez-vous ou créez votre compte.</p>

    <div class="acc-toggle-wrap">
      <div class="acc-toggle" role="tablist" aria-label="Connexion ou inscription">
        <button type="button" id="tabLogin" class="acc-toggle-btn is-active" role="tab" aria-selected="true">Connexion</button>
        <button type="button" id="tabSignup" class="acc-toggle-btn" role="tab" aria-selected="false">Inscription</button>
      </div>
    </div>

    <!-- ===== LOGIN ===== -->
    <form id="loginForm" class="acc-form" novalidate>
      <input type="tel" id="loginPhone" name="phone" placeholder="Téléphone" autocomplete="tel" inputmode="tel" required />
      <input type="password" id="loginPwd" name="password" placeholder="Mot de passe" autocomplete="current-password" minlength="6" required />

      <div class="acc-forgot-row">
        <button type="button" id="forgotBtn" class="acc-forgot">Mot de passe oublié</button>
      </div>

      <p id="loginErr" class="acc-err" role="alert" aria-live="polite" hidden></p>
      <button type="submit" id="loginBtn" class="acc-cta">Entrer</button>
    </form>

    <!-- ===== SIGNUP ===== -->
    <form id="signupForm" class="acc-form" novalidate hidden>
      <input type="tel" id="signupPhone" name="phone" placeholder="Téléphone" autocomplete="tel" inputmode="tel" required />
      <input type="text" id="signupName" name="name" placeholder="Nom complet" autocomplete="name" />
      <input type="text" id="signupAddress" name="address" placeholder="Adresse (optionnel)" autocomplete="street-address" />
      <input type="password" id="signupPwd" name="password" placeholder="Mot de passe — 6 caractères min" autocomplete="new-password" minlength="6" required />

      <label class="acc-loyalty">
        <input type="checkbox" id="signupLoyalty" checked />
        <span>Créer ma carte fidélité Dadios</span>
      </label>

      <p id="signupErr" class="acc-err" role="alert" aria-live="polite" hidden></p>
      <button type="submit" id="signupBtn" class="acc-cta">Créer mon compte</button>
    </form>

    <div class="acc-footer">Service client · +216 56 731 891</div>
  </div>
</section>

<!-- ===== FORGOT PASSWORD MODAL (préservé) ===== -->
<div id="forgotModal" class="acc-modal" hidden>
  <div class="acc-modal-overlay" id="forgotOverlay"></div>
  <div class="acc-modal-box">
    <button type="button" class="acc-modal-close" id="forgotClose" aria-label="Fermer">×</button>
    <div class="acc-modal-eyebrow">— Réinitialisation —</div>
    <h2 class="acc-modal-title">Mot de passe oublié</h2>
    <p class="acc-modal-text">
      Pour des raisons de sécurité, la réinitialisation du mot de passe se fait
      avec notre équipe.
    </p>
    <p class="acc-modal-text muted">
      Contactez-nous par WhatsApp au <strong>+216 56 731 891</strong>. Indiquez
      votre numéro de téléphone — nous vous enverrons un nouveau mot de passe
      temporaire que vous pourrez ensuite modifier.
    </p>
    <a
      class="acc-cta acc-modal-cta"
      href="https://wa.me/21656731891?text=Bonjour%20Dadios%2C%20je%20souhaite%20r%C3%A9initialiser%20le%20mot%20de%20passe%20de%20mon%20compte%20client."
      target="_blank"
      rel="noopener"
    >Ouvrir WhatsApp →</a>
  </div>
</div>

</Base>

<style>
  /* ===== Page background — override layout ===== */
  .acc-page {
    background: #FAF6EC;
    min-height: 100vh;
    padding: 4rem 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .acc-wrap {
    width: 100%;
    max-width: 340px;
    text-align: center;
  }

  /* ===== Logo + tagline ===== */
  .acc-logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: #0F6E56;
    text-decoration: none;
    line-height: 1;
  }
  .acc-tagline {
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #BA7517;
    margin-top: 6px;
    margin-bottom: 3rem;
  }

  /* ===== Heading ===== */
  .acc-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .acc-sub {
    font-size: 13px;
    color: rgba(0, 0, 0, 0.55);
    margin-bottom: 2.5rem;
    line-height: 1.5;
  }

  /* ===== Toggle pill ===== */
  .acc-toggle-wrap { text-align: center; margin-bottom: 2rem; }
  .acc-toggle {
    display: inline-flex;
    background: rgba(0, 0, 0, 0.04);
    padding: 3px;
    border-radius: 999px;
    gap: 2px;
  }
  .acc-toggle-btn {
    background: transparent;
    border: none;
    padding: 7px 22px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    border-radius: 999px;
    cursor: pointer;
    transition: background .2s, color .2s;
  }
  .acc-toggle-btn.is-active {
    background: #0F6E56;
    color: #FAF6EC;
  }
  .acc-toggle-btn:not(.is-active):hover { color: #1a1a1a; }

  /* ===== Forms ===== */
  .acc-form {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  /* `display: flex` above wins over the HTML `hidden` attribute by
     default — force it back to none when hidden so the toggle works. */
  .acc-form[hidden] { display: none !important; }
  .acc-form input[type="tel"],
  .acc-form input[type="text"],
  .acc-form input[type="password"] {
    width: 100%;
    padding: 13px 16px;
    background: rgba(255, 255, 255, 0.6);
    border: 0.5px solid rgba(0, 0, 0, 0.15);
    border-radius: 2px;
    font-family: inherit;
    font-size: 14px;
    color: #1a1a1a;
    box-sizing: border-box;
    outline: none;
    margin-bottom: 12px;
    transition: border-color .2s;
  }
  .acc-form input::placeholder {
    color: rgba(0, 0, 0, 0.35);
    font-style: italic;
  }
  .acc-form input:hover,
  .acc-form input:focus { border-color: #0F6E56; }

  /* Forgot row (login only) */
  .acc-forgot-row {
    display: flex;
    justify-content: flex-end;
    margin-top: -4px;
    margin-bottom: 1.5rem;
  }
  .acc-forgot {
    background: none;
    border: none;
    padding: 0 0 1px 0;
    font-family: inherit;
    font-size: 11px;
    color: rgba(0, 0, 0, 0.35);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.35);
    cursor: pointer;
    line-height: 1.3;
  }
  .acc-forgot:hover { color: #0F6E56; border-bottom-color: #0F6E56; }

  /* Loyalty checkbox (signup) */
  .acc-loyalty {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.55);
    cursor: pointer;
    margin-top: 4px;
    margin-bottom: 1.5rem;
  }
  .acc-loyalty input[type="checkbox"] {
    width: 14px;
    height: 14px;
    accent-color: #0F6E56;
    cursor: pointer;
    margin: 0;
  }

  /* Error banner */
  .acc-err {
    background: #FCEBEB;
    border-left: 2px solid #A32D2D;
    color: #791F1F;
    padding: 8px 12px;
    border-radius: 2px;
    font-size: 12px;
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .acc-err[hidden] { display: none; }

  /* CTA button */
  .acc-cta {
    width: 100%;
    background: #0F6E56;
    color: #FAF6EC;
    border: 0;
    padding: 14px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    transition: background .2s;
    display: inline-block;
    text-align: center;
    text-decoration: none;
    line-height: 1;
  }
  .acc-cta:hover { background: #085041; }
  .acc-cta:disabled { opacity: 0.6; cursor: wait; }

  /* Footer line */
  .acc-footer {
    margin-top: 3rem;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
    text-align: center;
  }

  /* ===== Forgot modal (preserved, restyled to match) ===== */
  .acc-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .acc-modal[hidden] { display: none !important; }
  .acc-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 110, 86, 0.55);
    backdrop-filter: blur(4px);
  }
  .acc-modal-box {
    position: relative;
    background: #FAF6EC;
    border: 0.5px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    width: 100%;
    max-width: 380px;
    padding: 36px 28px 28px;
    text-align: center;
  }
  .acc-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.35);
    line-height: 1;
    padding: 4px;
  }
  .acc-modal-close:hover { color: #1a1a1a; }
  .acc-modal-eyebrow {
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #BA7517;
    margin-bottom: 10px;
  }
  .acc-modal-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 16px;
  }
  .acc-modal-text {
    font-size: 13px;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .acc-modal-text.muted { color: rgba(0, 0, 0, 0.45); font-size: 12px; }
  .acc-modal-text strong { color: #0F6E56; font-weight: 500; }
  .acc-modal-cta { margin-top: 12px; }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .acc-page { padding: 3rem 1rem; }
    .acc-logo { font-size: 28px; }
  }
</style>

<script>
  import { signup, login, me, isLoggedIn } from '../../scripts/customerApi.js';

  const tabLogin = document.getElementById('tabLogin') as HTMLButtonElement;
  const tabSignup = document.getElementById('tabSignup') as HTMLButtonElement;
  const loginForm = document.getElementById('loginForm') as HTMLFormElement;
  const signupForm = document.getElementById('signupForm') as HTMLFormElement;
  const loginErr = document.getElementById('loginErr') as HTMLElement;
  const signupErr = document.getElementById('signupErr') as HTMLElement;
  const loginBtn = document.getElementById('loginBtn') as HTMLButtonElement;
  const signupBtn = document.getElementById('signupBtn') as HTMLButtonElement;
  const forgotBtn = document.getElementById('forgotBtn') as HTMLButtonElement;
  const forgotModal = document.getElementById('forgotModal') as HTMLElement;
  const forgotClose = document.getElementById('forgotClose') as HTMLButtonElement;
  const forgotOverlay = document.getElementById('forgotOverlay') as HTMLElement;

  // Post-auth destination. Honours ?redirect= (deep-link flow), routes
  // admins to /admin, otherwise the customer dashboard.
  function destinationFor(customer: any): string {
    const params = new URLSearchParams(window.location.search);
    const redirect = params.get('redirect');
    if (redirect && redirect.startsWith('/')) return redirect;
    if (customer && customer.tier === 'admin') return '/admin';
    return '/compte/dashboard';
  }

  // Already logged in? Skip the form.
  (async () => {
    if (!isLoggedIn()) return;
    const res = await me();
    if (res.ok) window.location.replace(destinationFor(res.customer));
    // me() clears stale tokens on failure — nothing else to do.
  })();

  // ===== Toggle =====
  function selectTab(which: 'login' | 'signup') {
    const isLogin = which === 'login';
    tabLogin.classList.toggle('is-active', isLogin);
    tabLogin.setAttribute('aria-selected', isLogin ? 'true' : 'false');
    tabSignup.classList.toggle('is-active', !isLogin);
    tabSignup.setAttribute('aria-selected', isLogin ? 'false' : 'true');
    loginForm.hidden = !isLogin;
    signupForm.hidden = isLogin;
    hideErr(loginErr);
    hideErr(signupErr);
  }
  tabLogin.addEventListener('click', () => selectTab('login'));
  tabSignup.addEventListener('click', () => selectTab('signup'));

  // ===== Error helpers (auto-hide after 5s) =====
  const errTimers = new WeakMap<HTMLElement, number>();
  function showErr(el: HTMLElement, msg: string) {
    el.textContent = msg;
    el.hidden = false;
    const prev = errTimers.get(el);
    if (prev) window.clearTimeout(prev);
    const t = window.setTimeout(() => hideErr(el), 5000);
    errTimers.set(el, t);
  }
  function hideErr(el: HTMLElement) {
    el.hidden = true;
    el.textContent = '';
    const prev = errTimers.get(el);
    if (prev) { window.clearTimeout(prev); errTimers.delete(el); }
  }

  // ===== Login =====
  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideErr(loginErr);
    const phone = (document.getElementById('loginPhone') as HTMLInputElement).value.trim();
    const password = (document.getElementById('loginPwd') as HTMLInputElement).value;
    if (!phone || !password) {
      showErr(loginErr, 'Téléphone et mot de passe requis.');
      return;
    }
    loginBtn.disabled = true;
    const origLabel = loginBtn.textContent;
    loginBtn.textContent = 'Connexion en cours…';
    try {
      const res = await login({ phone, password });
      if (res.ok) {
        window.location.assign(destinationFor(res.customer));
      } else {
        showErr(loginErr, res.error || 'Identifiants incorrects.');
      }
    } finally {
      loginBtn.disabled = false;
      loginBtn.textContent = origLabel;
    }
  });

  // ===== Signup =====
  signupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideErr(signupErr);
    const phone = (document.getElementById('signupPhone') as HTMLInputElement).value.trim();
    const password = (document.getElementById('signupPwd') as HTMLInputElement).value;
    const name = (document.getElementById('signupName') as HTMLInputElement).value.trim();
    const address = (document.getElementById('signupAddress') as HTMLInputElement).value.trim();
    const wantLoyalty = (document.getElementById('signupLoyalty') as HTMLInputElement | null)?.checked ?? true;
    if (!phone) { showErr(signupErr, 'Numéro de téléphone requis.'); return; }
    if (!password || password.length < 6) {
      showErr(signupErr, 'Mot de passe : 6 caractères minimum.');
      return;
    }
    signupBtn.disabled = true;
    const origLabel = signupBtn.textContent;
    signupBtn.textContent = 'Création en cours…';
    try {
      const res = await signup({ phone, password, name, address, createLoyaltyCard: wantLoyalty });
      if (res.ok) {
        const qs = res.loyaltyLinked ? '?welcome=loyalty' : '?welcome=1';
        window.location.assign('/compte/dashboard' + qs);
      } else {
        showErr(signupErr, res.error || 'Création impossible.');
      }
    } finally {
      signupBtn.disabled = false;
      signupBtn.textContent = origLabel;
    }
  });

  // ===== Forgot password modal =====
  function openForgot() { forgotModal.hidden = false; }
  function closeForgot() { forgotModal.hidden = true; }
  forgotBtn.addEventListener('click', openForgot);
  forgotClose.addEventListener('click', closeForgot);
  forgotOverlay.addEventListener('click', closeForgot);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !forgotModal.hidden) closeForgot();
  });
</script>
