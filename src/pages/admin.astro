  }
  .admin-topbar-wordmark {
    font-family: var(--font-script);
    font-size: 26px;
    color: var(--admin-gold);
    line-height: 1;
  }
  .admin-topbar-tag {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--admin-ink-soft);
  }
  @media (min-width: 1024px) {
    /* Brand lives in sidebar — hide topbar brand on desktop */
    .admin-topbar-brand { display: none; }
  }
  .admin-search-btn {
    display: none;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    background: var(--admin-cream);
    color: var(--admin-ink-soft);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 13px;
    min-width: 0;
  }
  .admin-search-btn:hover { border-color: var(--admin-gold); color: var(--admin-ink); }
  .admin-search-label { flex: 1; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .admin-search-kbd {
    font-family: var(--font-body);
    font-size: 11px;
    background: var(--admin-paper);
    border: 1px solid var(--admin-border);
    border-radius: 4px;
