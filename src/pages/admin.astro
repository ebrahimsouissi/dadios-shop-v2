  .tiny-img {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: var(--cream-warm);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tiny-img img { width: 100%; height: 100%; object-fit: cover; }
  .tiny-img svg { width: 70%; height: auto; }
  .link-btn {
    background: transparent;
    border: none;
    color: var(--emerald);
    font-size: 13px;
    cursor: pointer;
    padding: 4px 8px;
    font-family: var(--font-body);
    margin-right: 4px;
  }
  .link-btn:hover { text-decoration: underline; }
  .link-btn.danger { color: #B23A1F; }

  .status-msg {
    margin-top: 16px;
    padding: 12px 16px;
