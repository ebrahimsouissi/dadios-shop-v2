    color: var(--admin-ink-soft);
  }
  @media (min-width: 768px) {
    .admin-search-btn { display: inline-flex; }
  }
  /* Mobile: collapse search to icon only (replaces label/kbd). */
  .admin-search-btn-mobile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
