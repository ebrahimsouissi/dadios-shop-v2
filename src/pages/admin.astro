  .admin-accueil-card p { color: var(--admin-ink-soft); line-height: 1.6; font-size: 14px; }
  .admin-accueil-hint { margin-top: 14px; font-size: 13px; color: var(--admin-ink-mute); }

  /* Per-block tweaks to fit the new shell */
  .admin-shell .admin-block { margin-top: 24px; }
  .admin-shell .admin-block:first-of-type { margin-top: 0; }

  /* ========= SECTION VISIBILITY =========
     Each section (accueil + 5 perms) only shows when data-active-section
     on the shell matches the block's data-section. Permission-denied blocks
     keep their [hidden] from the perm filter and CSS keeps them out. */
  .admin-shell .admin-section,
  .admin-shell .admin-block { display: none; }

  .admin-shell[data-active-section="accueil"] .admin-section[data-section="accueil"] { display: block; }

  .admin-shell[data-active-section="ventes"] .admin-block[data-section="ventes"]:not([hidden]),
  .admin-shell[data-active-section="catalogue"] .admin-block[data-section="catalogue"]:not([hidden]),
  .admin-shell[data-active-section="clients"] .admin-block[data-section="clients"]:not([hidden]),
  .admin-shell[data-active-section="contenu"] .admin-block[data-section="contenu"]:not([hidden]),
  .admin-shell[data-active-section="equipe"] .admin-block[data-section="equipe"]:not([hidden]) {
    display: block;
  }

  /* Per-section action buttons in the section-current header — only the
     one matching the active section is shown. */
  .admin-shell .admin-section-actions [data-for-section] { display: none; }
  .admin-shell[data-active-section="catalogue"] .admin-section-actions [data-for-section="catalogue"]:not([hidden]) {
    display: inline-flex;
  }

  /* Empty-state when the active section has no visible block (e.g. an admin
     with only ['orders'] navigated to Catalogue). */
  .admin-section-empty {
    background: var(--admin-paper);
    border: 1px dashed var(--admin-border);
    border-radius: 12px;
    padding: 40px 24px;
    text-align: center;
    color: var(--admin-ink-mute);
    font-size: 14px;
  }
  .admin-section-empty[hidden] { display: none; }

  /* ============ SEARCH MODAL (Ctrl+K) ============ */
  .search-modal { position: fixed; inset: 0; z-index: 300; }
  .search-modal[hidden] { display: none; }
  .search-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 62, 37, 0.5);
    backdrop-filter: blur(3px);
  }
  .search-modal-box {
    position: relative;
    max-width: 560px;
    margin: 12vh auto 0;
    background: var(--admin-paper);
    border-radius: 16px;
    box-shadow: 0 24px 60px -10px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
  }
  .search-modal-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--admin-border);
    color: var(--admin-ink-soft);
  }
  .search-modal-input-wrap input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: var(--admin-ink);
    font-family: var(--font-body);
    padding: 6px 0;
    min-height: 40px;
  }
  .search-modal-close {
    border: 1px solid var(--admin-border);
    background: var(--admin-cream);
    color: var(--admin-ink-soft);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .search-modal-results {
    flex: 1;
    overflow-y: auto;
    padding: 12px 8px;
  }
  .search-modal-hint {
    padding: 30px 20px;
    text-align: center;
    color: var(--admin-ink-mute);
    font-size: 14px;
    line-height: 1.6;
  }
  .search-modal-hint kbd {
    background: var(--admin-cream);
    border: 1px solid var(--admin-border);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
  }
  .search-modal-group {
    padding: 8px 12px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--admin-ink-mute);
  }
  .search-modal-result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    color: var(--admin-ink);
    text-decoration: none;
    font-size: 14px;
  }
  .search-modal-result:hover, .search-modal-result.is-focused {
    background: var(--admin-cream);
  }
  .search-modal-result-meta {
    margin-left: auto;
    color: var(--admin-ink-mute);
    font-size: 12px;
  }

  /* ============ LOGIN GATE — keep simple, no shell chrome ============ */
  /* Existing .login-gate rules below still apply on the gate elements.
     When adminMain is hidden, .admin-topbar etc. aren't rendered. */

  /* ====== LOGIN GATE ====== */
  .login-gate {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
  }
  .login-box {
    max-width: 420px;
    width: 100%;
    background: var(--cream-soft);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    padding: 40px 36px;
    text-align: center;
  }
  .login-box h2 { font-size: 32px; margin: 8px 0 8px; }
  .login-box p { color: var(--ink-soft); margin-bottom: 24px; font-size: 14px; }
  .login-box input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 14px;
    margin-bottom: 12px;
  }
  .login-box input:focus { outline: none; border-color: var(--emerald); }
  .login-box .btn { width: 100%; }
  .login-err { color: #B23A1F; font-size: 13px; margin-top: 12px; }
  .hidden { display: none !important; }

  /* ====== ADMIN ====== */
  .admin {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px;
  }
  .admin-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .admin h1 { font-size: clamp(28px, 4vw, 40px); margin-top: 8px; }
  .no-perms-empty {
    max-width: 560px;
    margin: 48px auto;
    padding: 40px 32px;
    text-align: center;
    background: var(--cream-soft);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
  }
  .no-perms-icon { font-size: 40px; margin-bottom: 12px; }
  .no-perms-empty h2 { font-size: 22px; margin: 4px 0 12px; }
  .no-perms-empty p { color: var(--ink-soft); line-height: 1.6; font-size: 14px; margin: 0; }
  .admin-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    padding-bottom: 16px;
  }
  .tab-btn {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--cream-soft);
    color: var(--ink);
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .tab-btn.active { background: var(--emerald); color: var(--cream); border-color: var(--emerald); }

  .admin-table {
    width: 100%;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }
  .admin-table th {
    background: var(--cream-warm);
    text-align: left;
    padding: 12px 16px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .admin-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .admin-table tr:last-child td { border-bottom: none; }
  .admin-table tr:hover { background: var(--cream); }
  .muted { color: var(--ink-mute); font-style: italic; font-size: 13px; }
  .cap { text-transform: capitalize; }
  .tag {
    background: var(--cream-warm);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .tiny-img {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: var(--cream-warm);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tiny-img img { width: 100%; height: 100%; object-fit: cover; }
  .tiny-img svg { width: 70%; height: auto; }
  .link-btn {
    background: transparent;
    border: none;
    color: var(--emerald);
    font-size: 13px;
    cursor: pointer;
    padding: 4px 8px;
    font-family: var(--font-body);
    margin-right: 4px;
  }
  .link-btn:hover { text-decoration: underline; }
  .link-btn.danger { color: #B23A1F; }

  .status-msg {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    background: var(--cream-soft);
    border: 1px solid var(--border-strong);
  }
  .status-msg.success { background: rgba(14, 58, 31, 0.08); border-color: var(--emerald); color: var(--emerald); }
  .status-msg.error { background: rgba(178, 58, 31, 0.08); border-color: #B23A1F; color: #B23A1F; }

  /* ====== MODAL ====== */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 26, 14, 0.72);
    backdrop-filter: blur(4px);
  }
  .modal-box {
    position: relative;
    background: var(--cream);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    width: 100%;
    max-width: 760px;
    max-height: 92vh;
    overflow-y: auto;
    padding: 36px 40px 32px;
  }
  .modal-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: var(--ink-mute);
    line-height: 1;
  }
  .modal-box h2 { font-size: 28px; margin: 6px 0 24px; }

  /* form */
  #prodForm label { display: block; margin-bottom: 18px; }
  #prodForm label > span,
  #prodForm .lbl {
    display: block;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  #prodForm input[type="text"],
  #prodForm input[type="password"],
  #prodForm select,
  #prodForm textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream-soft);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
  }
  #prodForm input:focus, #prodForm select:focus, #prodForm textarea:focus {
    outline: none; border-color: var(--emerald);
  }
  #prodForm small {
    display: block;
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 4px;
    line-height: 1.5;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card-block {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    margin: 8px 0 18px;
  }
  .card-block strong {
    display: block;
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--emerald);
    margin-bottom: 4px;
  }
  .check-row { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 6px; }
  .check-item {
    margin-bottom: 0 !important;
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
  }
  .check-item input { width: auto !important; margin: 0 !important; }

  .price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .price-cell {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .price-cell .size-label { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute); }
  .price-cell .size-price { font-family: var(--font-display); font-size: 22px; color: var(--emerald); font-weight: 500; }
  .price-cell .size-price small { font-size: 11px; color: var(--ink-mute); margin-left: 4px; }

  .checkbox {
    display: flex !important;
    align-items: center;
    gap: 10px;
    padding: 14px;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
  }
  .checkbox input { margin: 0; }
  .checkbox span {
    display: inline !important;
    text-transform: none !important;
    letter-spacing: normal !important;
    font-size: 14px !important;
    color: var(--ink) !important;
    margin: 0 !important;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  /* IMAGE UPLOAD */
  .image-uploader { display: grid; grid-template-columns: 140px 1fr; gap: 18px; align-items: start; }
  .image-preview {
    width: 140px;
    height: 140px;
    border-radius: 10px;
    background: var(--cream-warm);
    border: 1.5px dashed var(--border-strong);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-mute);
    font-size: 12px;
    text-align: center;
    padding: 8px;
  }
  .image-preview img { width: 100%; height: 100%; object-fit: cover; }
  .image-controls { display: flex; flex-direction: column; gap: 10px; }
  .image-hint { font-size: 12px; color: var(--ink-mute); margin: 4px 0 0; min-height: 18px; }
  .image-hint.success { color: var(--emerald); }
  .image-hint.error { color: #B23A1F; }

  @media (max-width: 720px) {
    .modal-box { padding: 24px 20px; }
    .form-row, .price-grid { grid-template-columns: 1fr; }
    .image-uploader { grid-template-columns: 1fr; }
    .admin-table { font-size: 13px; }
    .admin-table th, .admin-table td { padding: 10px 8px; }
  }

  /* ====== CUSTOMERS BLOCK ====== */
  .customers-block {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .customers-head { margin-bottom: 20px; }
  .customers-head h2 {
    font-size: clamp(22px, 3vw, 28px);
    margin-top: 6px;
  }
  .customers-help {
    color: var(--ink-soft);
    margin-top: 8px;
    max-width: 540px;
    font-size: 14px;
  }
  .customer-search {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    max-width: 520px;
  }
  .customer-search input {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream-soft);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
  }
  .customer-search input:focus { outline: none; border-color: var(--emerald); }

  .customer-result {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px 24px;
  }
  .customer-result.hidden { display: none; }
  .customer-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 32px;
    margin-bottom: 22px;
  }
  .customer-val {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--ink);
    line-height: 1.4;
  }
  .customer-val.muted { color: var(--ink-mute); font-style: italic; font-size: 14px; }
  .customer-actions {
    display: flex;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .modal-box.small { max-width: 440px; }

  @media (max-width: 720px) {
    .customer-row { grid-template-columns: 1fr; gap: 14px; }
    .customer-search { flex-direction: column; }
  }

  /* ====== ORDERS BLOCK ====== */
  .orders-block {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .orders-block .orders-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .orders-block .orders-head h2 {
    font-size: clamp(22px, 3vw, 28px);
    margin-top: 6px;
  }
  .orders-help {
    color: var(--ink-soft);
    margin-top: 8px;
    font-size: 14px;
    max-width: 560px;
  }
  .orders-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .filter-pill {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--cream-soft);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.06em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all .2s;
  }
  .filter-pill:hover { border-color: var(--gold-soft); }
  .filter-pill.active {
    background: var(--emerald);
    color: var(--cream);
    border-color: var(--emerald);
  }
  .filter-pill .count {
    background: rgba(0, 0, 0, 0.12);
    color: inherit;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }
  .filter-pill.active .count {
    background: rgba(212, 175, 55, 0.3);
    color: var(--gold);
  }

  .orders-tablewrap {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .orders-admin-table {
    width: 100%;
    border-radius: 0;
    border: none;
    border-collapse: separate;
    border-spacing: 0;
  }
  .orders-admin-table th,
  .orders-admin-table td {
    white-space: nowrap;
    vertical-align: middle;
  }
  .orders-admin-table td.notes-col,
  .orders-admin-table th.notes-col { white-space: normal; }
  .orders-admin-table .cust-name { font-weight: 500; }
  .orders-admin-table .cust-phone {
    display: block;
    color: var(--ink-mute);
    font-size: 12px;
  }
  .orders-admin-table .ref-mono {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--gold-soft);
  }
  .orders-admin-table .total-cell {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--emerald);
  }
  .orders-admin-table .status-cell select {
    padding: 6px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream-soft);
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink);
    min-width: 130px;
  }
  .orders-admin-table .status-cell select:disabled {
    background: var(--cream-warm);
    color: var(--ink-mute);
    cursor: not-allowed;
  }
  .orders-empty-row td {
    text-align: center;
    padding: 32px;
    color: var(--ink-mute);
    font-style: italic;
  }

  /* Order details modal */
  .order-modal-box { max-width: 760px; }
  .order-meta-line {
    color: var(--ink-mute);
    font-size: 13px;
    margin-bottom: 18px;
  }
  .order-modal-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 28px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .order-modal-items {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .order-modal-items li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .order-modal-items .li-name { color: var(--ink); }
  .order-modal-items .li-sub { color: var(--emerald); font-family: var(--font-display); }
  .order-modal-total {
    padding-top: 12px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--emerald);
  }
  .order-modal-total .lbl {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .order-customer-line {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .order-customer-line a {
    color: var(--emerald);
    text-decoration: underline;
  }
  .order-customer-line.muted { color: var(--ink-mute); font-style: italic; font-size: 14px; }
  .order-customer-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  #orderNotes {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream-soft);
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink);
    box-sizing: border-box;
    resize: vertical;
  }
  #orderNotes:focus { outline: none; border-color: var(--emerald); }
  .order-notes-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }
  .order-notes-status {
    font-size: 12px;
    color: var(--emerald);
    opacity: 0;
    transition: opacity .2s;
  }
  .order-notes-status.visible { opacity: 1; }
  .order-modal-stamps {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
  }

  @media (max-width: 880px) {
    .order-modal-grid { grid-template-columns: 1fr; gap: 18px; }
  }

  /* ====== ARTICLES BLOCK ====== */
  .articles-block {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .articles-block .articles-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .articles-block .articles-head h2 {
    font-size: clamp(22px, 3vw, 28px);
    margin-top: 6px;
  }
  .articles-help { color: var(--ink-soft); margin-top: 8px; max-width: 540px; font-size: 14px; }
  .articles-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .articles-tablewrap {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .articles-admin-table { width: 100%; border: none; border-radius: 0; border-collapse: separate; border-spacing: 0; }
  .articles-admin-table .art-thumb {
    width: 56px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--cream-warm);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .articles-admin-table .art-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .articles-admin-table .art-thumb.empty { color: var(--gold-soft); font-family: var(--font-script); font-size: 16px; }
  .articles-admin-table .art-tags-cell { display: flex; gap: 4px; flex-wrap: wrap; }
  .articles-admin-table .art-status-chip {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .articles-admin-table .art-status-chip.published {
    background: var(--emerald);
    color: var(--cream);
  }
  .articles-admin-table .art-status-chip.draft {
    background: var(--cream-warm);
    color: #A87C45;
    border: 1px solid #c79e62;
  }
  .articles-admin-table .art-date-cell {
    color: var(--ink-mute);
    font-size: 12px;
  }

  /* ====== CLIENTS / PERFUME REQUESTS BLOCKS (shared visual lang) ====== */
  .clients-block, .perfreq-block {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .clients-head, .perfreq-head {
    margin-bottom: 18px;
  }
  .clients-head h2, .perfreq-head h2 {
    font-size: clamp(22px, 3vw, 28px);
    margin-top: 6px;
  }
  .clients-help, .perfreq-help {
    color: var(--ink-soft);
    margin-top: 8px;
    max-width: 540px;
    font-size: 14px;
  }
  .clients-filters, .perfreq-filters {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-bottom: 14px;
    padding-bottom: 12px;
