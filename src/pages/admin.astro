  /* ============ MOBILE DRAWER ============ */
  .admin-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 62, 37, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease-out;
