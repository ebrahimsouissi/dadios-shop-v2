  /* ====== ADMIN ====== */
  .admin {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px;
  }
  .admin-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .admin h1 { font-size: clamp(28px, 4vw, 40px); margin-top: 8px; }
  .admin-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    padding-bottom: 16px;
  }
  .tab-btn {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--cream-soft);
    color: var(--ink);
