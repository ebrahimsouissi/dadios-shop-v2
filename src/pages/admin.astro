  @media (min-width: 1024px) {
    .admin-sidebar { display: flex; }
  }
  .admin-sidebar-brand-link {
    display: block;
    padding: 4px 12px 12px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
