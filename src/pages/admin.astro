          <span>Nom du parfum *</span>
          <input type="text" name="name" id="fName" required placeholder="ex. Sauvage Élixir" />
        </label>
        <label>
          <span>Identifiant URL (slug) *</span>
          <input type="text" name="slug" id="fSlug" required placeholder="ex. sauvage-elixir" pattern="[a-z0-9\-]+" />
          <small>Lettres minuscules, chiffres, tirets uniquement.</small>
        </label>
      </div>

      <label>
        <span>Inspiré par *</span>
        <input type="text" name="inspiredBy" id="fInspired" required placeholder="ex. Dior Sauvage Élixir" />
      </label>

      <div class="form-row">
        <label>
          <span>Genre *</span>
          <select name="gender" id="fGender" required>
            <option value="homme">Homme</option>
            <option value="femme">Femme</option>
            <option value="mixte">Mixte</option>
          </select>
        </label>
        <label>
          <span>Famille olfactive *</span>
          <input type="text" name="family" id="fFamily" required placeholder="ex. Boisé · Épicé" />
        </label>
      </div>

      <label>
        <span>Description courte *</span>
        <textarea name="shortDescription" id="fDesc" rows="3" required placeholder="Une fragrance puissante..." maxlength="240"></textarea>
        <small>Apparaît dans les résultats Google. Maximum 240 caractères.</small>
      </label>

      <div class="card-block">
        <strong>Pyramide olfactive</strong>
        <small style="display:block;margin-bottom:12px">Séparez les notes par des virgules.</small>
        <label>
          <span>Notes de tête</span>
          <input type="text" name="topNotes" id="fTopN" placeholder="Bergamote, Pamplemousse" />
        </label>
        <label>
          <span>Notes de cœur</span>
          <input type="text" name="heartNotes" id="fHeartN" placeholder="Iris, Jasmin" />
        </label>
        <label>
          <span>Notes de fond</span>
          <input type="text" name="baseNotes" id="fBaseN" placeholder="Santal, Vanille, Musc" />
        </label>
      </div>

      <div class="form-row">
        <label>
          <span>Tenue</span>
          <input type="text" name="longevity" id="fLong" placeholder="ex. 8 h" />
        </label>
        <label>
          <span>Sillage</span>
          <select name="sillage" id="fSill">
            <option>Modéré</option>
            <option>Fort</option>
            <option>Énorme</option>
          </select>
        </label>
      </div>

      <div class="form-row">
        <div>
          <span class="lbl">Saisons</span>
          <div class="check-row" id="seasonsBox">
            {['Hiver','Printemps','Été','Automne'].map(s => (
              <label class="check-item"><input type="checkbox" name="seasons" value={s}/> {s}</label>
            ))}
          </div>
        </div>
        <div>
          <span class="lbl">Moments</span>
          <div class="check-row" id="momentsBox">
            {['Jour','Soir','Événement'].map(m => (
              <label class="check-item"><input type="checkbox" name="moments" value={m}/> {m}</label>
            ))}
          </div>
        </div>
      </div>

      <div class="card-block">
        <strong>Prix par format</strong>
        <small style="display:block;margin-bottom:12px">Prix globaux. Pour modifier, éditer les Sizes dans products.json.</small>
        <div class="price-grid">
          {sizes.map((s: any) => (
            <div class="price-cell">
              <span class="size-label">{s.label}</span>
              <span class="size-price">{s.price} <small>DT</small></span>
            </div>
          ))}
        </div>
      </div>

      <label class="checkbox">
        <input type="checkbox" name="featured" id="fFeat" />
        <span>Mettre en avant comme <strong>best-seller</strong> sur la page d'accueil</span>
      </label>

      <label class="checkbox">
        <input type="checkbox" name="vipOnly" id="fVipOnly" />
        <span>👑 Réservé aux <strong>VIP</strong> (masqué aux autres clients)</span>
      </label>

      <label>
        <span>💼 Prix grossiste (DT) — facultatif, visible uniquement aux Resellers</span>
        <input type="number" name="wholesalePrice" id="fWholesale" min="0" step="0.01" placeholder="Laisser vide si non applicable" />
      </label>

      <div class="form-actions">
        <button type="button" class="btn btn-outline" id="cancelBtn">Annuler</button>
        <button type="submit" class="btn btn-primary" id="saveBtn">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

</Base>

<style>
  /* ============================================================
     REFONTE ADMIN — SHELL (Slice 1)
     Sidebar nav + topbar + mobile drawer + bottom nav + content
     ============================================================ */

  /* Reset Base.astro's nav from this page — admin has its own chrome.
     Keep the existing site nav hidden behind the new admin topbar. */
  body { background: #FAF6F0; }
  body > nav.nav, body > footer { display: none !important; }

  .admin-shell {
    --admin-emerald: #0F5132;
    --admin-emerald-deep: #0A3E25;
    --admin-gold: #D4AF37;
    --admin-gold-hover: #BF9B30;
    --admin-cream: #FAF6F0;
    --admin-paper: #FFFFFF;
    --admin-ink: #1F1F1F;
    --admin-ink-soft: #6B6B6B;
    --admin-ink-mute: #9B9B9B;
    --admin-border: #E8DFC8;
    --admin-success: #22C55E;
    --admin-warning: #F59E0B;
    --admin-danger: #EF4444;
    --admin-info: #3B82F6;
    --admin-sidebar-w: 240px;
    --admin-topbar-h: 60px;
    --admin-bottomnav-h: 64px;

    min-height: 100vh;
    background: var(--admin-cream);
    color: var(--admin-ink);
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: var(--admin-topbar-h) 1fr;
    grid-template-areas:
      "topbar"
      "content";
  }
  .admin-shell.hidden { display: none; }

  @media (min-width: 1024px) {
    .admin-shell {
      grid-template-columns: var(--admin-sidebar-w) 1fr;
      grid-template-rows: var(--admin-topbar-h) 1fr;
      grid-template-areas:
        "sidebar topbar"
        "sidebar content";
    }
  }

  /* ============ TOPBAR ============ */
  .admin-topbar {
    grid-area: topbar;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--admin-paper);
    border-bottom: 1px solid var(--admin-border);
    display: grid;
    grid-template-columns: 44px 1fr auto auto;
    gap: 12px;
    align-items: center;
    padding: 0 16px;
    box-shadow: 0 1px 3px rgba(15, 81, 50, 0.04);
  }
  @media (min-width: 1024px) {
    .admin-topbar {
      grid-template-columns: minmax(280px, 480px) 1fr auto;
      padding: 0 24px;
    }
  }
  .admin-burger {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: var(--admin-ink);
    cursor: pointer;
  }
  .admin-burger:active, .admin-burger:hover { background: rgba(15, 81, 50, 0.06); }
  @media (min-width: 1024px) {
    .admin-burger { display: none; }
  }
  .admin-topbar-brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--admin-ink);
