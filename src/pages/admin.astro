  .customer-actions {
    display: flex;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .modal-box.small { max-width: 440px; }

  @media (max-width: 720px) {
    .customer-row { grid-template-columns: 1fr; gap: 14px; }
    .customer-search { flex-direction: column; }
  }

  /* ====== ORDERS BLOCK ====== */
