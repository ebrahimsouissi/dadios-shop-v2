  const ORDER_STATUS_LABEL: Record<string, string> = {
    pending: 'En attente',
    confirmed: 'Confirmée',
    delivered: 'Livrée',
    cancelled: 'Annulée',
  };
  const ORDER_TRANSITIONS: Record<string, string[]> = {
    pending: ['confirmed', 'cancelled'],
    confirmed: ['delivered', 'cancelled'],
    delivered: [],
    cancelled: [],
  };

  let allOrders: any[] = [];
  let currentOrderFilter = '';
  let modalOrderId = '';

  function escH(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]!);
  }
  function fmtOrderDate(iso: string) {
    if (!iso) return '';
    try {
      return new Date(iso).toLocaleString('fr-FR', {
        day: '2-digit', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit',
      });
    } catch { return iso; }
  }

  function showOrdersStatus(msg: string, kind: 'success' | 'error' | '' = '') {
    ordersStatusEl.textContent = msg;
    ordersStatusEl.className = 'status-msg ' + (kind || '');
    ordersStatusEl.classList.remove('hidden');
    setTimeout(() => ordersStatusEl.classList.add('hidden'), 4000);
  }

  function statusSelectHtml(orderId: string, currentStatus: string) {
    const allowed = ORDER_TRANSITIONS[currentStatus] || [];
    const terminal = allowed.length === 0;
    // The current status is always present and selected; allowed transitions follow.
    const visible = [currentStatus, ...allowed];
    const opts = visible
      .map((s) => `<option value="${escH(s)}" ${s === currentStatus ? 'selected' : ''}>${escH(ORDER_STATUS_LABEL[s] || s)}</option>`)
      .join('');
    return `<select data-order-id="${escH(orderId)}" data-current="${escH(currentStatus)}" ${terminal ? 'disabled' : ''}>${opts}</select>`;
  }

  function renderOrderRow(o: any) {
    const itemCount = (o.items || []).reduce((n: number, i: any) => n + (Number(i.qty) || 1), 0);
    const customerCell = `
      <span class="cust-name">${escH(o.customerName || '—')}</span>
      <span class="cust-phone">${escH(o.phone || '')}</span>
    `;
    return `<tr data-order-id="${escH(o.id)}">
      <td>${escH(fmtOrderDate(o.createdAt))}</td>
      <td><span class="ref-mono">#${escH(shortOrderId(o.id))}</span></td>
      <td>${customerCell}</td>
      <td>${itemCount} article${itemCount > 1 ? 's' : ''}</td>
      <td class="total-cell">${Number(o.total) || 0} DT</td>
      <td class="status-cell">${statusSelectHtml(o.id, o.status || 'pending')}</td>
      <td><button type="button" class="link-btn order-details-btn" data-order-id="${escH(o.id)}">Détails</button></td>
    </tr>`;
  }

  function updateFilterCounts() {
    const counts: Record<string, number> = {
      '': allOrders.length,
      pending: 0, confirmed: 0, delivered: 0, cancelled: 0,
    };
    allOrders.forEach((o) => {
      const s = String(o.status || 'pending');
      counts[s] = (counts[s] || 0) + 1;
    });
    ordersFiltersEl.querySelectorAll('.filter-pill').forEach((p) => {
      const status = (p as HTMLElement).dataset.status || '';
      const c = p.querySelector('.count');
      if (c) c.textContent = String(counts[status] ?? 0);
    });
  }

  function renderOrdersTable() {
    const filtered = currentOrderFilter
      ? allOrders.filter((o) => o.status === currentOrderFilter)
      : allOrders;
    if (!filtered.length) {
      ordersRowsEl.innerHTML = `<tr class="orders-empty-row"><td colspan="7">Aucune commande${currentOrderFilter ? ' dans cette catégorie' : ''}.</td></tr>`;
      return;
    }
    ordersRowsEl.innerHTML = filtered.map(renderOrderRow).join('');
  }

  async function loadAdminOrders() {
    ordersRowsEl.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:32px">Chargement des commandes…</td></tr>`;
    const res = await adminListOrders();
    if (!res.ok) {
      ordersRowsEl.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escH(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    allOrders = (res.orders || []) as any[];
    updateFilterCounts();
    renderOrdersTable();
  }

  // ===== Filter pill switching =====
  ordersFiltersEl.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest('.filter-pill') as HTMLElement | null;
    if (!pill) return;
    ordersFiltersEl.querySelectorAll('.filter-pill').forEach((p) => p.classList.remove('active'));
    pill.classList.add('active');
    currentOrderFilter = pill.dataset.status || '';
    renderOrdersTable();
  });

  ordersRefreshBtn?.addEventListener('click', () => loadAdminOrders());

  // ===== Inline status change =====
  ordersRowsEl.addEventListener('change', async (e) => {
    const sel = (e.target as HTMLElement).closest('select[data-order-id]') as HTMLSelectElement | null;
    if (!sel) return;
    const orderId = sel.dataset.orderId!;
    const current = sel.dataset.current || '';
    const newStatus = sel.value;
    if (newStatus === current) return;
    sel.disabled = true;
    const res = await adminUpdateOrder(orderId, { status: newStatus });
    sel.disabled = false;
    if (!res.ok || !res.order) {
      sel.value = current;
      showOrdersStatus(res.error || 'Mise à jour impossible', 'error');
      return;
    }
    // Patch the local cache and re-render so counts and the row reflect the new state.
    const idx = allOrders.findIndex((o) => o.id === orderId);
    if (idx >= 0) allOrders[idx] = res.order;
    updateFilterCounts();
    renderOrdersTable();
    showOrdersStatus(`Statut → ${ORDER_STATUS_LABEL[newStatus] || newStatus}`, 'success');
  });

  // ===== Details modal =====
  ordersRowsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.order-details-btn') as HTMLElement | null;
    if (!btn) return;
    const orderId = btn.dataset.orderId!;
    const order = allOrders.find((o) => o.id === orderId);
    if (!order) return;
    openOrderModal(order);
  });

  function openOrderModal(o: any) {
    modalOrderId = o.id;
    orderTitleEl.textContent = `Commande #${shortOrderId(o.id)}`;
    orderMetaEl.textContent = `Statut : ${ORDER_STATUS_LABEL[o.status] || o.status} · ${fmtOrderDate(o.createdAt)}`;

    const itemsHtml = (o.items || [])
      .map((i: any) => {
        const sub = (Number(i.price) || 0) * (Number(i.qty) || 1);
        const sizeStr = i.size ? ` (${escH(i.size)})` : '';
        return `<li><span class="li-name">${Number(i.qty) || 1}× ${escH(i.name)}${sizeStr}</span><span class="li-sub">${sub} DT</span></li>`;
      })
      .join('');
    orderModalItems.innerHTML = itemsHtml;
    orderModalTotal.innerHTML = `<span class="lbl">Total</span><span class="val">${Number(o.total) || 0} DT</span>`;

    orderCustomerName.textContent = o.customerName || 'Client invité';
    if (!o.customerName) orderCustomerName.classList.add('muted');
    else orderCustomerName.classList.remove('muted');

    if (o.phone) {
      orderCustomerPhone.innerHTML = `<a href="tel:${escH(o.phone)}">${escH(o.phone)}</a>`;
      orderCustomerActions.innerHTML = `
        <a class="btn btn-gold btn-sm" href="https://wa.me/${encodeURIComponent(o.phone.replace(/[^\d+]/g, ''))}" target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn-outline btn-sm" href="tel:${escH(o.phone)}">Appeler</a>
      `;
    } else {
      orderCustomerPhone.textContent = '—';
      orderCustomerActions.innerHTML = '';
    }

    orderNotes.value = o.notes || '';
    orderNotesStatus.textContent = '';
    orderNotesStatus.classList.remove('visible');

    orderStamps.textContent = `Créée le ${fmtOrderDate(o.createdAt)} · Dernière mise à jour ${fmtOrderDate(o.updatedAt)}`;

    orderModal.classList.remove('hidden');
  }
  function closeOrderModal() {
    orderModal.classList.add('hidden');
    modalOrderId = '';
  }
  orderClose?.addEventListener('click', closeOrderModal);
  orderOverlay?.addEventListener('click', closeOrderModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !orderModal.classList.contains('hidden')) closeOrderModal();
  });

  orderSaveNotes?.addEventListener('click', async () => {
    if (!modalOrderId) return;
    orderSaveNotes.disabled = true;
    orderSaveNotes.textContent = 'Enregistrement…';
    const res = await adminUpdateOrder(modalOrderId, { notes: orderNotes.value });
    orderSaveNotes.disabled = false;
    orderSaveNotes.textContent = 'Enregistrer les notes';
    if (!res.ok || !res.order) {
      orderNotesStatus.textContent = res.error || 'Échec';
      orderNotesStatus.style.color = '#B23A1F';
      orderNotesStatus.classList.add('visible');
      return;
    }
    const idx = allOrders.findIndex((o) => o.id === modalOrderId);
    if (idx >= 0) allOrders[idx] = res.order;
    orderNotesStatus.textContent = '✓ Notes enregistrées';
    orderNotesStatus.style.color = '';
    orderNotesStatus.classList.add('visible');
    setTimeout(() => orderNotesStatus.classList.remove('visible'), 2400);
  });

  // ===== After admin login, also hydrate the orders block =====
  // attemptLogin() already calls loadProducts(); we hook the orders load
  // into the same code path by patching loadProducts to also fire ours.
  // Cheapest way: observe DOM, kick once when adminMain becomes visible.
  const adminMainObserver = new MutationObserver(() => {
    if (!adminMain?.classList.contains('hidden')) {
      adminMainObserver.disconnect();
      loadAdminOrders();
    }
  });
  if (adminMain) adminMainObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  // If we're already past the gate when this runs (auto-login path), fire now.
  if (adminMain && !adminMain.classList.contains('hidden')) loadAdminOrders();

  // ============ JOURNAL (articles) ============
  const articlesFiltersEl = document.getElementById('articlesFilters') as HTMLElement;
  const articlesRowsEl = document.getElementById('articlesRows') as HTMLElement;
  const articlesStatusEl = document.getElementById('articlesStatus') as HTMLElement;

  let allArticles: any[] = [];
  let currentArticleFilter = '';

  function escA(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]!);
  }
  function showArticlesStatus(msg: string, kind: 'success' | 'error' | '' = '') {
    articlesStatusEl.textContent = msg;
    articlesStatusEl.className = 'status-msg ' + (kind || '');
    articlesStatusEl.classList.remove('hidden');
    setTimeout(() => articlesStatusEl.classList.add('hidden'), 4000);
  }

  function renderArticleRow(a: any) {
    const thumb = a.heroImage
      ? `<div class="art-thumb"><img src="${escA(a.heroImage)}" alt=""/></div>`
      : `<div class="art-thumb empty">D</div>`;
    const tagsHtml = (a.tags || []).slice(0, 3).map((t: string) =>
      `<span class="art-status-chip" style="background:var(--cream-warm);color:var(--ink-soft);border:1px solid var(--border)">${escA(t)}</span>`
    ).join('');
    const status = a.status === 'published' ? 'published' : 'draft';
    const statusLabel = status === 'published' ? 'Publié' : 'Brouillon';
    const dateLabel = frenchRelativeDate(a.publishedAt || a.updatedAt || a.createdAt);
    const previewBtn = status === 'published'
      ? `<a class="link-btn" href="/journal/${escA(a.slug)}" target="_blank" rel="noopener">Aperçu</a>`
      : `<a class="link-btn" href="/journal/${escA(a.slug)}?preview=1" target="_blank" rel="noopener">Aperçu</a>`;
    const pubBtn = status === 'published'
      ? `<button type="button" class="link-btn" data-action="unpublish" data-slug="${escA(a.slug)}">Dépublier</button>`
      : `<button type="button" class="link-btn" data-action="publish"   data-slug="${escA(a.slug)}">Publier</button>`;

    return `<tr data-slug="${escA(a.slug)}">
      <td>${thumb}</td>
      <td>
        <strong>${escA(a.title)}</strong>
        <div class="cust-phone">/journal/${escA(a.slug)}</div>
      </td>
      <td class="art-tags-cell">${tagsHtml || '<span class="muted">—</span>'}</td>
      <td><span class="art-status-chip ${status}">${statusLabel}</span></td>
      <td class="art-date-cell">${escA(dateLabel)}</td>
      <td>
        <a class="link-btn" href="/admin/articles/new?slug=${encodeURIComponent(a.slug)}">Modifier</a>
        ${previewBtn}
        ${pubBtn}
        <button type="button" class="link-btn danger" data-action="delete" data-slug="${escA(a.slug)}">Supprimer</button>
      </td>
    </tr>`;
  }

  function updateArticleFilterCounts() {
    const counts: Record<string, number> = { '': allArticles.length, published: 0, draft: 0 };
    allArticles.forEach((a) => {
      const s = a.status === 'published' ? 'published' : 'draft';
      counts[s] = (counts[s] || 0) + 1;
    });
    articlesFiltersEl.querySelectorAll('.filter-pill').forEach((p) => {
      const status = (p as HTMLElement).dataset.status || '';
      const c = p.querySelector('.count');
      if (c) c.textContent = String(counts[status] ?? 0);
    });
  }

  function renderArticlesTable() {
    const filtered = currentArticleFilter
      ? allArticles.filter((a) => (a.status === 'published' ? 'published' : 'draft') === currentArticleFilter)
      : allArticles;
    if (!filtered.length) {
      articlesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--ink-mute);font-style:italic">Aucun article${currentArticleFilter ? ' dans cette catégorie' : ''}.</td></tr>`;
      return;
    }
    articlesRowsEl.innerHTML = filtered.map(renderArticleRow).join('');
  }

  async function loadAdminArticles() {
    articlesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px">Chargement des articles…</td></tr>`;
    const res = await adminListArticles();
    if (!res.ok) {
      articlesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escA(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    allArticles = (res.articles || []) as any[];
    updateArticleFilterCounts();
    renderArticlesTable();
  }

  articlesFiltersEl.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest('.filter-pill') as HTMLElement | null;
    if (!pill) return;
    articlesFiltersEl.querySelectorAll('.filter-pill').forEach((p) => p.classList.remove('active'));
    pill.classList.add('active');
    currentArticleFilter = pill.dataset.status || '';
    renderArticlesTable();
  });

  articlesRowsEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLElement | null;
    if (!btn) return;
    const action = btn.dataset.action;
    const slug = btn.dataset.slug;
    if (!slug || !action) return;

    if (action === 'delete') {
      const a = allArticles.find((x) => x.slug === slug);
      if (!confirm(`Supprimer l'article "${a?.title || slug}" ? Action irréversible.`)) return;
      const res = await adminDeleteArticle(slug);
      if (res.ok) {
        allArticles = allArticles.filter((x) => x.slug !== slug);
        updateArticleFilterCounts();
        renderArticlesTable();
        showArticlesStatus('✓ Article supprimé.', 'success');
      } else {
        showArticlesStatus(res.error || 'Suppression impossible.', 'error');
      }
    } else if (action === 'publish' || action === 'unpublish') {
      btn.setAttribute('disabled', 'true');
      const res = action === 'publish'
        ? await adminPublishArticle(slug)
        : await adminUnpublishArticle(slug);
      btn.removeAttribute('disabled');
      if (res.ok && res.article) {
        const idx = allArticles.findIndex((x) => x.slug === slug);
        if (idx >= 0) allArticles[idx] = { ...allArticles[idx], ...res.article };
        updateArticleFilterCounts();
        renderArticlesTable();
        showArticlesStatus(action === 'publish' ? '✓ Article publié.' : '✓ Article dépublié.', 'success');
      } else {
        showArticlesStatus(res.error || 'Opération impossible.', 'error');
      }
    }
  });

  // Load articles once we're past the admin gate (same observer pattern as orders).
  const articlesObserver = new MutationObserver(() => {
    if (!adminMain?.classList.contains('hidden')) {
      articlesObserver.disconnect();
      loadAdminArticles();
    }
  });
  if (adminMain) articlesObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  if (adminMain && !adminMain.classList.contains('hidden')) loadAdminArticles();

  // ============ CLIENTS (tier management) ============
  const clientsFiltersEl = document.getElementById('clientsFilters') as HTMLElement;
  const clientsRowsEl = document.getElementById('clientsRows') as HTMLElement;
  const clientsStatusEl = document.getElementById('clientsStatus') as HTMLElement;
  const clientsSearchEl = document.getElementById('clientsSearch') as HTMLInputElement;

  const tierModal = document.getElementById('tierModal') as HTMLElement;
  const tierOverlay = document.getElementById('tierOverlay') as HTMLElement;
  const tierClose = document.getElementById('tierClose') as HTMLButtonElement;
  const tierCancel = document.getElementById('tierCancel') as HTMLButtonElement;
  const tierForm = document.getElementById('tierForm') as HTMLFormElement;
  const tierSelect = document.getElementById('tierSelect') as HTMLSelectElement;
  const tierResellerFields = document.getElementById('tierResellerFields') as HTMLElement;
  const tierCompany = document.getElementById('tierCompany') as HTMLInputElement;
  const tierMatricule = document.getElementById('tierMatricule') as HTMLInputElement;
  const tierDelivery = document.getElementById('tierDelivery') as HTMLTextAreaElement;
  const tierErr = document.getElementById('tierErr') as HTMLElement;
  const tierSave = document.getElementById('tierSave') as HTMLButtonElement;
  const tierTitle = document.getElementById('tierTitle') as HTMLElement;
  const tierSubtitle = document.getElementById('tierSubtitle') as HTMLElement;

  const TIER_LABEL: Record<string, string> = {
    regular: 'Régulier', vip: 'VIP', reseller: 'Reseller',
  };

  let allClients: any[] = [];
  let currentClientFilter = '';
  let editingClientPhone = '';

  function escC(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]!);
  }

  function clientFilteredView() {
    const tier = currentClientFilter;
    const q = (clientsSearchEl.value || '').trim().toLowerCase();
    return allClients.filter((c) => {
      if (tier && (c.tier || 'regular') !== tier) return false;
      if (q) {
        const hay = `${c.phone || ''} ${c.name || ''}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  function renderClientsTable() {
    const filtered = clientFilteredView();
    if (!filtered.length) {
      clientsRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--ink-mute);font-style:italic">Aucun client.</td></tr>`;
      return;
    }
    clientsRowsEl.innerHTML = filtered.map((c) => {
      const tier = c.tier || 'regular';
      return `<tr data-phone="${escC(c.phone)}">
        <td>${escC(c.phone || '')}</td>
        <td>${escC(c.name || '—')}</td>
        <td><span class="tier-cell ${escC(tier)}">${escC(TIER_LABEL[tier] || tier)}</span></td>
        <td>${c.loyaltyCode ? escC(c.loyaltyCode) : '<span class="muted">—</span>'}</td>
        <td class="art-date-cell">${escC(frenchRelativeDate(c.createdAt))}</td>
        <td>
          <button type="button" class="link-btn" data-action="change-tier" data-phone="${escC(c.phone)}">Changer le statut</button>
          ${tier !== 'regular' ? `<button type="button" class="link-btn danger" data-action="revoke" data-phone="${escC(c.phone)}">Révoquer</button>` : ''}
        </td>
      </tr>`;
    }).join('');
  }

  function updateClientFilterCounts() {
    const counts: Record<string, number> = { '': allClients.length, regular: 0, vip: 0, reseller: 0 };
    allClients.forEach((c) => {
      const t = c.tier || 'regular';
      counts[t] = (counts[t] || 0) + 1;
    });
    clientsFiltersEl.querySelectorAll('.filter-pill').forEach((p) => {
      const tier = (p as HTMLElement).dataset.tier || '';
      const c = p.querySelector('.count');
      if (c) c.textContent = String(counts[tier] ?? 0);
    });
  }

  async function loadClients() {
    clientsRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>`;
    const res = await adminListCustomers();
    if (!res.ok) {
      clientsRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escC(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    allClients = res.customers || [];
    updateClientFilterCounts();
    renderClientsTable();
  }

  clientsFiltersEl.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest('.filter-pill') as HTMLElement | null;
    if (!pill) return;
    clientsFiltersEl.querySelectorAll('.filter-pill').forEach((p) => p.classList.remove('active'));
    pill.classList.add('active');
    currentClientFilter = pill.dataset.tier || '';
    renderClientsTable();
  });

  clientsSearchEl?.addEventListener('input', () => renderClientsTable());

  function showClientStatus(msg: string, kind: 'success' | 'error' | '' = '') {
    clientsStatusEl.textContent = msg;
    clientsStatusEl.className = 'status-msg ' + (kind || '');
    clientsStatusEl.classList.remove('hidden');
    setTimeout(() => clientsStatusEl.classList.add('hidden'), 4000);
  }

  clientsRowsEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLElement | null;
    if (!btn) return;
    const phone = btn.dataset.phone || '';
    const action = btn.dataset.action;
    if (action === 'change-tier') {
      const c = allClients.find((x) => x.phone === phone);
      openTierModal(c);
    } else if (action === 'revoke') {
      if (!confirm(`Révoquer le statut de ${phone} (retour à Régulier) ?`)) return;
      const res = await adminRevokeTier(phone);
      if (res.ok) {
        const idx = allClients.findIndex((x) => x.phone === phone);
        if (idx >= 0) allClients[idx].tier = 'regular';
        updateClientFilterCounts();
        renderClientsTable();
        showClientStatus('✓ Statut révoqué.', 'success');
      } else {
        showClientStatus(res.error || 'Échec.', 'error');
      }
    }
  });

  function openTierModal(c: any) {
    if (!c) return;
    editingClientPhone = c.phone;
    tierTitle.textContent = `Statut de ${c.name || c.phone}`;
    tierSubtitle.textContent = `Téléphone : ${c.phone}`;
    tierSelect.value = c.tier || 'regular';
    tierCompany.value = c.companyName || '';
    tierMatricule.value = c.matriculeFiscale || '';
    tierDelivery.value = c.deliveryAddress || '';
    tierResellerFields.hidden = tierSelect.value !== 'reseller';
    tierErr.classList.add('hidden');
    tierModal.classList.remove('hidden');
  }
  function closeTierModal() {
    tierModal.classList.add('hidden');
    editingClientPhone = '';
  }
  tierSelect.addEventListener('change', () => {
    tierResellerFields.hidden = tierSelect.value !== 'reseller';
  });
  tierClose.addEventListener('click', closeTierModal);
  tierCancel.addEventListener('click', closeTierModal);
  tierOverlay.addEventListener('click', closeTierModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !tierModal.classList.contains('hidden')) closeTierModal();
  });

  tierForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editingClientPhone) return;
    tierErr.classList.add('hidden');
    tierSave.disabled = true;
    tierSave.textContent = 'Enregistrement…';
    const tier = tierSelect.value;
    const extras: any = {};
    if (tier === 'reseller') {
      extras.companyName = tierCompany.value.trim();
      extras.matriculeFiscale = tierMatricule.value.trim();
      extras.deliveryAddress = tierDelivery.value.trim();
    }
    const res = await adminGrantTier(editingClientPhone, tier, extras);
    tierSave.disabled = false;
    tierSave.textContent = 'Enregistrer';
    if (!res.ok || !res.customer) {
      tierErr.textContent = res.error || 'Échec.';
      tierErr.classList.remove('hidden');
      return;
    }
    const idx = allClients.findIndex((x) => x.phone === editingClientPhone);
    if (idx >= 0) {
      allClients[idx] = { ...allClients[idx], ...res.customer };
    }
    closeTierModal();
    updateClientFilterCounts();
    renderClientsTable();
    showClientStatus('✓ Statut mis à jour.', 'success');
  });

  const clientsObserver = new MutationObserver(() => {
    if (!adminMain?.classList.contains('hidden')) {
      clientsObserver.disconnect();
      loadClients();
    }
  });
  if (adminMain) clientsObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  if (adminMain && !adminMain.classList.contains('hidden')) loadClients();

  // ============ PERFUME REQUESTS (concierge) ============
  const perfreqFiltersEl = document.getElementById('perfreqFilters') as HTMLElement;
  const perfreqRowsEl = document.getElementById('perfreqRows') as HTMLElement;
  const perfreqStatusEl = document.getElementById('perfreqStatus') as HTMLElement;

  const perfreqModal = document.getElementById('perfreqModal') as HTMLElement;
  const perfreqOverlay = document.getElementById('perfreqOverlay') as HTMLElement;
  const perfreqClose = document.getElementById('perfreqClose') as HTMLButtonElement;
  const perfreqTitle = document.getElementById('perfreqTitle') as HTMLElement;
  const perfreqMeta = document.getElementById('perfreqMeta') as HTMLElement;
  const perfreqPerfume = document.getElementById('perfreqPerfume') as HTMLElement;
  const perfreqBrand = document.getElementById('perfreqBrand') as HTMLElement;
  const perfreqCustNotes = document.getElementById('perfreqCustNotes') as HTMLElement;
  const perfreqCustName = document.getElementById('perfreqCustName') as HTMLElement;
  const perfreqCustPhone = document.getElementById('perfreqCustPhone') as HTMLElement;
  const perfreqCustActions = document.getElementById('perfreqCustActions') as HTMLElement;
  const perfreqAdminNotes = document.getElementById('perfreqAdminNotes') as HTMLTextAreaElement;
  const perfreqSaveNotes = document.getElementById('perfreqSaveNotes') as HTMLButtonElement;
  const perfreqNotesStatus = document.getElementById('perfreqNotesStatus') as HTMLElement;
  const perfreqStamps = document.getElementById('perfreqStamps') as HTMLElement;

  let allPerfReqs: any[] = [];
  let currentPerfReqFilter = '';
  let modalPerfReqId = '';

  function pfStatusSelect(reqId: string, status: string) {
    const allowed = PERFUME_REQUEST_TRANSITIONS[status] || [];
    const terminal = allowed.length === 0;
    const visible = [status, ...allowed];
    const opts = visible.map((s) =>
      `<option value="${escC(s)}" ${s === status ? 'selected' : ''}>${escC(PERFUME_REQUEST_STATUS_LABELS[s] || s)}</option>`
    ).join('');
    return `<select data-request-id="${escC(reqId)}" data-current="${escC(status)}" ${terminal ? 'disabled' : ''}>${opts}</select>`;
  }

  function renderPerfReqRow(r: any) {
    return `<tr data-request-id="${escC(r.id)}">
      <td>${escC(frenchRelativeDate(r.createdAt))}</td>
      <td>
        <strong>${escC(r.customerName || '—')}</strong>
        <div class="cust-phone">${escC(r.phone || '')}</div>
      </td>
      <td>${escC(r.perfumeName || '')}</td>
      <td>${escC(r.brand || '—')}</td>
      <td class="status-cell">${pfStatusSelect(r.id, r.status || 'pending')}</td>
      <td><button type="button" class="link-btn pf-details-btn" data-request-id="${escC(r.id)}">Détails</button></td>
    </tr>`;
  }

  function updatePerfReqCounts() {
    const counts: Record<string, number> = {
      '': allPerfReqs.length,
      pending: 0, in_progress: 0, fulfilled: 0, declined: 0,
    };
    allPerfReqs.forEach((r) => {
      const s = String(r.status || 'pending');
      counts[s] = (counts[s] || 0) + 1;
    });
    perfreqFiltersEl.querySelectorAll('.filter-pill').forEach((p) => {
      const status = (p as HTMLElement).dataset.status || '';
      const c = p.querySelector('.count');
      if (c) c.textContent = String(counts[status] ?? 0);
    });
  }

  function renderPerfReqTable() {
    const filtered = currentPerfReqFilter
      ? allPerfReqs.filter((r) => r.status === currentPerfReqFilter)
      : allPerfReqs;
    if (!filtered.length) {
      perfreqRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--ink-mute);font-style:italic">Aucune demande${currentPerfReqFilter ? ' dans cette catégorie' : ''}.</td></tr>`;
      return;
    }
    perfreqRowsEl.innerHTML = filtered.map(renderPerfReqRow).join('');
  }

  function showPerfReqStatus(msg: string, kind: 'success' | 'error' | '' = '') {
    perfreqStatusEl.textContent = msg;
    perfreqStatusEl.className = 'status-msg ' + (kind || '');
    perfreqStatusEl.classList.remove('hidden');
    setTimeout(() => perfreqStatusEl.classList.add('hidden'), 4000);
  }

  async function loadPerfReqs() {
    perfreqRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>`;
    const res = await adminListPerfumeRequests();
    if (!res.ok) {
      perfreqRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escC(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    allPerfReqs = res.requests || [];
    updatePerfReqCounts();
    renderPerfReqTable();
  }

  perfreqFiltersEl.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest('.filter-pill') as HTMLElement | null;
    if (!pill) return;
    perfreqFiltersEl.querySelectorAll('.filter-pill').forEach((p) => p.classList.remove('active'));
    pill.classList.add('active');
    currentPerfReqFilter = pill.dataset.status || '';
    renderPerfReqTable();
  });

  perfreqRowsEl.addEventListener('change', async (e) => {
    const sel = (e.target as HTMLElement).closest('select[data-request-id]') as HTMLSelectElement | null;
    if (!sel) return;
    const requestId = sel.dataset.requestId!;
    const current = sel.dataset.current || '';
    const newStatus = sel.value;
    if (newStatus === current) return;
    sel.disabled = true;
    const res = await adminUpdatePerfumeRequest(requestId, { status: newStatus });
    sel.disabled = false;
    if (!res.ok || !res.request) {
      sel.value = current;
      showPerfReqStatus(res.error || 'Mise à jour impossible.', 'error');
      return;
    }
    const idx = allPerfReqs.findIndex((r) => r.id === requestId);
    if (idx >= 0) allPerfReqs[idx] = res.request;
    updatePerfReqCounts();
    renderPerfReqTable();
    showPerfReqStatus(`Statut → ${PERFUME_REQUEST_STATUS_LABELS[newStatus] || newStatus}`, 'success');
  });

  perfreqRowsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.pf-details-btn') as HTMLElement | null;
    if (!btn) return;
    const id = btn.dataset.requestId!;
    const r = allPerfReqs.find((x) => x.id === id);
    if (r) openPerfReqModal(r);
  });

  function openPerfReqModal(r: any) {
    modalPerfReqId = r.id;
    perfreqTitle.textContent = `Demande — ${r.perfumeName}`;
    perfreqMeta.textContent = `Statut : ${PERFUME_REQUEST_STATUS_LABELS[r.status] || r.status} · ${frenchRelativeDate(r.createdAt)}`;
    perfreqPerfume.textContent = r.perfumeName || '—';
    perfreqBrand.textContent = r.brand ? `Marque : ${r.brand}` : 'Marque : —';
    perfreqCustNotes.textContent = r.notes || '—';
    perfreqCustName.textContent = r.customerName || 'Client VIP';
    perfreqCustName.classList.toggle('muted', !r.customerName);
    if (r.phone) {
      perfreqCustPhone.innerHTML = `<a href="tel:${escC(r.phone)}">${escC(r.phone)}</a>`;
      perfreqCustActions.innerHTML = `
        <a class="btn btn-gold btn-sm" href="https://wa.me/${encodeURIComponent(r.phone.replace(/[^\d+]/g,''))}" target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn-outline btn-sm" href="tel:${escC(r.phone)}">Appeler</a>
      `;
    } else {
      perfreqCustPhone.textContent = '—';
      perfreqCustActions.innerHTML = '';
    }
    perfreqAdminNotes.value = r.adminNotes || '';
    perfreqNotesStatus.textContent = '';
    perfreqNotesStatus.classList.remove('visible');
    perfreqStamps.textContent = `Créée le ${frenchRelativeDate(r.createdAt)} · Dernière mise à jour ${frenchRelativeDate(r.updatedAt)}`;
    perfreqModal.classList.remove('hidden');
  }
  function closePerfReqModal() {
    perfreqModal.classList.add('hidden');
    modalPerfReqId = '';
  }
  perfreqClose.addEventListener('click', closePerfReqModal);
  perfreqOverlay.addEventListener('click', closePerfReqModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !perfreqModal.classList.contains('hidden')) closePerfReqModal();
  });

  perfreqSaveNotes.addEventListener('click', async () => {
    if (!modalPerfReqId) return;
    perfreqSaveNotes.disabled = true;
    perfreqSaveNotes.textContent = 'Enregistrement…';
    const res = await adminUpdatePerfumeRequest(modalPerfReqId, { adminNotes: perfreqAdminNotes.value });
    perfreqSaveNotes.disabled = false;
    perfreqSaveNotes.textContent = 'Enregistrer les notes';
    if (!res.ok || !res.request) {
      perfreqNotesStatus.textContent = res.error || 'Échec';
      perfreqNotesStatus.style.color = '#B23A1F';
      perfreqNotesStatus.classList.add('visible');
      return;
    }
    const idx = allPerfReqs.findIndex((r) => r.id === modalPerfReqId);
    if (idx >= 0) allPerfReqs[idx] = res.request;
    perfreqNotesStatus.textContent = '✓ Notes enregistrées';
    perfreqNotesStatus.style.color = '';
    perfreqNotesStatus.classList.add('visible');
    setTimeout(() => perfreqNotesStatus.classList.remove('visible'), 2400);
  });

  const perfreqObserver = new MutationObserver(() => {
    if (!adminMain?.classList.contains('hidden')) {
      perfreqObserver.disconnect();
      loadPerfReqs();
    }
  });
  if (adminMain) perfreqObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  if (adminMain && !adminMain.classList.contains('hidden')) loadPerfReqs();

  // ============ REVIEWS (avis clients) ============
  const reviewsFiltersEl = document.getElementById('reviewsFilters') as HTMLElement;
  const reviewsRowsEl = document.getElementById('reviewsRows') as HTMLElement;
  const reviewsStatusEl = document.getElementById('reviewsStatus') as HTMLElement;
  const revPendingBadge = document.getElementById('revPendingBadge') as HTMLElement;

  const REV_STATUS_LABEL: Record<string, string> = {
    approved: 'Approuvé',
    pending: 'En attente',
    rejected: 'Refusé',
  };

  let allReviews: any[] = [];
  let currentReviewFilter = 'pending';

  function escR(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]!);
  }

  function reviewRowHtml(r: any) {
    const status = r.status || 'pending';
    const actions: string[] = [];
    if (status !== 'approved') {
      actions.push(`<button type="button" class="link-btn rev-approve" data-id="${escR(r.id)}">Approuver</button>`);
    }
    if (status !== 'rejected') {
      actions.push(`<button type="button" class="link-btn rev-reject" data-id="${escR(r.id)}">Rejeter</button>`);
    }
    actions.push(`<button type="button" class="link-btn danger rev-delete" data-id="${escR(r.id)}">Supprimer</button>`);
    return `<tr data-id="${escR(r.id)}">
      <td class="art-date-cell">${escR(formatReviewDate(r.createdAt))}</td>
      <td>${escR(r.customerName || 'Client Dadios')}</td>
      <td><a href="/parfums/${escR(r.productId)}" target="_blank" rel="noopener">${escR(r.productId)}</a></td>
      <td><span class="rev-rating-cell"><span class="rev-stars">${revStarsHtml(r.rating, 14)}</span></span></td>
      <td class="rev-text-cell">${escR(r.text || '')}</td>
      <td>
        <span class="rev-status-cell ${escR(status)}">${escR(REV_STATUS_LABEL[status] || status)}</span>
        ${r.verified ? '<span class="rev-verified-tag">Vérifié</span>' : ''}
      </td>
      <td>${actions.join(' ')}</td>
    </tr>`;
  }

  function renderReviewsTable() {
    if (!allReviews.length) {
      reviewsRowsEl.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:24px;color:var(--ink-mute);font-style:italic">Aucun avis dans cette catégorie.</td></tr>`;
      return;
    }
    reviewsRowsEl.innerHTML = allReviews.map(reviewRowHtml).join('');
  }

  function updateReviewFilterCounts(counts: { pending: number; approved: number; all: number }) {
    reviewsFiltersEl.querySelectorAll('.filter-pill').forEach((p) => {
      const status = (p as HTMLElement).dataset.status || '';
      const c = p.querySelector('.count');
      if (!c) return;
      if (status === '') c.textContent = String(counts.all);
      else if (status === 'pending') c.textContent = String(counts.pending);
      else if (status === 'approved') c.textContent = String(counts.approved);
    });
    if (counts.pending > 0) {
      revPendingBadge.textContent = String(counts.pending);
      revPendingBadge.hidden = false;
    } else {
      revPendingBadge.hidden = true;
    }
  }

  async function loadReviews(status?: string) {
    reviewsRowsEl.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:32px">Chargement…</td></tr>`;
    const res = status === 'pending'
      ? await adminListPendingReviews()
      : await adminListReviews({ status: status || undefined });
    if (!res.ok) {
      reviewsRowsEl.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escR(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    allReviews = res.reviews || [];
    renderReviewsTable();
    // Refresh counts by hitting all three lists in parallel — the pending
    // count drives the badge so we always want it fresh.
    const [pendingRes, approvedRes, allRes] = await Promise.all([
      adminListPendingReviews(),
      adminListReviews({ status: 'approved' }),
      adminListReviews(),
    ]);
    updateReviewFilterCounts({
      pending: pendingRes.ok ? (pendingRes.reviews || []).length : 0,
      approved: approvedRes.ok ? (approvedRes.reviews || []).length : 0,
      all: allRes.ok ? (allRes.reviews || []).length : 0,
    });
  }

  reviewsFiltersEl.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest('.filter-pill') as HTMLElement | null;
    if (!pill) return;
    reviewsFiltersEl.querySelectorAll('.filter-pill').forEach((p) => p.classList.remove('active'));
    pill.classList.add('active');
    currentReviewFilter = pill.dataset.status || '';
    loadReviews(currentReviewFilter);
  });

  function showRevStatus(msg: string, kind: 'success' | 'error' | '' = '') {
    reviewsStatusEl.textContent = msg;
    reviewsStatusEl.className = 'status-msg ' + (kind || '');
    reviewsStatusEl.classList.remove('hidden');
    setTimeout(() => reviewsStatusEl.classList.add('hidden'), 4000);
  }

  reviewsRowsEl.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const approveBtn = target.closest('.rev-approve') as HTMLElement | null;
    const rejectBtn = target.closest('.rev-reject') as HTMLElement | null;
    const deleteBtn = target.closest('.rev-delete') as HTMLElement | null;
    if (!approveBtn && !rejectBtn && !deleteBtn) return;
    const id = (approveBtn || rejectBtn || deleteBtn)!.dataset.id!;
    if (approveBtn) {
      const r = await adminApproveReview(id);
      if (!r.ok) { showRevStatus(r.error || 'Échec.', 'error'); return; }
      showRevStatus('✓ Avis approuvé.', 'success');
      loadReviews(currentReviewFilter);
    } else if (rejectBtn) {
      const r = await adminRejectReview(id);
      if (!r.ok) { showRevStatus(r.error || 'Échec.', 'error'); return; }
      showRevStatus('Avis rejeté.', 'success');
      loadReviews(currentReviewFilter);
    } else if (deleteBtn) {
      if (!confirm('Supprimer définitivement cet avis ?')) return;
      const r = await adminDeleteReview(id);
      if (!r.ok) { showRevStatus(r.error || 'Échec.', 'error'); return; }
      showRevStatus('Avis supprimé.', 'success');
      loadReviews(currentReviewFilter);
    }
  });

  const reviewsObserver = new MutationObserver(() => {
    if (!adminMain?.classList.contains('hidden')) {
      reviewsObserver.disconnect();
      loadReviews(currentReviewFilter);
    }
  });
  if (adminMain) reviewsObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  if (adminMain && !adminMain.classList.contains('hidden')) loadReviews(currentReviewFilter);

  // ============ PHASE 13: ADMINISTRATEURS + JOURNAL D'AUDIT ============
  const adminsRowsEl    = document.getElementById('adminsRows') as HTMLElement | null;
  const adminsStatusEl  = document.getElementById('adminsStatus') as HTMLElement | null;
  const adminsAddBtn    = document.getElementById('adminsAddBtn') as HTMLButtonElement | null;
  const promoteModal    = document.getElementById('promoteAdminModal') as HTMLElement | null;
  const promoteOverlay  = document.getElementById('promoteAdminOverlay') as HTMLElement | null;
  const promoteClose    = document.getElementById('promoteAdminClose') as HTMLButtonElement | null;
  const promoteCancel   = document.getElementById('promoteCancel') as HTMLButtonElement | null;
  const promoteForm     = document.getElementById('promoteAdminForm') as HTMLFormElement | null;
  const promotePhone    = document.getElementById('promotePhone') as HTMLInputElement | null;
  const promoteErr      = document.getElementById('promoteErr') as HTMLElement | null;
  const promoteSave     = document.getElementById('promoteSave') as HTMLButtonElement | null;
  const editAdminModal  = document.getElementById('editAdminModal') as HTMLElement | null;
  const editAdminOverlay = document.getElementById('editAdminOverlay') as HTMLElement | null;
  const editAdminClose  = document.getElementById('editAdminClose') as HTMLButtonElement | null;
  const editAdminCancel = document.getElementById('editAdminCancel') as HTMLButtonElement | null;
  const editAdminForm   = document.getElementById('editAdminForm') as HTMLFormElement | null;
  const editAdminSub    = document.getElementById('editAdminSub') as HTMLElement | null;
  const editAdminErr    = document.getElementById('editAdminErr') as HTMLElement | null;
  const editAdminSave   = document.getElementById('editAdminSave') as HTMLButtonElement | null;
  const logActionFilter = document.getElementById('logActionFilter') as HTMLInputElement | null;
  const logCustomerFilter = document.getElementById('logCustomerFilter') as HTMLInputElement | null;
  const logsRefreshBtn  = document.getElementById('logsRefreshBtn') as HTMLButtonElement | null;
  const logsRowsEl      = document.getElementById('logsRows') as HTMLElement | null;

  let editingAdminPhone: string = '';

  const PRESETS: Record<string, string[]> = {
    boutique: ['orders', 'loyalty'],
    marketing: ['articles', 'products'],
    manager: ['products', 'orders', 'customers', 'articles', 'reviews', 'loyalty', 'tiers', 'perfume-requests'],
    super: ['all'],
  };

  function escAdm(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;',
    })[c]!);
  }

  function permPills(perms: string[]) {
    if (!perms || !perms.length) return '<span style="color:var(--ink-mute);font-style:italic">aucune</span>';
    return perms.map((p) =>
      `<span class="perm-pill${p === 'all' ? ' all' : ''}">${escAdm(p)}</span>`
    ).join('');
  }

  function adminStatus(msg: string, kind: 'success'|'error'|'' = '') {
    if (!adminsStatusEl) return;
    adminsStatusEl.textContent = msg;
    adminsStatusEl.className = 'status-msg ' + (kind || '');
    adminsStatusEl.classList.remove('hidden');
    setTimeout(() => adminsStatusEl.classList.add('hidden'), 4000);
  }

  async function loadAdmins() {
    if (!adminsRowsEl) return;
    adminsRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px">Chargement…</td></tr>`;
    const res = await adminListAdmins();
    if (!res.ok) {
      adminsRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;color:#B23A1F;padding:24px">${escAdm(res.error || 'Erreur')}</td></tr>`;
      return;
    }
    const admins = res.admins || [];
    if (!admins.length) {
      adminsRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--ink-mute);font-style:italic;padding:24px">Aucun administrateur enregistré. Promouvez le premier ci-dessus.</td></tr>`;
      return;
    }
    adminsRowsEl.innerHTML = admins.map((a: any) => `
      <tr data-phone="${escAdm(a.phone)}">
        <td><strong>${escAdm(a.name || '—')}</strong></td>
        <td>${escAdm(a.phone)}</td>
        <td>${permPills(a.adminPermissions || [])}</td>
        <td class="art-date-cell">${escAdm(frenchRelativeDate(a.promotedAt))}</td>
        <td>${escAdm(a.promotedBy || '—')}</td>
        <td>
          <button type="button" class="link-btn" data-action="edit-perms" data-phone="${escAdm(a.phone)}" data-name="${escAdm(a.name || '')}" data-perms="${escAdm(JSON.stringify(a.adminPermissions || []))}">Modifier</button>
          <button type="button" class="link-btn danger" data-action="demote" data-phone="${escAdm(a.phone)}">Rétrograder</button>
        </td>
      </tr>
    `).join('');
  }

  adminsRowsEl?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLElement | null;
    if (!btn) return;
    const phone = btn.dataset.phone!;
    const action = btn.dataset.action!;
    if (action === 'edit-perms') {
      const perms = JSON.parse(btn.dataset.perms || '[]');
      openEditAdmin(phone, btn.dataset.name || '', perms);
    } else if (action === 'demote') {
      if (!confirm(`Rétrograder ${phone} ? Le client redeviendra "regular".`)) return;
      const res = await adminDemoteAdmin(phone);
      if (!res.ok) { adminStatus(res.error || 'Échec', 'error'); return; }
      adminStatus('✓ Rétrogradé', 'success');
      loadAdmins();
      loadLogs();
    }
  });

  // Promote modal
  function openPromote() {
    if (!promoteModal || !promoteForm) return;
    promoteForm.reset();
    if (promoteErr) promoteErr.classList.add('hidden');
    promoteModal.classList.remove('hidden');
    setTimeout(() => promotePhone?.focus(), 50);
  }
  function closePromote() { promoteModal?.classList.add('hidden'); }
  adminsAddBtn?.addEventListener('click', openPromote);
  promoteClose?.addEventListener('click', closePromote);
  promoteCancel?.addEventListener('click', closePromote);
  promoteOverlay?.addEventListener('click', closePromote);

  // 'all' checkbox disables (visually) the others. Worker enforces too.
  function bindAllToggle(formEl: HTMLElement, name: string) {
    const allCb = formEl.querySelector(`input[name="${name}"][value="all"]`) as HTMLInputElement | null;
    if (!allCb) return;
    const others = formEl.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:not([value="all"])`);
    const sync = () => {
      others.forEach((cb) => {
        cb.disabled = allCb.checked;
        if (allCb.checked) cb.checked = false;
      });
    };
    allCb.addEventListener('change', sync);
    sync();
  }
  if (promoteForm) bindAllToggle(promoteForm, 'perm');
  if (editAdminForm) bindAllToggle(editAdminForm, 'eperm');

  // Presets in the promote modal
  promoteForm?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-preset]') as HTMLElement | null;
    if (!btn) return;
    const preset = btn.dataset.preset!;
    const perms = PRESETS[preset] || [];
    const inputs = promoteForm.querySelectorAll<HTMLInputElement>('input[name="perm"]');
    inputs.forEach((cb) => { cb.checked = perms.includes(cb.value); });
    // Trigger the 'all' toggle in case 'all' was selected
    const allCb = promoteForm.querySelector('input[name="perm"][value="all"]') as HTMLInputElement | null;
    allCb?.dispatchEvent(new Event('change'));
  });

  promoteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!promotePhone || !promoteSave || !promoteErr) return;
    promoteErr.classList.add('hidden');
    const phone = promotePhone.value.trim();
    if (!phone) { promoteErr.textContent = 'Téléphone requis'; promoteErr.classList.remove('hidden'); return; }
    const perms = Array.from(promoteForm.querySelectorAll<HTMLInputElement>('input[name="perm"]:checked')).map((cb) => cb.value);
    if (!perms.length) { promoteErr.textContent = 'Sélectionnez au moins une permission'; promoteErr.classList.remove('hidden'); return; }
    promoteSave.disabled = true; promoteSave.textContent = 'Promotion…';
    const res = await adminPromoteAdmin(phone, perms);
    promoteSave.disabled = false; promoteSave.textContent = 'Promouvoir';
    if (!res.ok) {
      promoteErr.textContent = res.error || 'Échec';
      promoteErr.classList.remove('hidden');
      return;
    }
    closePromote();
    adminStatus('✓ Client promu administrateur', 'success');
    loadAdmins();
    loadLogs();
  });

  // Edit perms modal
  function openEditAdmin(phone: string, name: string, perms: string[]) {
    if (!editAdminModal || !editAdminForm) return;
    editingAdminPhone = phone;
    if (editAdminSub) editAdminSub.textContent = `${name || phone}`;
    editAdminErr?.classList.add('hidden');
    const inputs = editAdminForm.querySelectorAll<HTMLInputElement>('input[name="eperm"]');
    inputs.forEach((cb) => { cb.checked = perms.includes(cb.value); });
    // Refresh 'all' toggle state
    const allCb = editAdminForm.querySelector('input[name="eperm"][value="all"]') as HTMLInputElement | null;
    allCb?.dispatchEvent(new Event('change'));
    editAdminModal.classList.remove('hidden');
  }
  function closeEditAdmin() { editAdminModal?.classList.add('hidden'); editingAdminPhone = ''; }
  editAdminClose?.addEventListener('click', closeEditAdmin);
  editAdminCancel?.addEventListener('click', closeEditAdmin);
  editAdminOverlay?.addEventListener('click', closeEditAdmin);

  editAdminForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editingAdminPhone || !editAdminSave || !editAdminErr || !editAdminForm) return;
    editAdminErr.classList.add('hidden');
    const perms = Array.from(editAdminForm.querySelectorAll<HTMLInputElement>('input[name="eperm"]:checked')).map((cb) => cb.value);
    if (!perms.length) { editAdminErr.textContent = 'Sélectionnez au moins une permission'; editAdminErr.classList.remove('hidden'); return; }
    editAdminSave.disabled = true; editAdminSave.textContent = 'Enregistrement…';
    const res = await adminUpdateAdminPermissions(editingAdminPhone, perms);
    editAdminSave.disabled = false; editAdminSave.textContent = 'Enregistrer';
    if (!res.ok) {
      editAdminErr.textContent = res.error || 'Échec';
      editAdminErr.classList.remove('hidden');
      return;
    }
    closeEditAdmin();
    adminStatus('✓ Permissions mises à jour', 'success');
    loadAdmins();
    loadLogs();
  });

  // Logs
  async function loadLogs() {
    if (!logsRowsEl) return;
    logsRowsEl.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:24px">Chargement…</td></tr>`;
    const action = (logActionFilter?.value || '').trim();
    const customerId = (logCustomerFilter?.value || '').trim();
    const res = await adminListLogs({ page: 1, limit: 100, action, customerId });
    if (!res.ok) {
      logsRowsEl.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#B23A1F;padding:24px">${escAdm(res.error || 'Erreur')}</td></tr>`;
      return;
    }
    const logs = res.logs || [];
    if (!logs.length) {
      logsRowsEl.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--ink-mute);font-style:italic;padding:24px">Aucune action correspondante.</td></tr>`;
      return;
    }
    logsRowsEl.innerHTML = logs.map((l: any) => `
      <tr>
        <td>${escAdm((l.timestamp || '').replace('T',' ').substring(0, 19))}</td>
        <td>${escAdm(l.customerName || l.customerId || '—')}</td>
        <td><span class="log-action">${escAdm(l.action)}</span></td>
        <td class="log-details">${escAdm(JSON.stringify(l.details || {}))}</td>
        <td>${escAdm(l.ip || '—')}</td>
      </tr>
    `).join('');
  }
  logsRefreshBtn?.addEventListener('click', loadLogs);
  let logFilterDeb: any;
  [logActionFilter, logCustomerFilter].forEach((el) => {
    el?.addEventListener('input', () => {
      clearTimeout(logFilterDeb);
      logFilterDeb = setTimeout(loadLogs, 250);
    });
  });

  // Load admins + logs once the main panel becomes visible (or now if already visible).
  const adminsObserver = new MutationObserver(() => {
    if (!adminMain?.classList.contains('hidden')) {
      adminsObserver.disconnect();
      loadAdmins();
      loadLogs();
    }
  });
  if (adminMain) adminsObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  if (adminMain && !adminMain.classList.contains('hidden')) {
    loadAdmins();
    loadLogs();
  }

  // ============================================================
  // PHASE 4 — SALES (POS) tab controller
  // ============================================================
  const salesBlockEl = document.querySelector<HTMLElement>('.sales-block');
  const salesSubtabsEl = salesBlockEl?.querySelector<HTMLElement>('.sales-subtabs');
  const salesPanels = Array.from(salesBlockEl?.querySelectorAll<HTMLElement>('.sales-panel') || []);

  const fmtDT = (n) => {
    const v = Number(n) || 0;
    return v.toFixed(2).replace('.', ',') + ' DT';
  };
  const fmtHM = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const t = new Date(d.getTime() + 60 * 60 * 1000);
    return `${String(t.getUTCHours()).padStart(2, '0')}:${String(t.getUTCMinutes()).padStart(2, '0')}`;
  };
  const fmtDayKey = (d) => {
    const t = new Date(d.getTime() + 60 * 60 * 1000);
    return `${t.getUTCFullYear()}-${String(t.getUTCMonth() + 1).padStart(2, '0')}-${String(t.getUTCDate()).padStart(2, '0')}`;
  };
  const todayKey = () => fmtDayKey(new Date());
  const escSales = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]!));

  // ---------- Subtab switching ----------
  salesSubtabsEl?.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>('.sales-subtab');
    if (!t) return;
    const target = t.dataset.subtab;
    salesSubtabsEl.querySelectorAll('.sales-subtab').forEach((b) => b.classList.remove('is-active'));
    t.classList.add('is-active');
    salesPanels.forEach((p) => { p.hidden = p.dataset.panel !== target; });
    if (target === 'tickets' && !salesTicketsLoadedOnce) { loadSalesTickets(); salesTicketsLoadedOnce = true; }
    if (target === 'employees' && !salesEmployeesLoadedOnce) { loadEmployees(); salesEmployeesLoadedOnce = true; }
  });

  // ---------- Dashboard ----------
  const kpiTodayRevEl = document.getElementById('kpiTodayRev');
  const kpiTodayMetaEl = document.getElementById('kpiTodayMeta');
  const kpiMonthRevEl = document.getElementById('kpiMonthRev');
  const kpiMonthMetaEl = document.getElementById('kpiMonthMeta');
  const kpiTodayTicketsEl = document.getElementById('kpiTodayTickets');
  const kpiTodayAvgEl = document.getElementById('kpiTodayAvg');
  const kpi30AvgEl = document.getElementById('kpi30Avg');
  const chart30El = document.getElementById('chart30Days');
  const chartTopEl = document.getElementById('chartTopProducts');
  const chartEmpEl = document.getElementById('chartEmployees');
  const salesDashRefreshBtn = document.getElementById('salesDashRefresh');
  const salesDashStatusEl = document.getElementById('salesDashStatus');

  async function loadDashboard() {
    salesDashStatusEl?.classList.add('hidden');
    if (chart30El) chart30El.innerHTML = '<div class="sales-chart-empty">Chargement…</div>';
    if (chartTopEl) chartTopEl.innerHTML = '<div class="sales-chart-empty">Chargement…</div>';
    if (chartEmpEl) chartEmpEl.innerHTML = '<div class="sales-chart-empty">Chargement…</div>';

    // Build 30-day range ending today (Tunis).
    const today = new Date();
    const from30 = new Date(today.getTime() - 29 * 24 * 60 * 60 * 1000);
    const [statsToday, statsMonth, stats30] = await Promise.all([
      adminSalesStats({ period: 'today' }),
      adminSalesStats({ period: 'month' }),
      adminSalesStats({ period: 'custom', from: fmtDayKey(from30), to: fmtDayKey(today) }),
    ]);

    if (!statsToday.ok || !statsMonth.ok || !stats30.ok) {
      const err = statsToday.error || statsMonth.error || stats30.error || 'Erreur';
      if (salesDashStatusEl) {
        salesDashStatusEl.classList.remove('hidden');
        salesDashStatusEl.className = 'status-msg error';
        salesDashStatusEl.textContent = 'Erreur de chargement : ' + err;
      }
      return;
    }

    kpiTodayRevEl!.textContent = fmtDT(statsToday.revenue.total);
    kpiTodayMetaEl!.textContent = `${statsToday.revenue.ticketCount} ticket${statsToday.revenue.ticketCount > 1 ? 's' : ''}`;
    kpiTodayTicketsEl!.textContent = String(statsToday.revenue.ticketCount);
    kpiTodayAvgEl!.textContent = fmtDT(statsToday.revenue.avgTicket);

    kpiMonthRevEl!.textContent = fmtDT(statsMonth.revenue.total);
    const profit = statsMonth.comparison.profitEstimate;
    if (profit >= 0) {
      kpiMonthMetaEl!.className = 'sales-kpi-meta is-positive';
      kpiMonthMetaEl!.textContent = `+ ${fmtDT(profit)} après 1 660 DT de frais fixes`;
    } else {
      kpiMonthMetaEl!.className = 'sales-kpi-meta is-negative';
      kpiMonthMetaEl!.textContent = `${fmtDT(profit)} avant équilibre (1 660 DT)`;
    }

    const activeDays = stats30.byDay.filter((d) => d.revenue > 0).length || 1;
    kpi30AvgEl!.textContent = fmtDT(stats30.revenue.total / 30);

    // 30-day line chart (uses byDay).
    if (chart30El) {
      chart30El.innerHTML = renderLineChart(stats30.byDay) ||
        '<div class="sales-chart-empty">Aucune vente sur la période.</div>';
    }
    // Top products (month).
    if (chartTopEl) {
      chartTopEl.innerHTML = renderTopProducts(statsMonth.byProduct.slice(0, 10)) ||
        '<div class="sales-chart-empty">Aucune vente ce mois.</div>';
    }
    // Employees (month).
    if (chartEmpEl) {
      chartEmpEl.innerHTML = renderEmployeePie(statsMonth.byEmployee) ||
        '<div class="sales-chart-empty">Aucune vente ce mois.</div>';
    }
  }

  function renderLineChart(byDay) {
    if (!byDay || byDay.length === 0) return '';
    const W = 720, H = 220, PAD_L = 44, PAD_R = 16, PAD_T = 16, PAD_B = 28;
    const innerW = W - PAD_L - PAD_R;
    const innerH = H - PAD_T - PAD_B;
    const maxRev = Math.max(1, ...byDay.map((d) => d.revenue));
    const step = innerW / Math.max(1, byDay.length - 1);
    const pts = byDay.map((d, i) => ({
      x: PAD_L + i * step,
      y: PAD_T + innerH - (d.revenue / maxRev) * innerH,
      d,
    }));
    const pathD = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
    const areaD = `${pathD} L${pts[pts.length - 1].x.toFixed(1)},${(PAD_T + innerH).toFixed(1)} L${pts[0].x.toFixed(1)},${(PAD_T + innerH).toFixed(1)} Z`;
    // 4 horizontal grid lines.
    const gridSteps = 4;
    const gridLines: string[] = [];
    const gridLabels: string[] = [];
    for (let g = 0; g <= gridSteps; g++) {
      const y = PAD_T + (innerH * g / gridSteps);
      const val = maxRev * (1 - g / gridSteps);
      gridLines.push(`<line class="grid-line" x1="${PAD_L}" x2="${W - PAD_R}" y1="${y}" y2="${y}"/>`);
      gridLabels.push(`<text x="${PAD_L - 6}" y="${y + 3}" text-anchor="end">${Math.round(val)}</text>`);
    }
    // X labels: first, middle, last.
    const xLabels: string[] = [];
    const labelIdx = [0, Math.floor(byDay.length / 2), byDay.length - 1];
    labelIdx.forEach((i) => {
      if (i < byDay.length) {
        const p = pts[i];
        const parts = byDay[i].date.split('-');
        const label = `${parts[2]}/${parts[1]}`;
        xLabels.push(`<text x="${p.x}" y="${H - PAD_B + 16}" text-anchor="middle">${label}</text>`);
      }
    });
    // Dots only on the high points (top 3) to keep it clean.
    const sortedByRev = pts.slice().sort((a, b) => b.d.revenue - a.d.revenue).slice(0, 3).filter((p) => p.d.revenue > 0);
    const dots = sortedByRev.map((p) => `<circle class="dot" cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3.5"/>`).join('');
    return `
      <svg class="sales-line-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="Chiffre d'affaires sur 30 jours">
        <defs>
          <linearGradient id="salesLineGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0E3A1F" stop-opacity="0.35"/>
            <stop offset="1" stop-color="#0E3A1F" stop-opacity="0"/>
          </linearGradient>
        </defs>
        ${gridLines.join('')}
        ${gridLabels.join('')}
        <path class="area" d="${areaD}"/>
        <path class="line" d="${pathD}"/>
        ${dots}
        ${xLabels.join('')}
        <line class="axis" x1="${PAD_L}" x2="${W - PAD_R}" y1="${H - PAD_B}" y2="${H - PAD_B}"/>
        <line class="axis" x1="${PAD_L}" x2="${PAD_L}" y1="${PAD_T}" y2="${H - PAD_B}"/>
      </svg>
    `;
  }

  function renderTopProducts(items) {
    if (!items || items.length === 0) return '';
    const maxQty = Math.max(1, ...items.map((it) => it.qty));
    return items.map((it) => `
      <div class="sales-bar-row">
        <div class="name">${escSales(it.name)} <span style="color:var(--ink-mute);font-weight:400">· ${escSales(it.size)}</span></div>
        <div class="bar"><span style="width:${Math.round(it.qty / maxQty * 100)}%"></span></div>
        <div class="meta">${it.qty} · ${fmtDT(it.revenue)}</div>
      </div>
    `).join('');
  }

  function renderEmployeePie(employees) {
    if (!employees || employees.length === 0) return '';
    const total = employees.reduce((s, e) => s + e.revenue, 0);
    if (total <= 0) return '';
    // Brand palette + cycling complementary tones.
    const palette = ['#0E3A1F', '#D4AF37', '#A87C45', '#0E5C2F', '#C9A86B', '#3D6E4A'];
    const cx = 90, cy = 90, r = 80;
    let cum = 0;
    const slices = employees.map((e, i) => {
      const frac = e.revenue / total;
      const start = cum;
      cum += frac;
      const a0 = start * Math.PI * 2 - Math.PI / 2;
      const a1 = cum * Math.PI * 2 - Math.PI / 2;
      const large = frac > 0.5 ? 1 : 0;
      const x0 = cx + r * Math.cos(a0), y0 = cy + r * Math.sin(a0);
      const x1 = cx + r * Math.cos(a1), y1 = cy + r * Math.sin(a1);
      const color = palette[i % palette.length];
      // Edge case: single 100% slice → full circle path.
      const path = frac >= 0.999
        ? `M${cx - r},${cy} A${r},${r} 0 1,1 ${cx + r},${cy} A${r},${r} 0 1,1 ${cx - r},${cy} Z`
        : `M${cx},${cy} L${x0.toFixed(2)},${y0.toFixed(2)} A${r},${r} 0 ${large},1 ${x1.toFixed(2)},${y1.toFixed(2)} Z`;
      return { e, color, path, frac };
    });
    const paths = slices.map((s) => `<path d="${s.path}" fill="${s.color}" />`).join('');
    const legend = slices.map((s) => `
      <li>
        <span class="swatch" style="background:${s.color}"></span>
        <span>${escSales(s.e.name)}</span>
        <span>${(s.frac * 100).toFixed(0)}% · ${fmtDT(s.e.revenue)}</span>
      </li>
    `).join('');
    return `
      <div class="sales-pie-row">
        <svg class="sales-pie-svg" viewBox="0 0 180 180" role="img" aria-label="Répartition CA par employé">
          ${paths}
          <circle cx="${cx}" cy="${cy}" r="32" fill="var(--cream-soft)" />
          <text x="${cx}" y="${cy - 4}" text-anchor="middle" font-family="var(--font-display)" font-size="11" fill="var(--ink-mute)">Total</text>
          <text x="${cx}" y="${cy + 12}" text-anchor="middle" font-family="var(--font-display)" font-size="14" fill="var(--emerald)">${fmtDT(total)}</text>
        </svg>
        <div class="sales-pie-legend"><ul>${legend}</ul></div>
      </div>
    `;
  }

  salesDashRefreshBtn?.addEventListener('click', () => loadDashboard());

  // ---------- All sales table ----------
  let salesTicketsLoadedOnce = false;
  const salesFromEl = document.getElementById('salesFrom') as HTMLInputElement;
  const salesToEl = document.getElementById('salesTo') as HTMLInputElement;
  const salesEmployeeFilterEl = document.getElementById('salesEmployeeFilter') as HTMLSelectElement;
  const salesStatusFilterEl = document.getElementById('salesStatusFilter') as HTMLSelectElement;
  const salesApplyFiltersBtn = document.getElementById('salesApplyFilters');
  const salesRowsEl = document.getElementById('salesRows') as HTMLElement;
  const salesTicketsStatusEl = document.getElementById('salesTicketsStatus') as HTMLElement;
  const sumRevEl = document.getElementById('sumRev');
  const sumTicketsEl = document.getElementById('sumTickets');
  const sumAvgEl = document.getElementById('sumAvg');

  let cachedSales: any[] = [];

  function defaultRange() {
    const today = new Date();
    const start = new Date(today.getTime() - 29 * 24 * 60 * 60 * 1000);
    return { from: fmtDayKey(start), to: fmtDayKey(today) };
  }
  function initTicketFilters() {
    const r = defaultRange();
    if (salesFromEl && !salesFromEl.value) salesFromEl.value = r.from;
    if (salesToEl && !salesToEl.value) salesToEl.value = r.to;
  }
  async function loadSalesTickets() {
    initTicketFilters();
    salesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>`;
    salesTicketsStatusEl?.classList.add('hidden');
    const res = await adminListSales({
      from: salesFromEl.value || undefined,
      to: salesToEl.value || undefined,
      employeeCode: salesEmployeeFilterEl.value || undefined,
      status: salesStatusFilterEl.value || undefined,
      limit: 200,
    });
    if (!res.ok) {
      salesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escSales(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    cachedSales = res.sales || [];
    sumRevEl!.textContent = fmtDT(res.summary?.revenue ?? 0);
    sumTicketsEl!.textContent = String(res.summary?.ticketCount ?? 0);
    sumAvgEl!.textContent = fmtDT(res.summary?.avgTicket ?? 0);
    if (cachedSales.length === 0) {
      salesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--ink-mute)">Aucune vente sur la période.</td></tr>`;
      return;
    }
    salesRowsEl.innerHTML = cachedSales.map(saleRowHtml).join('');
  }

  function summarizeItems(items) {
    if (!items || items.length === 0) return '—';
    const parts = items.slice(0, 2).map((it) => `${it.qty}× ${it.name} (${it.size})`);
    if (items.length > 2) parts.push(`+${items.length - 2}`);
    return parts.join(', ');
  }
  function saleRowHtml(s) {
    const cancelled = s.status === 'cancelled';
    const dateStr = s.createdAt ? `${s.createdAt.substring(0, 10)} · ${fmtHM(s.createdAt)}` : '';
    return `
      <tr data-sale="${escSales(s.id)}" ${cancelled ? 'style="opacity:0.6"' : ''}>
        <td style="white-space:nowrap;font-size:12px">${escSales(dateStr)}</td>
        <td>${escSales(s.createdByName || s.createdBy || '—')}</td>
        <td style="font-size:13px;color:var(--ink-soft)">${escSales(summarizeItems(s.items))}</td>
        <td style="white-space:nowrap;font-weight:600;color:var(--emerald)">${fmtDT(s.total)}</td>
        <td><span class="status-pill ${cancelled ? 'cancelled' : 'active'}">${cancelled ? 'Annulée' : 'Active'}</span></td>
        <td><button type="button" class="link-btn" data-sale="${escSales(s.id)}" data-act="open">Voir</button></td>
      </tr>
    `;
  }

  salesApplyFiltersBtn?.addEventListener('click', () => loadSalesTickets());

  salesRowsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-sale]');
    if (!btn) return;
    const sale = cachedSales.find((s) => s.id === btn.dataset.sale);
    if (sale) openSaleModal(sale);
  });

  // ---------- Sale modal (admin edit/cancel) ----------
  const saleModalEl = document.getElementById('saleModal');
  const saleModalOverlayEl = document.getElementById('saleModalOverlay');
  const saleModalCloseEl = document.getElementById('saleModalClose');
  const saleModalDismissBtn = document.getElementById('saleModalDismiss');
  const saleModalSaveBtn = document.getElementById('saleModalSave') as HTMLButtonElement;
  const saleModalCancelSaleBtn = document.getElementById('saleModalCancelSale') as HTMLButtonElement;
  const saleModalTitleEl = document.getElementById('saleModalTitle');
  const saleModalMetaEl = document.getElementById('saleModalMeta');
  const saleModalItemsEl = document.getElementById('saleModalItems');
  const saleModalTotalEl = document.getElementById('saleModalTotal');
  const saleModalStatusEl = document.getElementById('saleModalStatus') as HTMLElement;

  let editingSale: any = null;
  let editingTicket: Map<string, any> = new Map();

  function openSaleModal(sale) {
    editingSale = sale;
    editingTicket = new Map();
    (sale.items || []).forEach((it) => {
      editingTicket.set(`${it.slug}__${it.size}`, { ...it });
    });
    saleModalTitleEl!.textContent = `Ticket ${sale.id.slice(0, 8)}`;
    const cancelled = sale.status === 'cancelled';
    const metaParts: string[] = [];
    metaParts.push(`<strong>${escSales(sale.createdByName || sale.createdBy)}</strong>`);
    metaParts.push(escSales(`${sale.createdAt.substring(0, 10)} ${fmtHM(sale.createdAt)}`));
    if (sale.customerName) metaParts.push(`Client : ${escSales(sale.customerName)} (${escSales(sale.customerPhone)})`);
    if (sale.modifiedAt) metaParts.push(`Modifié ${fmtHM(sale.modifiedAt)}${sale.adminModified ? ' (admin)' : ''}`);
    if (cancelled) metaParts.push(`<span style="color:#8a2a14">Annulée — ${escSales(sale.cancelReason || 'sans raison')}</span>`);
    saleModalMetaEl!.innerHTML = metaParts.join(' · ');
    saleModalCancelSaleBtn.disabled = cancelled;
    saleModalSaveBtn.disabled = cancelled;
    saleModalStatusEl.classList.add('hidden');
    renderSaleModalItems();
    saleModalEl?.classList.remove('hidden');
  }
  function closeSaleModal() {
    saleModalEl?.classList.add('hidden');
    editingSale = null;
    editingTicket.clear();
  }
  function renderSaleModalItems() {
    if (editingTicket.size === 0) {
      saleModalItemsEl!.innerHTML = '<li style="text-align:center;color:var(--ink-mute);font-style:italic">Aucun article (sera refusé par le worker).</li>';
    } else {
      const rows: string[] = [];
      editingTicket.forEach((it, key) => {
        rows.push(`
          <li>
            <div>
              <div style="font-size:14px">${escSales(it.name)}</div>
              <div style="font-size:12px;color:var(--ink-mute);margin-top:2px">${escSales(it.size)} · ${fmtDT(it.price)}</div>
            </div>
            <div class="pos-ticket-item-controls">
              <button type="button" class="pos-qty-btn" data-act="dec" data-key="${escSales(key)}">−</button>
              <span class="pos-qty-val">${it.qty}</span>
              <button type="button" class="pos-qty-btn" data-act="inc" data-key="${escSales(key)}">+</button>
            </div>
          </li>
        `);
      });
      saleModalItemsEl!.innerHTML = rows.join('');
    }
    let total = 0;
    editingTicket.forEach((it) => { total += it.qty * it.price; });
    saleModalTotalEl!.textContent = fmtDT(total);
  }
  saleModalItemsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pos-qty-btn');
    if (!btn) return;
    const key = btn.dataset.key!;
    const it = editingTicket.get(key);
    if (!it) return;
    if (btn.dataset.act === 'inc') it.qty += 1;
    else if (btn.dataset.act === 'dec') {
      it.qty -= 1;
      if (it.qty <= 0) editingTicket.delete(key);
    }
    renderSaleModalItems();
  });
  saleModalCloseEl?.addEventListener('click', closeSaleModal);
  saleModalOverlayEl?.addEventListener('click', closeSaleModal);
  saleModalDismissBtn?.addEventListener('click', closeSaleModal);

  saleModalSaveBtn?.addEventListener('click', async () => {
    if (!editingSale || editingTicket.size === 0) return;
    saleModalSaveBtn.disabled = true;
    const items: any[] = [];
    let total = 0;
    editingTicket.forEach((it) => {
      items.push({ slug: it.slug, name: it.name, size: it.size, qty: it.qty, price: it.price });
      total += it.qty * it.price;
    });
    total = Math.round(total * 100) / 100;
    const res = await adminModifySale(editingSale.id, { items, total });
    if (!res.ok) {
      saleModalStatusEl.className = 'status-msg error';
      saleModalStatusEl.classList.remove('hidden');
      saleModalStatusEl.textContent = res.error || 'Échec';
      saleModalSaveBtn.disabled = false;
      return;
    }
    closeSaleModal();
    await loadSalesTickets();
  });

  saleModalCancelSaleBtn?.addEventListener('click', async () => {
    if (!editingSale) return;
    const reason = prompt('Raison de l\'annulation (optionnel) :', '') || '';
    if (!confirm('Confirmer l\'annulation de cette vente ?')) return;
    saleModalCancelSaleBtn.disabled = true;
    const res = await adminCancelSale(editingSale.id, reason);
    if (!res.ok) {
      saleModalStatusEl.className = 'status-msg error';
      saleModalStatusEl.classList.remove('hidden');
      saleModalStatusEl.textContent = res.error || 'Échec';
      saleModalCancelSaleBtn.disabled = false;
      return;
    }
    closeSaleModal();
    await loadSalesTickets();
  });

  // ---------- Employees ----------
  let salesEmployeesLoadedOnce = false;
  const employeesRowsEl = document.getElementById('employeesRows') as HTMLElement;
  const employeesStatusEl = document.getElementById('employeesStatus') as HTMLElement;
  const addEmployeeBtn = document.getElementById('salesAddEmployeeBtn');

  let cachedEmployees: any[] = [];

  async function loadEmployees() {
    employeesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px">Chargement…</td></tr>`;
    employeesStatusEl?.classList.add('hidden');
    const res = await adminListEmployees();
    if (!res.ok) {
      employeesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:#B23A1F">Erreur : ${escSales(res.error || 'chargement impossible')}</td></tr>`;
      return;
    }
    cachedEmployees = res.employees || [];
    // Populate the employee filter dropdown on the tickets tab so the
    // filter list stays in sync without a second fetch.
    if (salesEmployeeFilterEl) {
      const cur = salesEmployeeFilterEl.value;
      salesEmployeeFilterEl.innerHTML = '<option value="">Tous</option>' +
        cachedEmployees.map((e) => `<option value="${escSales(e.code)}">${escSales(e.name)} (${escSales(e.code)})</option>`).join('');
      salesEmployeeFilterEl.value = cur;
    }
    if (cachedEmployees.length === 0) {
      employeesRowsEl.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--ink-mute)">Aucun employé. Cliquez sur '+ Ajouter'.</td></tr>`;
      return;
    }
    employeesRowsEl.innerHTML = cachedEmployees.map(employeeRowHtml).join('');
  }

  function employeeRowHtml(e) {
    return `
      <tr data-emp="${escSales(e.code)}">
        <td style="font-family:var(--font-display);font-size:16px">${escSales(e.code)}</td>
        <td>${escSales(e.name)}</td>
        <td><span class="${e.active ? 'status-active' : 'status-inactive'}">${e.active ? '● Actif' : '○ Inactif'}</span></td>
        <td>${e.salesCount}</td>
        <td style="font-size:12px;color:var(--ink-mute)">${e.createdAt ? e.createdAt.substring(0, 10) : '—'}</td>
        <td>
          <button type="button" class="link-btn" data-emp="${escSales(e.code)}" data-act="edit">Modifier</button>
          <button type="button" class="link-btn danger" data-emp="${escSales(e.code)}" data-act="delete">Supprimer</button>
        </td>
      </tr>
    `;
  }

  // Employee modal
  const employeeModalEl = document.getElementById('employeeModal');
  const employeeModalOverlayEl = document.getElementById('employeeModalOverlay');
  const employeeModalCloseEl = document.getElementById('employeeModalClose');
  const employeeFormEl = document.getElementById('employeeForm') as HTMLFormElement;
  const empNameEl = document.getElementById('empName') as HTMLInputElement;
  const empCodeEl = document.getElementById('empCode') as HTMLInputElement;
  const empActiveEl = document.getElementById('empActive') as HTMLInputElement;
  const empCodeFieldEl = document.getElementById('empCodeField');
  const empActiveFieldEl = document.getElementById('empActiveField');
  const employeeStatusEl = document.getElementById('employeeStatus') as HTMLElement;
  const employeeCancelBtn = document.getElementById('employeeCancel');
  const employeeModalTitleEl = document.getElementById('employeeModalTitle');
  let editingEmployeeCode: string | null = null;

  function openEmployeeModal(emp?: any) {
    employeeStatusEl.classList.add('hidden');
    employeeFormEl.reset();
    if (emp) {
      editingEmployeeCode = emp.code;
      employeeModalTitleEl!.textContent = 'Modifier l\'employé';
      empNameEl.value = emp.name;
      empCodeEl.value = emp.code;
      empCodeFieldEl!.hidden = true;          // code immuable
      empActiveFieldEl!.hidden = false;
      empActiveEl.checked = emp.active;
    } else {
      editingEmployeeCode = null;
      employeeModalTitleEl!.textContent = 'Ajouter un employé';
      empCodeFieldEl!.hidden = false;
      empActiveFieldEl!.hidden = true;
    }
    employeeModalEl?.classList.remove('hidden');
    setTimeout(() => empNameEl.focus(), 50);
  }
  function closeEmployeeModal() {
    employeeModalEl?.classList.add('hidden');
    editingEmployeeCode = null;
  }
  employeeModalCloseEl?.addEventListener('click', closeEmployeeModal);
  employeeModalOverlayEl?.addEventListener('click', closeEmployeeModal);
  employeeCancelBtn?.addEventListener('click', closeEmployeeModal);
  addEmployeeBtn?.addEventListener('click', () => openEmployeeModal());

  employeeFormEl?.addEventListener('submit', async (e) => {
    e.preventDefault();
    employeeStatusEl.classList.add('hidden');
    const name = empNameEl.value.trim();
    if (!name) {
      employeeStatusEl.className = 'status-msg error';
      employeeStatusEl.classList.remove('hidden');
      employeeStatusEl.textContent = 'Nom requis';
      return;
    }
    let res;
    if (editingEmployeeCode) {
      res = await adminUpdateEmployee(editingEmployeeCode, { name, active: empActiveEl.checked });
    } else {
      const code = empCodeEl.value.trim();
      if (!/^\d{4}$/.test(code)) {
        employeeStatusEl.className = 'status-msg error';
        employeeStatusEl.classList.remove('hidden');
        employeeStatusEl.textContent = 'Le code doit être exactement 4 chiffres';
        return;
      }
      res = await adminCreateEmployee(code, name);
    }
    if (!res.ok) {
      employeeStatusEl.className = 'status-msg error';
      employeeStatusEl.classList.remove('hidden');
      employeeStatusEl.textContent = res.error || 'Échec';
      return;
    }
    closeEmployeeModal();
    await loadEmployees();
  });

  employeesRowsEl?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-emp]');
    if (!btn) return;
    const code = btn.dataset.emp!;
    const emp = cachedEmployees.find((x) => x.code === code);
    if (!emp) return;
    if (btn.dataset.act === 'edit') {
      openEmployeeModal(emp);
    } else if (btn.dataset.act === 'delete') {
      if (!confirm(`Supprimer l'employé ${emp.name} (${emp.code}) ?`)) return;
      const res = await adminDeleteEmployee(code);
      if (!res.ok) {
        alert(res.error || 'Échec');
        return;
      }
      await loadEmployees();
    }
  });

  // ---------- Sales tab auto-load when admin panel opens ----------
  const salesObserver = new MutationObserver(() => {
    if (adminMain && !adminMain.classList.contains('hidden') && salesBlockEl && !salesBlockEl.hasAttribute('hidden')) {
      // Only load once per page life — refresh button handles updates.
      if (!(salesBlockEl as any)._loaded) {
        (salesBlockEl as any)._loaded = true;
        loadDashboard();
        loadEmployees(); // pre-fill the employee filter dropdown
      }
    }
  });
  if (adminMain) salesObserver.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  if (adminMain && !adminMain.classList.contains('hidden') && salesBlockEl && !salesBlockEl.hasAttribute('hidden')) {
    (salesBlockEl as any)._loaded = true;
    loadDashboard();
    loadEmployees();
  }

  // ============================================================
  // REFONTE — SHELL CONTROLLER (Slice 1)
  //   Nav switching (sidebar + drawer + bottom-nav), URL hash sync,
  //   drawer open/close, user menu, Ctrl+K search modal.
  //
  //   Permission filtering is handled by the auto-login script
  //   above — it sets [hidden] on blocks the admin can't access.
  //   This controller computes which SECTIONS still have visible
  //   blocks and disables empty nav items.
  // ============================================================

  const SECTION_META: Record<string, { eyebrow: string; title: string; help: string }> = {
    accueil:   { eyebrow: 'Administration', title: 'Tableau de bord',     help: 'Vue d\'ensemble de l\'activité.' },
    ventes:    { eyebrow: 'Ventes',         title: 'Ventes',              help: 'Commandes en ligne et tickets boutique.' },
    catalogue: { eyebrow: 'Catalogue',      title: 'Produits',            help: 'Gestion du catalogue de parfums.' },
    clients:   { eyebrow: 'Clientèle',      title: 'Clients',             help: 'Comptes, tiers VIP/Reseller, fidélité, demandes.' },
    contenu:   { eyebrow: 'Contenu',        title: 'Contenu',             help: 'Blog et modération des avis.' },
    equipe:    { eyebrow: 'Administration', title: 'Équipe & réglages',   help: 'Administrateurs, employés boutique, journal d\'audit.' },
  };
  const VALID_SECTIONS = Object.keys(SECTION_META);

  const shellEl = document.getElementById('adminMain') as HTMLElement | null;
  const sectionTitleEl = document.getElementById('sectionTitle');
  const sectionEyebrowEl = document.getElementById('sectionEyebrow');
  const sectionHelpEl = document.getElementById('sectionHelp');
  const countLineEl = document.getElementById('countLine');
  const sectionEmptyEl = document.getElementById('adminSectionEmpty');
  const drawerEl = document.getElementById('adminDrawer');
  const drawerBackdropEl = document.getElementById('adminDrawerBackdrop');
  const drawerCloseEl = document.getElementById('adminDrawerClose');
  const burgerEl = document.getElementById('adminBurger');
  const moreBtnEl = document.getElementById('adminMoreBtn');
  const userBtnEl = document.getElementById('adminUserBtn');
  const userMenuEl = document.getElementById('adminUserMenu');
  const userAvatarEl = document.getElementById('adminUserAvatar');
  const userNameEl = document.getElementById('adminUserName');

  function currentSection(): string {
    const h = (window.location.hash || '').replace('#', '').trim();
    return VALID_SECTIONS.includes(h) ? h : 'accueil';
  }

  function hasVisibleBlock(section: string): boolean {
    if (section === 'accueil') return true;
    const blocks = document.querySelectorAll<HTMLElement>(`.admin-block[data-section="${section}"]`);
    for (const b of blocks) {
      if (!b.hasAttribute('hidden')) return true;
    }
    return false;
  }

  function refreshNavAvailability() {
    // Disable nav items whose section has no permission-allowed block.
    document.querySelectorAll<HTMLElement>('[data-nav-section]').forEach((el) => {
      const sect = el.getAttribute('data-nav-section') || '';
      if (hasVisibleBlock(sect)) {
        el.classList.remove('is-disabled');
        el.removeAttribute('aria-disabled');
      } else {
        el.classList.add('is-disabled');
        el.setAttribute('aria-disabled', 'true');
      }
    });
  }

  function setActiveSection(section: string, options: { fromHashEvent?: boolean } = {}) {
    if (!VALID_SECTIONS.includes(section)) section = 'accueil';
    // If user clicked a disabled section, fall back to accueil silently.
    const navItem = document.querySelector<HTMLElement>(`[data-nav-section="${section}"]`);
    if (navItem && navItem.classList.contains('is-disabled')) section = 'accueil';

    shellEl?.setAttribute('data-active-section', section);

    // Section title + helper text
    const meta = SECTION_META[section];
    if (meta) {
      sectionTitleEl && (sectionTitleEl.textContent = meta.title);
      sectionEyebrowEl && (sectionEyebrowEl.textContent = meta.eyebrow);
      sectionHelpEl && (sectionHelpEl.textContent = meta.help);
    }
    // countLine is products-specific
    if (countLineEl) countLineEl.hidden = (section !== 'catalogue');

    // Sync URL hash without firing another hashchange
    if (!options.fromHashEvent) {
      const target = '#' + section;
      if (window.location.hash !== target) {
        history.replaceState(null, '', target);
      }
    }

    // Mark all nav items
    document.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => {
      if (el.getAttribute('data-nav') === section) el.classList.add('is-active');
      else el.classList.remove('is-active');
    });

    // Empty-state if the section has zero visible blocks
    if (sectionEmptyEl) {
      const empty = section !== 'accueil' && !hasVisibleBlock(section);
      (sectionEmptyEl as HTMLElement).hidden = !empty;
    }

    // Scroll back to top on section change
    window.scrollTo({ top: 0, behavior: 'auto' });
  }

  // Event delegation: any [data-nav] anchor/button switches the section.
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-nav]');
    if (!t) return;
    const sect = t.getAttribute('data-nav') || '';
    if (sect === 'more') {
      // Mobile "Plus" button — open the drawer to expose Contenu + Équipe.
      e.preventDefault();
      openDrawer();
      return;
    }
    if (t.classList.contains('is-disabled')) {
      e.preventDefault();
      return;
    }
    if (VALID_SECTIONS.includes(sect)) {
      e.preventDefault();
      setActiveSection(sect);
      closeDrawer();
    }
  });

  // Hash change (back/forward buttons)
  window.addEventListener('hashchange', () => setActiveSection(currentSection(), { fromHashEvent: true }));

  // ============ Drawer ============
  function openDrawer() {
    drawerEl?.classList.add('is-open');
    drawerBackdropEl?.classList.add('is-open');
    burgerEl?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('no-scroll');
    setTimeout(() => drawerCloseEl?.focus(), 50);
  }
  function closeDrawer() {
    drawerEl?.classList.remove('is-open');
    drawerBackdropEl?.classList.remove('is-open');
    burgerEl?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('no-scroll');
  }
  burgerEl?.addEventListener('click', openDrawer);
  drawerCloseEl?.addEventListener('click', closeDrawer);
  drawerBackdropEl?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawerEl?.classList.contains('is-open')) closeDrawer();
  });

  // ============ User menu ============
  function toggleUserMenu(force?: boolean) {
    const showing = userMenuEl && !userMenuEl.hidden;
    const want = force !== undefined ? force : !showing;
    if (userMenuEl) (userMenuEl as HTMLElement).hidden = !want;
    userBtnEl?.setAttribute('aria-expanded', want ? 'true' : 'false');
  }
  userBtnEl?.addEventListener('click', (e) => { e.stopPropagation(); toggleUserMenu(); });
  document.addEventListener('click', (e) => {
    if (!userMenuEl || userMenuEl.hidden) return;
    const t = e.target as HTMLElement;
    if (!t.closest('#adminUserBtn') && !t.closest('#adminUserMenu')) toggleUserMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && userMenuEl && !userMenuEl.hidden) toggleUserMenu(false);
  });

  // Fill avatar + name when adminMe resolves. Re-uses the result from
  // the auto-login script by polling for the document.cookie /
  // sessionStorage state — simplest: read the user object after a brief
  // delay so the auto-login script has populated localStorage.
  async function fillUserBadge() {
    if (!userAvatarEl || !userNameEl) return;
    try {
      const { adminMe } = await import('../scripts/adminApi.js');
      const res = await adminMe();
      if (res && res.ok && res.customer) {
        const name = res.customer.name || res.customer.phone || 'Admin';
        userNameEl.textContent = name.length > 18 ? name.slice(0, 16) + '…' : name;
        const initial = (name.match(/[A-Za-zÀ-ÖØ-öø-ÿ]/) || ['A'])[0].toUpperCase();
        userAvatarEl.textContent = initial;
      } else if (res && res.isEmergency) {
        userNameEl.textContent = 'Urgence';
        userAvatarEl.textContent = '!';
      }
    } catch {}
  }

  // ============ Ctrl+K search modal ============
  const searchBtnEl = document.getElementById('adminSearchBtn');
  const searchModalEl = document.getElementById('adminSearchModal');
  const searchOverlayEl = document.getElementById('adminSearchOverlay');
  const searchCloseEl = document.getElementById('adminSearchClose');
  const searchInputEl = document.getElementById('adminSearchInput') as HTMLInputElement | null;
  const searchResultsEl = document.getElementById('adminSearchResults');

  function openSearch() {
    if (!searchModalEl) return;
    (searchModalEl as HTMLElement).hidden = false;
    document.body.classList.add('no-scroll');
    setTimeout(() => searchInputEl?.focus(), 50);
  }
  function closeSearch() {
    if (!searchModalEl) return;
    (searchModalEl as HTMLElement).hidden = true;
    document.body.classList.remove('no-scroll');
    if (searchInputEl) searchInputEl.value = '';
    if (searchResultsEl) {
      searchResultsEl.innerHTML = `
        <div class="search-modal-hint">
          Commencez à taper pour rechercher.<br>
          <span style="opacity:0.7">Astuce : <kbd>⌘K</kbd> ou <kbd>Ctrl+K</kbd> ouvre cette modal partout dans l'admin.</span>
        </div>`;
    }
  }
  searchBtnEl?.addEventListener('click', openSearch);
  searchOverlayEl?.addEventListener('click', closeSearch);
  searchCloseEl?.addEventListener('click', closeSearch);
  document.addEventListener('keydown', (e) => {
    const isOpenable = adminMain && !adminMain.classList.contains('hidden');
    if (!isOpenable) return;
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      if (searchModalEl && (searchModalEl as HTMLElement).hidden) openSearch();
      else closeSearch();
    } else if (e.key === 'Escape' && searchModalEl && !(searchModalEl as HTMLElement).hidden) {
      closeSearch();
    }
  });

  // Minimal Slice-1 search: in-memory products by name / inspiredBy.
  // Slice 2 will add customers, orders, articles.
  let searchTimer: any = null;
  searchInputEl?.addEventListener('input', () => {
    if (searchTimer) clearTimeout(searchTimer);
    searchTimer = setTimeout(runSearch, 180);
  });
  function escSearch(s: any) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]!));
  }
  function highlight(text: string, q: string) {
    const idx = text.toLowerCase().indexOf(q.toLowerCase());
    if (idx < 0) return escSearch(text);
    return escSearch(text.slice(0, idx)) +
      '<mark style="background:rgba(212,175,55,0.3);color:inherit">' +
      escSearch(text.slice(idx, idx + q.length)) + '</mark>' +
      escSearch(text.slice(idx + q.length));
  }
  function runSearch() {
    if (!searchInputEl || !searchResultsEl) return;
    const q = searchInputEl.value.trim();
    if (q.length < 2) {
      searchResultsEl.innerHTML = `<div class="search-modal-hint">Tapez au moins 2 caractères…</div>`;
      return;
    }
    // 'products' is the in-memory state loaded by loadProducts() in the
    // catalogue block. May be empty if loadProducts() hasn't fired yet.
    const list = (typeof products !== 'undefined' ? products : []) as any[];
    const ql = q.toLowerCase();
    const matches = list.filter((p) => {
      const hay = `${p.name || ''} ${p.inspiredBy || ''}`.toLowerCase();
      return hay.includes(ql);
    }).slice(0, 8);

    if (matches.length === 0) {
      searchResultsEl.innerHTML = `
        <div class="search-modal-group">Produits</div>
        <div class="search-modal-hint" style="text-align:left;padding:14px 12px">Aucun produit trouvé.</div>
      `;
      return;
    }
    searchResultsEl.innerHTML = `
      <div class="search-modal-group">Produits (${matches.length})</div>
      ${matches.map((p) => `
        <a class="search-modal-result" href="#catalogue" data-slug="${escSearch(p.slug)}">
          <span style="font-size:18px">📦</span>
          <span>${highlight(p.name || '—', q)}${p.inspiredBy ? `<br><small style="color:var(--admin-ink-mute)">inspiré de ${escSearch(p.inspiredBy)}</small>` : ''}</span>
          <span class="search-modal-result-meta">Catalogue</span>
        </a>
      `).join('')}
    `;
    searchResultsEl.querySelectorAll<HTMLAnchorElement>('.search-modal-result').forEach((a) => {
      a.addEventListener('click', () => closeSearch());
    });
  }

  // ============ Boot ============
  // Wait until auto-login finishes filtering blocks by permission (it
  // runs the moment adminMain loses .hidden). We observe class change.
  function bootShell() {
    refreshNavAvailability();
    setActiveSection(currentSection());
    fillUserBadge();
  }
  if (adminMain && !adminMain.classList.contains('hidden')) {
    bootShell();
  } else if (adminMain) {
    const shellBootObs = new MutationObserver(() => {
      if (!adminMain.classList.contains('hidden')) {
        shellBootObs.disconnect();
        // Defer 50ms so the auto-login permission filter has finished
        // toggling [hidden] on blocks before we read it.
        setTimeout(bootShell, 50);
      }
    });
    shellBootObs.observe(adminMain, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<!-- Seed data for first load when KV is empty -->
<script id="__seed" type="application/json" set:html={JSON.stringify(seedProducts)}></script>
