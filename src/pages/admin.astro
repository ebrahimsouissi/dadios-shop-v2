    letter-spacing: 0.08em;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .tab-btn.active { background: var(--emerald); color: var(--cream); border-color: var(--emerald); }

  .admin-table {
    width: 100%;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }
  .admin-table th {
    background: var(--cream-warm);
    text-align: left;
    padding: 12px 16px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .admin-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .admin-table tr:last-child td { border-bottom: none; }
  .admin-table tr:hover { background: var(--cream); }
  .muted { color: var(--ink-mute); font-style: italic; font-size: 13px; }
  .cap { text-transform: capitalize; }
  .tag {
    background: var(--cream-warm);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
