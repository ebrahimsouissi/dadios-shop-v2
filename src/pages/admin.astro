    cursor: pointer;
    border-radius: 8px;
  }
  .admin-drawer-close:active { background: rgba(250, 246, 240, 0.1); }
  .admin-drawer-nav { display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 1024px) {
    .admin-drawer-backdrop, .admin-drawer { display: none !important; }
  }

  /* ============ MOBILE BOTTOM NAV ============ */
  .admin-bottomnav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--admin-paper);
    border-top: 1px solid var(--admin-border);
