  .status-msg.error { background: rgba(178, 58, 31, 0.08); border-color: #B23A1F; color: #B23A1F; }

  /* ====== MODAL ====== */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 26, 14, 0.72);
    backdrop-filter: blur(4px);
  }
  .modal-box {
    position: relative;
    background: var(--cream);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    width: 100%;
    max-width: 760px;
    max-height: 92vh;
    overflow-y: auto;
    padding: 36px 40px 32px;
  }
  .modal-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: var(--ink-mute);
    line-height: 1;
  }
  .modal-box h2 { font-size: 28px; margin: 6px 0 24px; }

  /* form */
  #prodForm label { display: block; margin-bottom: 18px; }
  #prodForm label > span,
  #prodForm .lbl {
    display: block;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  #prodForm input[type="text"],
  #prodForm input[type="password"],
  #prodForm select,
  #prodForm textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream-soft);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
  }
  #prodForm input:focus, #prodForm select:focus, #prodForm textarea:focus {
    outline: none; border-color: var(--emerald);
  }
  #prodForm small {
    display: block;
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 4px;
    line-height: 1.5;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card-block {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    margin: 8px 0 18px;
  }
  .card-block strong {
    display: block;
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--emerald);
    margin-bottom: 4px;
  }
  .check-row { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 6px; }
  .check-item {
    margin-bottom: 0 !important;
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink);
