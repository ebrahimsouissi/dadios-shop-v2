---
import Base from '../layouts/Base.astro';
import data from '../data/products.json';
const seedProducts = data.products;
const sizes = data.sizes;
---
<Base
  title="Administration — Dadios Fragrance"
  description="Espace administration"
>

<!-- ============ NOT-ADMIN EMPTY STATE (Phase 13) ============ -->
<!-- Shown when a customer is logged in but has no admin tier — better
     than dropping them back at the password gate. -->
<section id="notAdminGate" class="login-gate" hidden>
  <div class="login-box">
    <div class="eyebrow">Accès refusé</div>
    <h2>Compte non administrateur</h2>
    <p>Votre compte n'a pas les droits d'administration.</p>
    <p style="font-size:13px;color:var(--ink-mute);margin-bottom:18px">
      Si vous pensez qu'il s'agit d'une erreur, contactez un super-administrateur.
    </p>
    <a href="/compte/dashboard" class="btn btn-primary" style="width:100%">
      ← Retour à mon compte
    </a>
  </div>
</section>

<!-- ============ LOGIN GATE ============ -->
<section id="loginGate" class="login-gate">
  <div class="login-box">
    <div class="eyebrow">Espace privé</div>
    <h2>Administration</h2>
    <p>Entrez le mot de passe administrateur pour continuer.</p>
    <p style="font-size:12px;color:var(--ink-mute);margin-bottom:12px">
      Vous avez un compte administrateur ?
      <a href="/compte" style="color:var(--emerald);text-decoration:underline">Connectez-vous</a>.
    </p>
    <form id="loginForm">
      <input
        type="password"
        id="loginPwd"
        placeholder="Mot de passe"
        required
        autocomplete="current-password"
      />
      <button type="submit" class="btn btn-primary" id="loginBtn">Accéder</button>
      <p id="loginErr" class="login-err hidden">Mot de passe incorrect.</p>
    </form>
  </div>
</section>

<!-- ============ ADMIN SHELL (refonte) ============ -->
<div class="admin-shell hidden" id="adminMain">

  <!-- TOPBAR -->
  <header class="admin-topbar">
    <button type="button" class="admin-burger" id="adminBurger" aria-label="Ouvrir le menu" aria-controls="adminDrawer" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <a href="#accueil" class="admin-topbar-brand" data-nav="accueil">
      <span class="admin-topbar-wordmark">Dadios</span>
      <span class="admin-topbar-tag">Admin</span>
    </a>
    <button type="button" class="admin-search-btn" id="adminSearchBtn" aria-label="Rechercher">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/>
      </svg>
      <span class="admin-search-label">Rechercher…</span>
      <kbd class="admin-search-kbd">⌘K</kbd>
    </button>
    <div class="admin-topbar-actions">
      <button type="button" class="admin-user-btn" id="adminUserBtn" aria-haspopup="true" aria-expanded="false">
        <span class="admin-user-avatar" id="adminUserAvatar" aria-hidden="true">A</span>
        <span class="admin-user-name" id="adminUserName">—</span>
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" aria-hidden="true" class="admin-user-caret"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="admin-user-menu" id="adminUserMenu" hidden>
        <a href="/compte/dashboard">Mon profil</a>
        <a href="/" target="_blank" rel="noopener">Voir le site public ↗</a>
        <button type="button" id="logoutBtn">Se déconnecter</button>
      </div>
    </div>
  </header>

  <!-- SIDEBAR (desktop) -->
  <aside class="admin-sidebar" aria-label="Navigation">
    <a href="#accueil" class="admin-sidebar-brand-link" data-nav="accueil">
      <span class="admin-sidebar-brand">Dadios</span>
      <span class="admin-sidebar-brand-tag">Administration</span>
    </a>
    <nav class="admin-sidebar-nav">
      <a href="#accueil" class="admin-nav-item" data-nav="accueil">
        <span class="admin-nav-icon" aria-hidden="true">🏠</span>
        <span class="admin-nav-label">Accueil</span>
      </a>
      <div class="admin-nav-group" data-nav-group="ventes">Ventes</div>
      <a href="#ventes" class="admin-nav-item" data-nav="ventes" data-nav-section="ventes">
        <span class="admin-nav-icon" aria-hidden="true">🛒</span>
        <span class="admin-nav-label">Ventes</span>
      </a>
      <div class="admin-nav-group" data-nav-group="catalogue">Catalogue</div>
      <a href="#catalogue" class="admin-nav-item" data-nav="catalogue" data-nav-section="catalogue">
        <span class="admin-nav-icon" aria-hidden="true">📦</span>
        <span class="admin-nav-label">Produits</span>
      </a>
      <div class="admin-nav-group" data-nav-group="clients">Clientèle</div>
      <a href="#clients" class="admin-nav-item" data-nav="clients" data-nav-section="clients">
        <span class="admin-nav-icon" aria-hidden="true">👥</span>
        <span class="admin-nav-label">Clients</span>
      </a>
      <div class="admin-nav-group" data-nav-group="contenu">Contenu</div>
      <a href="#contenu" class="admin-nav-item" data-nav="contenu" data-nav-section="contenu">
        <span class="admin-nav-icon" aria-hidden="true">✍️</span>
        <span class="admin-nav-label">Blog &amp; avis</span>
      </a>
      <div class="admin-nav-group" data-nav-group="equipe">Équipe</div>
      <a href="#equipe" class="admin-nav-item" data-nav="equipe" data-nav-section="equipe">
        <span class="admin-nav-icon" aria-hidden="true">⚙️</span>
        <span class="admin-nav-label">Équipe &amp; réglages</span>
      </a>
    </nav>
    <div class="admin-sidebar-foot">
      <div class="admin-sidebar-mode">Mode administrateur</div>
      <div class="admin-sidebar-version">DADIOS · v2</div>
    </div>
  </aside>

  <!-- MOBILE DRAWER (slides from left) -->
  <div class="admin-drawer-backdrop" id="adminDrawerBackdrop" aria-hidden="true"></div>
  <aside class="admin-drawer" id="adminDrawer" role="dialog" aria-modal="true" aria-label="Menu admin" tabindex="-1">
    <div class="admin-drawer-head">
      <span class="admin-drawer-brand">Dadios <span style="opacity:0.6;font-size:14px;letter-spacing:0.2em">ADMIN</span></span>
      <button type="button" class="admin-drawer-close" id="adminDrawerClose" aria-label="Fermer">×</button>
    </div>
    <nav class="admin-drawer-nav">
      <a href="#accueil" class="admin-nav-item" data-nav="accueil"><span class="admin-nav-icon">🏠</span><span class="admin-nav-label">Accueil</span></a>
      <a href="#ventes" class="admin-nav-item" data-nav="ventes" data-nav-section="ventes"><span class="admin-nav-icon">🛒</span><span class="admin-nav-label">Ventes</span></a>
      <a href="#catalogue" class="admin-nav-item" data-nav="catalogue" data-nav-section="catalogue"><span class="admin-nav-icon">📦</span><span class="admin-nav-label">Catalogue</span></a>
      <a href="#clients" class="admin-nav-item" data-nav="clients" data-nav-section="clients"><span class="admin-nav-icon">👥</span><span class="admin-nav-label">Clients</span></a>
      <a href="#contenu" class="admin-nav-item" data-nav="contenu" data-nav-section="contenu"><span class="admin-nav-icon">✍️</span><span class="admin-nav-label">Contenu</span></a>
      <a href="#equipe" class="admin-nav-item" data-nav="equipe" data-nav-section="equipe"><span class="admin-nav-icon">⚙️</span><span class="admin-nav-label">Équipe &amp; réglages</span></a>
    </nav>
  </aside>

  <!-- MOBILE BOTTOM NAV -->
  <nav class="admin-bottomnav" aria-label="Navigation rapide">
    <a href="#accueil" class="admin-bottomnav-item" data-nav="accueil"><span class="admin-bottomnav-icon" aria-hidden="true">🏠</span><span class="admin-bottomnav-label">Accueil</span></a>
    <a href="#ventes" class="admin-bottomnav-item" data-nav="ventes" data-nav-section="ventes"><span class="admin-bottomnav-icon" aria-hidden="true">🛒</span><span class="admin-bottomnav-label">Ventes</span></a>
    <a href="#catalogue" class="admin-bottomnav-item" data-nav="catalogue" data-nav-section="catalogue"><span class="admin-bottomnav-icon" aria-hidden="true">📦</span><span class="admin-bottomnav-label">Produits</span></a>
    <a href="#clients" class="admin-bottomnav-item" data-nav="clients" data-nav-section="clients"><span class="admin-bottomnav-icon" aria-hidden="true">👥</span><span class="admin-bottomnav-label">Clients</span></a>
    <button type="button" class="admin-bottomnav-item" id="adminMoreBtn"><span class="admin-bottomnav-icon" aria-hidden="true">⋯</span><span class="admin-bottomnav-label">Plus</span></button>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="admin-content admin">

  <!-- Per-section title bar: updates as nav changes -->
  <header class="admin-section-current">
    <div>
      <div class="eyebrow" id="sectionEyebrow">Administration</div>
      <h1 id="sectionTitle">Tableau de bord</h1>
      <p class="admin-section-help" id="sectionHelp">Vue d'ensemble de l'activité.</p>
      <p id="countLine" style="color:var(--ink-soft);margin-top:8px;font-size:13px" hidden>Chargement...</p>
    </div>
    <div class="admin-section-actions">
      <button class="btn btn-primary" id="newBtn" data-for-section="catalogue" data-requires-permission="products" hidden>+ Nouveau parfum</button>
    </div>
  </header>

  <!-- Per-section empty state: shown when the active section has no visible block -->
  <div id="adminSectionEmpty" class="admin-section-empty" hidden>
    <p><strong>Aucun module accessible dans cette section</strong> avec vos permissions actuelles.</p>
    <p style="margin-top:8px;font-size:13px">Demandez à un super-administrateur d'élargir vos accès.</p>
  </div>

  <!-- ACCUEIL placeholder (Slice 2 will replace) -->
  <div class="admin-section" data-section="accueil" hidden>
    <div class="admin-accueil-card">
      <div class="admin-accueil-icon" aria-hidden="true">🏗️</div>
      <h2>Tableau de bord en cours de refonte</h2>
      <p>
        Cette page d'accueil affichera bientôt vos KPIs (CA, tickets, panier moyen),
        les alertes en attente (avis à modérer, commandes à confirmer, demandes VIP)
        et l'activité récente de la boutique.
      </p>
      <p class="admin-accueil-hint">
        En attendant, utilisez la navigation latérale pour accéder à chaque module.
      </p>
    </div>
  </div>

  <div id="noPermsEmpty" class="no-perms-empty" hidden>
    <div class="no-perms-icon" aria-hidden="true">🔒</div>
    <h2>Aucune permission active</h2>
    <p>
      Votre compte administrateur n'a aucune permission active.
      Contactez un super-administrateur pour obtenir un accès.
    </p>
  </div>

  <div class="products-block admin-block" data-section="catalogue" data-requires-permission="products" hidden>
    <div class="admin-tabs">
      <button class="tab-btn active" data-filter="all">Tous</button>
      <button class="tab-btn" data-filter="homme">Homme</button>
      <button class="tab-btn" data-filter="femme">Femme</button>
      <button class="tab-btn" data-filter="mixte">Mixte</button>
      <button class="tab-btn" data-filter="featured">Best-sellers</button>
    </div>

    <table class="admin-table">
      <thead>
        <tr>
          <th></th>
          <th>Nom</th>
          <th>Inspiré par</th>
          <th>Famille</th>
          <th>Genre</th>
          <th>Best-seller</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="7" style="text-align:center;padding:48px">Chargement des parfums...</td></tr>
      </tbody>
    </table>

    <div id="statusMsg" class="status-msg hidden"></div>
  </div>

  <!-- ============ CUSTOMER MANAGEMENT ============ -->
  <div class="customers-block admin-block" data-section="clients" data-requires-permission="customers" hidden>
    <div class="customers-head">
      <div class="eyebrow">Gestion des comptes clients</div>
      <h2>Recherche &amp; mot de passe</h2>
      <p class="customers-help">
        Cherchez un client par numéro de téléphone. Vous pouvez réinitialiser
        son mot de passe — le client recevra le nouveau par WhatsApp.
      </p>
    </div>

    <form id="customerSearchForm" class="customer-search">
      <input
        type="tel"
        id="customerSearchPhone"
        placeholder="Téléphone (ex. +216 56 731 891)"
        autocomplete="off"
        inputmode="tel"
      />
      <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
    </form>

    <div id="customerResult" class="customer-result hidden">
      <div class="customer-row">
        <div>
          <div class="eyebrow">Nom</div>
          <div class="customer-val" id="custName"></div>
        </div>
        <div>
          <div class="eyebrow">Téléphone</div>
          <div class="customer-val" id="custPhone"></div>
        </div>
        <div>
          <div class="eyebrow">Adresse</div>
          <div class="customer-val" id="custAddress"></div>
        </div>
        <div>
          <div class="eyebrow">Carte fidélité</div>
          <div class="customer-val" id="custLoyalty"></div>
        </div>
      </div>
      <div class="customer-actions">
        <button type="button" class="btn btn-outline btn-sm" id="custResetBtn">Réinitialiser mot de passe</button>
      </div>
    </div>

    <p id="customerStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ ORDERS MANAGEMENT ============ -->
  <div class="orders-block admin-block" data-section="ventes" data-requires-permission="orders" hidden>
    <div class="orders-head">
      <div>
        <div class="eyebrow">Commandes</div>
        <h2>Gestion des commandes</h2>
        <p class="orders-help">
          Suivez l'avancement de chaque commande WhatsApp et notez les détails de livraison.
        </p>
      </div>
      <button type="button" id="ordersRefresh" class="btn btn-outline btn-sm">↻ Rafraîchir</button>
    </div>

    <div class="orders-filters" id="ordersFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="" role="tab">Toutes <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="pending" role="tab">En attente <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="confirmed" role="tab">Confirmées <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="delivered" role="tab">Livrées <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="cancelled" role="tab">Annulées <span class="count">0</span></button>
    </div>

    <div class="orders-tablewrap">
      <table class="admin-table orders-admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Réf.</th>
            <th>Client</th>
            <th>Articles</th>
            <th>Total</th>
            <th>Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="ordersRows">
          <tr><td colspan="7" style="text-align:center;padding:32px">Chargement des commandes…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="ordersStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ JOURNAL (articles) ============ -->
  <div class="articles-block admin-block" data-section="contenu" data-requires-permission="articles" hidden>
    <div class="articles-head">
      <div>
        <div class="eyebrow">Journal</div>
        <h2>Articles</h2>
        <p class="articles-help">
          Publiez vos articles. Visibles publiquement sur /journal après le
          prochain déploiement du site (push sur main).
        </p>
      </div>
      <a class="btn btn-primary btn-sm" href="/admin/articles/new">+ Nouvel article</a>
    </div>

    <div class="articles-filters" id="articlesFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="" role="tab">Tous <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="published" role="tab">Publiés <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="draft" role="tab">Brouillons <span class="count">0</span></button>
    </div>

    <div class="articles-tablewrap">
      <table class="admin-table articles-admin-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Titre</th>
            <th>Tags</th>
            <th>Statut</th>
            <th>Date</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="articlesRows">
          <tr><td colspan="6" style="text-align:center;padding:32px">Chargement des articles…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="articlesStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ CLIENTS (tier management) ============ -->
  <div class="clients-block admin-block" data-section="clients" data-requires-permission="tiers" hidden>
    <div class="clients-head">
      <div>
        <div class="eyebrow">Clientèle</div>
        <h2>Gestion des clients</h2>
        <p class="clients-help">
          Filtrer par tier, rechercher, accorder ou révoquer VIP / Reseller.
        </p>
      </div>
    </div>

    <div class="clients-filters" id="clientsFilters" role="tablist">
      <button type="button" class="filter-pill active" data-tier="" role="tab">Tous <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-tier="regular" role="tab">Réguliers <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-tier="vip" role="tab">VIP <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-tier="reseller" role="tab">Resellers <span class="count">0</span></button>
    </div>

    <input type="search" id="clientsSearch" class="clients-search" placeholder="Rechercher par téléphone ou nom" autocomplete="off" />

    <div class="clients-tablewrap">
      <table class="admin-table clients-admin-table">
        <thead>
          <tr>
            <th>Téléphone</th>
            <th>Nom</th>
            <th>Tier</th>
            <th>Fidélité</th>
            <th>Inscription</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="clientsRows">
          <tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="clientsStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ PERFUME REQUESTS (concierge) ============ -->
  <div class="perfreq-block admin-block" data-section="clients" data-requires-permission="perfume-requests" hidden>
    <div class="perfreq-head">
      <div>
        <div class="eyebrow">Concierge</div>
        <h2>Demandes de parfums</h2>
        <p class="perfreq-help">
          Suivi des demandes envoyées par les membres VIP.
        </p>
      </div>
    </div>

    <div class="perfreq-filters" id="perfreqFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="" role="tab">Toutes <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="pending" role="tab">En attente <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="in_progress" role="tab">Recherche <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="fulfilled" role="tab">Trouvées <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="declined" role="tab">Refusées <span class="count">0</span></button>
    </div>

    <div class="perfreq-tablewrap">
      <table class="admin-table perfreq-admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Client</th>
            <th>Parfum demandé</th>
            <th>Marque</th>
            <th>Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="perfreqRows">
          <tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="perfreqStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ REVIEWS (avis clients) ============ -->
  <div class="reviews-block admin-block" data-section="contenu" data-requires-permission="reviews" hidden>
    <div class="reviews-head">
      <div>
        <div class="eyebrow">Avis</div>
        <h2>Modération des avis <span id="revPendingBadge" class="rev-pending-badge" hidden>0</span></h2>
        <p class="reviews-help">
          Les avis postés par les clients ayant déjà reçu le produit sont
          publiés automatiquement. Les autres attendent votre validation.
        </p>
      </div>
    </div>

    <div class="reviews-filters" id="reviewsFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="pending" role="tab">En attente <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="approved" role="tab">Approuvés <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="" role="tab">Tous <span class="count">0</span></button>
    </div>

    <div class="reviews-tablewrap">
      <table class="admin-table reviews-admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Client</th>
            <th>Produit</th>
            <th>Note</th>
            <th>Avis</th>
            <th>Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="reviewsRows">
          <tr><td colspan="7" style="text-align:center;padding:32px">Chargement…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="reviewsStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ ADMINISTRATEURS (super-admin only) ============ -->
  <div class="admins-block admin-block" data-section="equipe" data-requires-permission="all" hidden>
    <div class="admins-head">
      <div>
        <div class="eyebrow">Administration</div>
        <h2>Administrateurs &amp; journal d'audit</h2>
        <p class="admins-help">
          Gérez les autres administrateurs et consultez l'historique des actions.
          Toutes vos actions ici sont également tracées.
        </p>
      </div>
      <button type="button" id="adminsAddBtn" class="btn btn-primary btn-sm">+ Promouvoir un client</button>
    </div>

    <div class="admins-tablewrap">
      <table class="admin-table admins-admin-table">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Téléphone</th>
            <th>Permissions</th>
