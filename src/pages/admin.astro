  }
  .admin-user-menu a:hover, .admin-user-menu button:hover {
    background: var(--admin-cream);
  }
  .admin-user-menu button { color: var(--admin-danger); border-top: 1px solid var(--admin-border); }

  /* ============ SIDEBAR (desktop) ============ */
  .admin-sidebar {
    display: none;
    grid-area: sidebar;
    background: var(--admin-emerald);
    color: var(--admin-cream);
    padding: 24px 12px 20px;
    flex-direction: column;
    gap: 16px;
