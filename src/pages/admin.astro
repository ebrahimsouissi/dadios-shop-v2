  .admin-section-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .admin-section-current .eyebrow { color: var(--admin-gold); }

  /* Accueil placeholder card */
  .admin-accueil-card {
    background: var(--admin-paper);
    border: 1px solid var(--admin-border);
    border-radius: 16px;
    padding: clamp(28px, 5vw, 56px);
