---
import Base from '../layouts/Base.astro';
import data from '../data/products.json';
const seedProducts = data.products;
const sizes = data.sizes;
---
<Base
  title="Administration — Dadios Fragrance"
  description="Espace administration"
>

<!-- ============ LOGIN GATE ============ -->
<section id="loginGate" class="login-gate">
  <div class="login-box">
    <div class="eyebrow">Espace privé</div>
    <h2>Administration</h2>
    <p>Entrez le mot de passe administrateur pour continuer.</p>
    <form id="loginForm">
      <input
        type="password"
        id="loginPwd"
        placeholder="Mot de passe"
        required
        autocomplete="current-password"
      />
      <button type="submit" class="btn btn-primary" id="loginBtn">Accéder</button>
      <p id="loginErr" class="login-err hidden">Mot de passe incorrect.</p>
    </form>
  </div>
</section>

<!-- ============ MAIN ADMIN (hidden until logged in) ============ -->
<section class="admin hidden" id="adminMain">
  <div class="admin-head">
    <div>
      <div class="eyebrow">Administration</div>
      <h1>Gestion des parfums</h1>
      <p id="countLine" style="color:var(--ink-soft);margin-top:8px">Chargement...</p>
    </div>
    <div style="display:flex;gap:12px;align-items:center">
      <button class="btn btn-outline btn-sm" id="logoutBtn">Déconnexion</button>
      <button class="btn btn-primary" id="newBtn">+ Nouveau parfum</button>
    </div>
  </div>

  <div class="admin-tabs">
    <button class="tab-btn active" data-filter="all">Tous</button>
    <button class="tab-btn" data-filter="homme">Homme</button>
    <button class="tab-btn" data-filter="femme">Femme</button>
    <button class="tab-btn" data-filter="mixte">Mixte</button>
    <button class="tab-btn" data-filter="featured">Best-sellers</button>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th></th>
        <th>Nom</th>
        <th>Inspiré par</th>
        <th>Famille</th>
        <th>Genre</th>
        <th>Best-seller</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="rows">
      <tr><td colspan="7" style="text-align:center;padding:48px">Chargement des parfums...</td></tr>
    </tbody>
  </table>

  <div id="statusMsg" class="status-msg hidden"></div>

  <!-- ============ CUSTOMER MANAGEMENT ============ -->
  <div class="customers-block">
    <div class="customers-head">
      <div class="eyebrow">Gestion des comptes clients</div>
      <h2>Recherche &amp; mot de passe</h2>
      <p class="customers-help">
        Cherchez un client par numéro de téléphone. Vous pouvez réinitialiser
        son mot de passe — le client recevra le nouveau par WhatsApp.
      </p>
    </div>

    <form id="customerSearchForm" class="customer-search">
      <input
        type="tel"
        id="customerSearchPhone"
        placeholder="Téléphone (ex. +216 56 731 891)"
        autocomplete="off"
        inputmode="tel"
      />
      <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
    </form>

    <div id="customerResult" class="customer-result hidden">
      <div class="customer-row">
        <div>
          <div class="eyebrow">Nom</div>
          <div class="customer-val" id="custName"></div>
        </div>
        <div>
          <div class="eyebrow">Téléphone</div>
          <div class="customer-val" id="custPhone"></div>
        </div>
        <div>
          <div class="eyebrow">Adresse</div>
          <div class="customer-val" id="custAddress"></div>
        </div>
        <div>
          <div class="eyebrow">Carte fidélité</div>
          <div class="customer-val" id="custLoyalty"></div>
        </div>
      </div>
      <div class="customer-actions">
        <button type="button" class="btn btn-outline btn-sm" id="custResetBtn">Réinitialiser mot de passe</button>
      </div>
    </div>

    <p id="customerStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ ORDERS MANAGEMENT ============ -->
  <div class="orders-block">
    <div class="orders-head">
      <div>
        <div class="eyebrow">Commandes</div>
        <h2>Gestion des commandes</h2>
        <p class="orders-help">
          Suivez l'avancement de chaque commande WhatsApp et notez les détails de livraison.
        </p>
      </div>
      <button type="button" id="ordersRefresh" class="btn btn-outline btn-sm">↻ Rafraîchir</button>
    </div>

    <div class="orders-filters" id="ordersFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="" role="tab">Toutes <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="pending" role="tab">En attente <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="confirmed" role="tab">Confirmées <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="delivered" role="tab">Livrées <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="cancelled" role="tab">Annulées <span class="count">0</span></button>
    </div>

    <div class="orders-tablewrap">
      <table class="admin-table orders-admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Réf.</th>
            <th>Client</th>
            <th>Articles</th>
            <th>Total</th>
            <th>Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="ordersRows">
          <tr><td colspan="7" style="text-align:center;padding:32px">Chargement des commandes…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="ordersStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ JOURNAL (articles) ============ -->
  <div class="articles-block">
    <div class="articles-head">
      <div>
        <div class="eyebrow">Journal</div>
        <h2>Articles</h2>
        <p class="articles-help">
          Publiez vos articles. Visibles publiquement sur /journal après le
          prochain déploiement du site (push sur main).
        </p>
      </div>
      <a class="btn btn-primary btn-sm" href="/admin/articles/new">+ Nouvel article</a>
    </div>

    <div class="articles-filters" id="articlesFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="" role="tab">Tous <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="published" role="tab">Publiés <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="draft" role="tab">Brouillons <span class="count">0</span></button>
    </div>

    <div class="articles-tablewrap">
      <table class="admin-table articles-admin-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Titre</th>
            <th>Tags</th>
            <th>Statut</th>
            <th>Date</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="articlesRows">
          <tr><td colspan="6" style="text-align:center;padding:32px">Chargement des articles…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="articlesStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ CLIENTS (tier management) ============ -->
  <div class="clients-block">
    <div class="clients-head">
      <div>
        <div class="eyebrow">Clientèle</div>
        <h2>Gestion des clients</h2>
        <p class="clients-help">
          Filtrer par tier, rechercher, accorder ou révoquer VIP / Reseller.
        </p>
      </div>
    </div>

    <div class="clients-filters" id="clientsFilters" role="tablist">
      <button type="button" class="filter-pill active" data-tier="" role="tab">Tous <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-tier="regular" role="tab">Réguliers <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-tier="vip" role="tab">VIP <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-tier="reseller" role="tab">Resellers <span class="count">0</span></button>
    </div>

    <input type="search" id="clientsSearch" class="clients-search" placeholder="Rechercher par téléphone ou nom" autocomplete="off" />

    <div class="clients-tablewrap">
      <table class="admin-table clients-admin-table">
        <thead>
          <tr>
            <th>Téléphone</th>
            <th>Nom</th>
            <th>Tier</th>
            <th>Fidélité</th>
            <th>Inscription</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="clientsRows">
          <tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="clientsStatus" class="status-msg hidden"></p>
  </div>

  <!-- ============ PERFUME REQUESTS (concierge) ============ -->
  <div class="perfreq-block">
    <div class="perfreq-head">
      <div>
        <div class="eyebrow">Concierge</div>
        <h2>Demandes de parfums</h2>
        <p class="perfreq-help">
          Suivi des demandes envoyées par les membres VIP.
        </p>
      </div>
    </div>

    <div class="perfreq-filters" id="perfreqFilters" role="tablist">
      <button type="button" class="filter-pill active" data-status="" role="tab">Toutes <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="pending" role="tab">En attente <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="in_progress" role="tab">Recherche <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="fulfilled" role="tab">Trouvées <span class="count">0</span></button>
      <button type="button" class="filter-pill" data-status="declined" role="tab">Refusées <span class="count">0</span></button>
    </div>

    <div class="perfreq-tablewrap">
      <table class="admin-table perfreq-admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Client</th>
            <th>Parfum demandé</th>
            <th>Marque</th>
            <th>Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="perfreqRows">
          <tr><td colspan="6" style="text-align:center;padding:32px">Chargement…</td></tr>
        </tbody>
      </table>
    </div>

    <p id="perfreqStatus" class="status-msg hidden"></p>
  </div>
</section>

<!-- ============ CLIENT TIER MODAL ============ -->
<div class="modal hidden" id="tierModal">
  <div class="modal-overlay" id="tierOverlay"></div>
  <div class="modal-box small">
    <button type="button" class="modal-close" id="tierClose" aria-label="Fermer">×</button>
    <div class="eyebrow">Statut client</div>
    <h2 id="tierTitle">Changer le statut</h2>
    <p style="color:var(--ink-soft);margin-bottom:16px" id="tierSubtitle"></p>
    <form id="tierForm">
      <label>
        <span>Tier *</span>
        <select id="tierSelect">
          <option value="regular">Régulier</option>
          <option value="vip">VIP</option>
          <option value="reseller">Reseller</option>
        </select>
      </label>
      <div id="tierResellerFields" hidden>
        <label>
          <span>Nom de la société</span>
          <input type="text" id="tierCompany" />
        </label>
        <label>
          <span>Matricule Fiscale</span>
          <input type="text" id="tierMatricule" />
        </label>
        <label>
          <span>Adresse de livraison</span>
          <textarea id="tierDelivery" rows="2"></textarea>
        </label>
      </div>
      <p id="tierErr" class="status-msg error hidden" style="margin-top:12px"></p>
      <div class="form-actions">
        <button type="button" class="btn btn-outline" id="tierCancel">Annuler</button>
        <button type="submit" class="btn btn-primary" id="tierSave">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<!-- ============ PERFUME REQUEST DETAILS MODAL ============ -->
<div class="modal hidden" id="perfreqModal">
  <div class="modal-overlay" id="perfreqOverlay"></div>
  <div class="modal-box order-modal-box">
    <button type="button" class="modal-close" id="perfreqClose" aria-label="Fermer">×</button>
    <div class="eyebrow">Demande</div>
    <h2 id="perfreqTitle">Détails</h2>
    <p id="perfreqMeta" class="order-meta-line"></p>

    <div class="order-modal-grid">
      <div>
        <div class="eyebrow" style="margin-bottom:10px">Parfum demandé</div>
        <p style="font-family:var(--font-display);font-size:18px;color:var(--ink)" id="perfreqPerfume"></p>
        <p style="color:var(--ink-mute);margin:4px 0 14px" id="perfreqBrand"></p>
        <div class="eyebrow" style="margin-bottom:8px">Notes du client</div>
        <p id="perfreqCustNotes" style="color:var(--ink-soft);white-space:pre-line">—</p>
      </div>
      <div>
        <div class="eyebrow" style="margin-bottom:10px">Client</div>
        <p class="order-customer-line" id="perfreqCustName"></p>
        <p class="order-customer-line" id="perfreqCustPhone"></p>
        <div class="order-customer-actions" id="perfreqCustActions"></div>

        <div class="eyebrow" style="margin:18px 0 10px">Notes internes</div>
        <textarea id="perfreqAdminNotes" rows="4" placeholder="Pistes, fournisseurs, prix…"></textarea>
        <div class="order-notes-actions">
          <button type="button" class="btn btn-primary btn-sm" id="perfreqSaveNotes">Enregistrer les notes</button>
          <span id="perfreqNotesStatus" class="order-notes-status"></span>
        </div>
      </div>
    </div>

    <p class="order-modal-stamps" id="perfreqStamps"></p>
  </div>
</div>

<!-- ============ ORDER DETAILS MODAL ============ -->
<div class="modal hidden" id="orderModal">
  <div class="modal-overlay" id="orderOverlay"></div>
  <div class="modal-box order-modal-box">
    <button type="button" class="modal-close" id="orderClose" aria-label="Fermer">×</button>
    <div class="eyebrow">Commande</div>
    <h2 id="orderTitle">Détails</h2>
    <p id="orderMeta" class="order-meta-line"></p>

    <div class="order-modal-grid">
      <div>
        <div class="eyebrow" style="margin-bottom:10px">Articles</div>
        <ul class="order-modal-items" id="orderModalItems"></ul>
        <div class="order-modal-total" id="orderModalTotal"></div>
      </div>
      <div>
        <div class="eyebrow" style="margin-bottom:10px">Client</div>
        <p class="order-customer-line" id="orderCustomerName"></p>
        <p class="order-customer-line" id="orderCustomerPhone"></p>
        <div class="order-customer-actions" id="orderCustomerActions"></div>

        <div class="eyebrow" style="margin:18px 0 10px">Notes (interne)</div>
        <textarea id="orderNotes" rows="4" placeholder="Notes de livraison, observations…"></textarea>
        <div class="order-notes-actions">
          <button type="button" class="btn btn-primary btn-sm" id="orderSaveNotes">Enregistrer les notes</button>
          <span id="orderNotesStatus" class="order-notes-status"></span>
        </div>
      </div>
    </div>

    <p class="order-modal-stamps" id="orderStamps"></p>
  </div>
</div>

<!-- ============ CUSTOMER PASSWORD RESET MODAL ============ -->
<div class="modal hidden" id="custPwModal">
  <div class="modal-overlay" id="custPwOverlay"></div>
  <div class="modal-box small">
    <button type="button" class="modal-close" id="custPwClose" aria-label="Fermer">×</button>
    <div class="eyebrow">Compte client</div>
    <h2 id="custPwTitle">Nouveau mot de passe</h2>
    <p style="color:var(--ink-soft);margin-bottom:16px">
      Le client utilisera ce mot de passe lors de sa prochaine connexion.
      Communiquez-le par WhatsApp.
    </p>
    <form id="custPwForm">
      <label>
        <span>Nouveau mot de passe *</span>
        <input type="text" id="custPwInput" required minlength="6" placeholder="6 caractères minimum" />
        <small>Visible ici pour pouvoir le communiquer au client.</small>
      </label>
      <p id="custPwErr" class="status-msg error hidden" style="margin-top:12px"></p>
      <div class="form-actions">
        <button type="button" class="btn btn-outline" id="custPwCancel">Annuler</button>
        <button type="submit" class="btn btn-primary" id="custPwSave">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<!-- ============ MODAL ============ -->
<div class="modal hidden" id="modal">
  <div class="modal-overlay" id="overlay"></div>
  <div class="modal-box">
    <button class="modal-close" id="closeBtn" aria-label="Fermer">×</button>
    <div class="eyebrow" id="modalEyebrow">Ajouter un parfum</div>
    <h2 id="modalTitle">Nouveau parfum</h2>

    <form id="prodForm">
      <input type="hidden" name="originalSlug" id="originalSlug" />

      <!-- IMAGE UPLOAD -->
      <div class="card-block">
        <strong>Photo du produit</strong>
        <small style="display:block;margin-bottom:12px">JPG, PNG ou WebP. Sera rognée en carré automatiquement.</small>
        <div class="image-uploader">
          <div class="image-preview" id="imgPreview">
            <span class="image-placeholder">Aucune image</span>
          </div>
          <div class="image-controls">
            <input type="file" id="imgFile" accept="image/jpeg,image/jpg,image/png,image/webp" hidden />
            <button type="button" class="btn btn-outline btn-sm" id="imgPickBtn">📁 Choisir une photo</button>
            <button type="button" class="btn btn-outline btn-sm hidden" id="imgRemoveBtn">Retirer</button>
            <p class="image-hint" id="imgStatus"></p>
          </div>
        </div>
        <input type="hidden" name="image" id="imgUrl" value="" />
      </div>

      <div class="form-row">
        <label>
          <span>Nom du parfum *</span>
          <input type="text" name="name" id="fName" required placeholder="ex. Sauvage Élixir" />
        </label>
        <label>
          <span>Identifiant URL (slug) *</span>
          <input type="text" name="slug" id="fSlug" required placeholder="ex. sauvage-elixir" pattern="[a-z0-9\-]+" />
          <small>Lettres minuscules, chiffres, tirets uniquement.</small>
        </label>
      </div>

      <label>
        <span>Inspiré par *</span>
        <input type="text" name="inspiredBy" id="fInspired" required placeholder="ex. Dior Sauvage Élixir" />
      </label>

      <div class="form-row">
        <label>
          <span>Genre *</span>
          <select name="gender" id="fGender" required>
            <option value="homme">Homme</option>
            <option value="femme">Femme</option>
            <option value="mixte">Mixte</option>
          </select>
        </label>
        <label>
          <span>Famille olfactive *</span>
          <input type="text" name="family" id="fFamily" required placeholder="ex. Boisé · Épicé" />
        </label>
      </div>

      <label>
        <span>Description courte *</span>
        <textarea name="shortDescription" id="fDesc" rows="3" required placeholder="Une fragrance puissante..." maxlength="240"></textarea>
        <small>Apparaît dans les résultats Google. Maximum 240 caractères.</small>
      </label>

      <div class="card-block">
        <strong>Pyramide olfactive</strong>
        <small style="display:block;margin-bottom:12px">Séparez les notes par des virgules.</small>
        <label>
          <span>Notes de tête</span>
          <input type="text" name="topNotes" id="fTopN" placeholder="Bergamote, Pamplemousse" />
        </label>
        <label>
          <span>Notes de cœur</span>
          <input type="text" name="heartNotes" id="fHeartN" placeholder="Iris, Jasmin" />
        </label>
        <label>
          <span>Notes de fond</span>
          <input type="text" name="baseNotes" id="fBaseN" placeholder="Santal, Vanille, Musc" />
        </label>
      </div>

      <div class="form-row">
        <label>
          <span>Tenue</span>
          <input type="text" name="longevity" id="fLong" placeholder="ex. 8 h" />
        </label>
        <label>
          <span>Sillage</span>
          <select name="sillage" id="fSill">
            <option>Modéré</option>
            <option>Fort</option>
            <option>Énorme</option>
          </select>
        </label>
      </div>

      <div class="form-row">
        <div>
          <span class="lbl">Saisons</span>
          <div class="check-row" id="seasonsBox">
            {['Hiver','Printemps','Été','Automne'].map(s => (
              <label class="check-item"><input type="checkbox" name="seasons" value={s}/> {s}</label>
            ))}
          </div>
        </div>
        <div>
          <span class="lbl">Moments</span>
          <div class="check-row" id="momentsBox">
            {['Jour','Soir','Événement'].map(m => (
              <label class="check-item"><input type="checkbox" name="moments" value={m}/> {m}</label>
            ))}
          </div>
        </div>
      </div>

      <div class="card-block">
        <strong>Prix par format</strong>
        <small style="display:block;margin-bottom:12px">Prix globaux. Pour modifier, éditer les Sizes dans products.json.</small>
        <div class="price-grid">
          {sizes.map((s: any) => (
            <div class="price-cell">
              <span class="size-label">{s.label}</span>
              <span class="size-price">{s.price} <small>DT</small></span>
            </div>
          ))}
        </div>
      </div>

      <label class="checkbox">
        <input type="checkbox" name="featured" id="fFeat" />
        <span>Mettre en avant comme <strong>best-seller</strong> sur la page d'accueil</span>
      </label>

      <label class="checkbox">
        <input type="checkbox" name="vipOnly" id="fVipOnly" />
        <span>👑 Réservé aux <strong>VIP</strong> (masqué aux autres clients)</span>
      </label>

      <label>
        <span>💼 Prix grossiste (DT) — facultatif, visible uniquement aux Resellers</span>
        <input type="number" name="wholesalePrice" id="fWholesale" min="0" step="0.01" placeholder="Laisser vide si non applicable" />
      </label>

      <div class="form-actions">
        <button type="button" class="btn btn-outline" id="cancelBtn">Annuler</button>
        <button type="submit" class="btn btn-primary" id="saveBtn">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

</Base>

<style>
  /* ====== LOGIN GATE ====== */
  .login-gate {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
  }
  .login-box {
    max-width: 420px;
    width: 100%;
    background: var(--cream-soft);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    padding: 40px 36px;
    text-align: center;
  }
  .login-box h2 { font-size: 32px; margin: 8px 0 8px; }
  .login-box p { color: var(--ink-soft); margin-bottom: 24px; font-size: 14px; }
  .login-box input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 14px;
    margin-bottom: 12px;
  }
  .login-box input:focus { outline: none; border-color: var(--emerald); }
