---
import Base from '../layouts/Base.astro';

const STORE = {
  phoneDisplay: '+216 56 731 891',
  phoneTel: '+21656731891',
  waNumber: '21656731891',
  street: '45 Rue De La Cité Sportive',
  city: 'Ariana',
  country: 'Tunisia',
  lat: 36.877667,
  lng: 10.205129,
  instagramHandle: '@dadios.fragrances',
  instagramUrl: 'https://www.instagram.com/dadios.fragrances/',
};

const mapDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${STORE.lat},${STORE.lng}`;
---
<Base
  title="Contactez-nous — Dadios Fragrance"
  description="Une question, une commande ? Joignez Dadios Fragrance à Ariana, Tunisie : téléphone, WhatsApp, Instagram."
>

<section class="contact-hero">
  <div class="contact-hero-inner">
    <div class="eyebrow">Service client</div>
    <h1>Contactez-nous</h1>
    <p class="contact-lead">
      <span class="script">Nous sommes à votre écoute.</span>
    </p>
  </div>
</section>

<section class="contact-cards">
  <div class="cards-grid">
    <article class="contact-card">
      <div class="card-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </div>
      <h2>Téléphone</h2>
      <p class="card-line"><a href={`tel:${STORE.phoneTel}`}>{STORE.phoneDisplay}</a></p>
      <p class="card-sub">Du lundi au samedi</p>
      <a class="btn btn-gold btn-sm card-cta" href={`https://wa.me/${STORE.waNumber}`} target="_blank" rel="noopener">
        Écrire sur WhatsApp →
      </a>
    </article>

    <article class="contact-card">
      <div class="card-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <h2>Adresse</h2>
      <p class="card-line">{STORE.street}<br/>{STORE.city}, {STORE.country}</p>
      <p class="card-sub">Boutique &amp; atelier</p>
      <a class="btn btn-outline btn-sm card-cta" href={mapDirectionsUrl} target="_blank" rel="noopener">
        Itinéraire →
      </a>
    </article>

    <article class="contact-card">
      <div class="card-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <h2>Horaires</h2>
      <p class="card-line">
        <span class="hour-day">Lun – Sam</span>
        <span class="hour-val">9h – 19h</span>
      </p>
      <p class="card-line muted">
        <span class="hour-day">Dimanche</span>
        <span class="hour-val">Fermé</span>
      </p>
    </article>
  </div>
</section>

<section class="contact-social">
  <div class="social-inner">
    <div class="ornament">
      <span class="line"></span>
      <svg viewBox="0 0 24 24"><path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="currentColor"/></svg>
      <span class="line"></span>
    </div>
    <div class="eyebrow">Suivez-nous</div>
    <h2>Sur les réseaux</h2>
    <p class="social-lead">
      Coulisses de l'atelier, lancements de signatures, conseils olfactifs.
    </p>
    <a class="btn btn-primary social-btn" href={STORE.instagramUrl} target="_blank" rel="noopener">
      <svg class="ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
      </svg>
      <span>{STORE.instagramHandle}</span>
    </a>
  </div>
</section>

</Base>

<style>
  /* ===== HERO ===== */
  .contact-hero {
    background: var(--cream);
    padding: 64px 32px 48px;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .contact-hero-inner { max-width: 720px; margin: 0 auto; }
  .contact-hero h1 {
    font-size: clamp(40px, 5vw, 56px);
    margin: 14px 0 12px;
    line-height: 1.05;
  }
  .contact-lead .script { font-size: 30px; }

  /* ===== CARDS ===== */
  .contact-cards {
    background: var(--cream);
    padding: 64px 32px;
  }
  .cards-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .contact-card {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 36px 28px 30px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: border-color .2s, transform .2s;
  }
  .contact-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }
  .card-icon {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: var(--cream-warm);
    color: var(--emerald);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border: 1px solid var(--border);
  }
  .card-icon svg { width: 28px; height: 28px; }
  .contact-card h2 {
    font-family: var(--font-display);
    font-size: 22px;
    margin-bottom: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .card-line {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--ink);
    line-height: 1.55;
    margin-bottom: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .card-line a {
    color: var(--emerald);
    transition: color .2s;
  }
  .card-line a:hover { color: var(--emerald-dark); text-decoration: underline; }
  .card-line.muted { color: var(--ink-mute); }
  .card-line.muted .hour-val { color: var(--ink-mute); }
  .card-sub {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 18px;
  }
  .hour-day {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-weight: 500;
  }
  .hour-val {
    font-size: 20px;
    color: var(--emerald);
  }
  .card-cta { margin-top: auto; }

  /* ===== SOCIAL ===== */
  .contact-social {
    background: var(--cream-warm);
    padding: 80px 32px 96px;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .social-inner { max-width: 640px; margin: 0 auto; }
  .social-inner .eyebrow { display: block; margin-bottom: 14px; }
  .social-inner h2 {
    font-size: clamp(28px, 3.5vw, 38px);
    margin-bottom: 14px;
  }
  .social-lead {
    color: var(--ink-soft);
    margin-bottom: 28px;
    line-height: 1.7;
  }
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .ig-icon { width: 18px; height: 18px; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 880px) {
    .contact-hero { padding: 48px 16px 40px; }
    .contact-cards { padding: 40px 16px; }
    .cards-grid { grid-template-columns: 1fr; gap: 16px; }
    .contact-social { padding: 56px 16px 72px; }
  }
  @media (max-width: 480px) {
    .contact-lead .script { font-size: 24px; }
    .contact-card { padding: 28px 22px 24px; }
  }
</style>
