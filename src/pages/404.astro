---
/**
 * 404 page.
 *
 * Special case for /journal/<slug>: many journal articles aren't
 * enumerated by [slug].astro's getStaticPaths (the Worker is unreachable
 * during build, or the article was published between builds). On those
 * URLs Astro serves /404.html — so we mount the same ArticleSkeleton +
 * articlePage renderer here. The URL bar stays at /journal/<slug>; the
 * user reads the article. Status code is still 404, which is acceptable
 * for a freshly-published article until the next build picks it up.
 *
 * Everywhere else the page falls back to a normal 404 panel.
 */
import Base from '../layouts/Base.astro';
import ArticleSkeleton from '../components/ArticleSkeleton.astro';
---
<Base
  title="Page introuvable — Dadios Fragrance"
  description="Cette page n'existe pas ou plus."
>

<!-- Default 404 panel; hidden if we recognise a journal slug. -->
<section class="nf-wrap" id="nfGeneric">
  <div class="nf-inner">
    <div class="eyebrow">404</div>
    <h1>Page introuvable</h1>
    <p class="nf-lead">
      La page que vous cherchez n'existe pas.
    </p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
      <a href="/parfums" class="btn btn-outline">Voir les parfums</a>
    </div>
  </div>
</section>

<!-- Journal article fallback. Hidden by default; the script below toggles
     visibility when the current path looks like /journal/<slug>. -->
<div id="nfJournalMount" hidden>
  <ArticleSkeleton />
</div>

</Base>

<style>
  .nf-wrap {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 24px;
  }
  .nf-inner {
    max-width: 540px;
    text-align: center;
  }
  .nf-inner h1 {
    font-size: clamp(36px, 4vw, 48px);
    margin: 12px 0 16px;
  }
  .nf-lead {
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .nf-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

<script>
  import { initArticlePage, slugFromCurrentPath } from '../scripts/articlePage.js';

  const slug = slugFromCurrentPath();
  if (slug) {
    document.getElementById('nfGeneric')?.setAttribute('hidden', '');
    const mount = document.getElementById('nfJournalMount');
    if (mount) mount.hidden = false;
    const isPreview = new URLSearchParams(window.location.search).get('preview') === '1';
    initArticlePage(slug, { isPreview });
  }
</script>
