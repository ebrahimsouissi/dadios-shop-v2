---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page introuvable — Dadios Fragrance"
  description="Cette page n'existe pas ou plus."
>

<section class="nf-wrap">
  <div class="nf-inner">
    <div class="eyebrow">404</div>
    <h1>Page introuvable</h1>
    <p class="nf-lead">
      La page que vous cherchez n'existe pas — ou cet article du Journal
      vient d'être publié et n'est pas encore inclus dans le build statique.
    </p>
    <div id="nfJournalCheck" class="nf-loading" hidden>Recherche dans le Journal…</div>
    <p id="nfJournalFound" class="nf-found" hidden></p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
      <a href="/parfums" class="btn btn-outline">Voir les parfums</a>
    </div>
  </div>
</section>

</Base>

<style>
  .nf-wrap {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 24px;
  }
  .nf-inner {
    max-width: 540px;
    text-align: center;
  }
  .nf-inner h1 {
    font-size: clamp(36px, 4vw, 48px);
    margin: 12px 0 16px;
  }
  .nf-lead {
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .nf-loading { color: var(--ink-mute); font-style: italic; margin-bottom: 18px; }
  .nf-found {
    background: rgba(14, 58, 31, 0.06);
    border: 1px solid var(--emerald);
    color: var(--emerald);
    padding: 12px 16px;
    border-radius: 10px;
    margin-bottom: 22px;
  }
  .nf-found a {
    color: var(--emerald);
    text-decoration: underline;
    font-weight: 500;
  }
  .nf-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

<script>
  // When the user lands on /journal/<slug> for a slug that didn't exist at
  // build time, this 404 page tries the live Worker. If the slug resolves
  // to a published article, we surface a direct link so they can still
  // read it (no client-side route swap because the URL bar would stay on
  // /404 — a hard click is cleaner here).
  import { getPublishedArticle, frenchRelativeDate } from '../scripts/articlesApi.js';

  const path = window.location.pathname || '';
  const m = path.match(/^\/journal\/([a-z0-9-]+)\/?$/);
  if (m) {
    const slug = m[1];
    const check = document.getElementById('nfJournalCheck');
    const found = document.getElementById('nfJournalFound');
    if (check) check.hidden = false;
    (async () => {
      const res = await getPublishedArticle(slug);
      if (check) check.hidden = true;
      if (res.ok && res.article && found) {
        // The article exists on the API but not in the static build.
        // Reload to /journal/<slug>?live=1 — same path so when the next
        // build picks up this article the URL stays canonical.
        found.innerHTML = `
          <strong>Article trouvé :</strong> ${escHtml(res.article.title)}<br/>
          <small>${escHtml(frenchRelativeDate(res.article.publishedAt))} · ${Number(res.article.readingTime) || 1} min</small><br/>
          <a href="/journal/${encodeURIComponent(slug)}?live=1" style="display:inline-block;margin-top:8px">Lire cet article →</a>
        `;
        found.hidden = false;
      }
    })();
  }

  function escHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;',
    })[c]);
  }
</script>
