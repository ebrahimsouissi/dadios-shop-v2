---
import Base from '../layouts/Base.astro';
---
<Base
  title="Votre Panier — Dadios Fragrance"
  description="Finalisez votre commande de parfumerie artisanale Dadios. Livraison à Tunis."
>

<div class="crumb-wrap">
  <nav class="crumbs" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a> <span>·</span>
    <span>Panier</span>
  </nav>
</div>

<section class="panier-hero">
  <div class="panier-hero-inner">
    <div class="eyebrow">Votre commande</div>
    <h1>Votre Panier</h1>
  </div>
</section>

<section class="panier-wrap">
  <!-- Empty state -->
  <div id="cartEmpty" class="cart-empty" hidden>
    <div class="empty-bottle" aria-hidden="true">
      <svg viewBox="0 0 80 100" xmlns="http://www.w3.org/2000/svg">
        <rect x="22" y="22" width="36" height="68" rx="2" fill="#0E3A1F"/>
        <rect x="22" y="22" width="36" height="68" rx="2" fill="none" stroke="#D4AF37" stroke-width="0.8"/>
        <rect x="28" y="46" width="24" height="32" fill="#0E3A1F" stroke="#D4AF37" stroke-width="0.4"/>
        <text x="40" y="60" text-anchor="middle" font-family="Allura, cursive" font-size="14" fill="#D4AF37">Dadios</text>
        <rect x="30" y="10" width="20" height="14" rx="1.5" fill="#A87C45"/>
      </svg>
    </div>
    <h2>Votre panier est vide.</h2>
    <p>Découvrez nos signatures et composez votre commande.</p>
    <a href="/parfums" class="btn btn-primary">Découvrir nos parfums</a>
  </div>

  <!-- Body shown when cart has items -->
  <div id="cartBody" class="cart-body" hidden>
    <ul id="cartItems" class="cart-items" role="list"></ul>

    <aside class="cart-summary" aria-label="Récapitulatif">
      <div class="summary-rows">
        <div class="summary-row">
          <span>Sous-total</span>
          <span id="cartSubtotal">0 DT</span>
        </div>
        <div class="summary-row delivery">
          <span>Livraison</span>
          <span id="cartDelivery">—</span>
        </div>
        <p class="delivery-note" id="deliveryNote"></p>
        <div class="summary-row total">
          <span>Total</span>
          <span id="cartTotal">0 DT</span>
        </div>
      </div>

      <div class="cart-actions">
        <button type="button" id="whatsappBtn" class="btn btn-primary cta-wa">
          <svg class="wa-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M16.001 3C9.373 3 3.999 8.373 3.999 15c0 2.34.685 4.522 1.86 6.366L3.999 27l5.794-1.829A11.93 11.93 0 0 0 16 27c6.627 0 12-5.373 12-12S22.628 3 16.001 3Zm0 21.6c-1.8 0-3.56-.485-5.1-1.405l-.366-.219-3.443 1.085 1.099-3.351-.238-.39A9.55 9.55 0 0 1 6.4 15c0-5.295 4.306-9.6 9.601-9.6 5.296 0 9.6 4.305 9.6 9.6s-4.304 9.6-9.6 9.6Zm5.243-7.176c-.288-.144-1.7-.838-1.962-.934-.264-.097-.456-.144-.648.144-.193.288-.745.934-.913 1.127-.169.193-.337.216-.625.072-.288-.144-1.217-.448-2.318-1.43-.857-.764-1.435-1.708-1.604-1.996-.168-.288-.018-.444.126-.587.13-.13.288-.337.432-.505.144-.169.193-.288.288-.481.097-.193.048-.36-.024-.505-.072-.144-.648-1.563-.888-2.139-.235-.564-.473-.487-.648-.495l-.553-.01c-.193 0-.505.072-.769.36-.265.288-1.009.987-1.009 2.405 0 1.42 1.033 2.79 1.177 2.982.144.193 2.03 3.099 4.92 4.346.688.297 1.224.474 1.642.607.69.219 1.317.188 1.815.114.554-.083 1.7-.694 1.94-1.365.24-.671.24-1.247.168-1.367-.072-.121-.265-.193-.553-.337Z"/>
          </svg>
          <span>Commander sur WhatsApp</span>
        </button>
        <button type="button" id="clearBtn" class="btn btn-outline btn-sm">Vider le panier</button>
      </div>

      <p class="summary-fine">
        La commande est finalisée par message WhatsApp avec notre équipe.
        Paiement à la livraison ou par virement.
      </p>
    </aside>
  </div>
</section>

<!-- ===== Guest phone modal — only shown if not logged in ===== -->
<div id="phoneModal" class="phone-modal" hidden>
  <div class="phone-overlay" id="phoneOverlay"></div>
  <div class="phone-box" role="dialog" aria-modal="true" aria-labelledby="phoneTitle">
    <button type="button" class="phone-close" id="phoneClose" aria-label="Fermer">×</button>
    <div class="eyebrow">Suivi de commande</div>
    <h2 id="phoneTitle">Votre numéro WhatsApp</h2>
    <p>
      Pour suivre votre commande dans votre espace client, indiquez votre
      numéro. Sinon, votre commande sera passée directement par message.
    </p>
    <form id="phoneForm" novalidate>
      <label>
        <span>Téléphone</span>
        <input
          type="tel"
          id="phoneInput"
          placeholder="+216 56 731 891"
          inputmode="tel"
          autocomplete="tel"
        />
      </label>
      <p id="phoneErr" class="phone-err" hidden></p>
      <div class="phone-actions">
        <button type="button" id="phoneSkip" class="btn btn-outline btn-sm">
          Continuer sans suivi
        </button>
        <button type="submit" id="phoneContinue" class="btn btn-primary btn-sm">
          Continuer
        </button>
      </div>
    </form>
  </div>
</div>

</Base>

<style>
  .crumb-wrap { max-width: 1200px; margin: 0 auto; padding: 16px 24px 0; }
  .crumbs { font-size: 12px; color: var(--ink-mute); letter-spacing: 0.06em; }
  .crumbs a:hover { color: var(--emerald); }
  .crumbs span { margin: 0 6px; opacity: 0.5; }

  .panier-hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px 24px;
  }
  .panier-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 44px);
    margin-top: 6px;
  }
  .panier-hero .eyebrow { display: block; }

  .panier-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  /* ===== empty ===== */
  /* Centred card with a comfortable minimum height so the page doesn't
     look hollow when the cart is empty. */
  .cart-empty {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 56px 32px;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .empty-bottle {
    background: var(--cream-warm);
    border-radius: 999px;
    width: 96px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }
  .empty-bottle svg { width: 56px; height: 70px; }
  .cart-empty h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    margin-bottom: 10px;
  }
  .cart-empty p { color: var(--ink-soft); margin-bottom: 22px; line-height: 1.55; }

  /* ===== body grid =====
     Mobile / tablet: single column, summary stacks under the items.
     Desktop (>= 1024px): two columns, summary sticky on the right. */
  .cart-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .cart-body {
      grid-template-columns: minmax(0, 3fr) minmax(320px, 2fr);
      gap: 32px;
    }
  }

  /* ===== items list ===== */
  /* Phase 11 polish: each row is now its own card with a subtle shadow,
     instead of a single border-collapsed list. Items reveal the trash
     button on hover (desktop) / always on mobile (touch). */
  .cart-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cart-row {
    position: relative;
    display: grid;
    grid-template-columns: 100px 1fr auto auto auto;
    gap: 18px;
    align-items: center;
    padding: 16px 20px;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15, 81, 50, 0.06);
    transition: transform 200ms ease-out, opacity 200ms ease-out, box-shadow 200ms ease-out;
  }
  .cart-row:hover { box-shadow: 0 4px 12px rgba(15, 81, 50, 0.1); }
  .cart-row.removing {
    animation: cart-row-out 300ms ease-out forwards;
    pointer-events: none;
  }
  @keyframes cart-row-out {
    to { transform: translateX(-100%); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-row, .cart-row.removing { animation: none !important; transition: none !important; }
  }

  .row-img {
    width: 100px;
    height: 100px;
    background: var(--cream-warm);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .row-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .row-img svg { width: 65%; height: auto; }

  .row-info { min-width: 0; }
  .row-name {
    font-family: var(--font-display);
    font-size: 19px;
    color: var(--ink);
    margin-bottom: 4px;
    line-height: 1.2;
  }
  .row-size {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 4px;
  }
  .row-unit { font-size: 12px; color: var(--ink-mute); }

  .row-qty {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .qty-btn {
    width: 32px;
    height: 32px;
    background: var(--cream);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 150ms ease-out, background 150ms, border-color 150ms;
  }
  .qty-btn:hover { transform: scale(1.05); border-color: var(--emerald); background: var(--cream-warm); }
  .qty-btn:active { transform: scale(0.95); }
  .qty-val {
    min-width: 28px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--emerald);
    font-weight: 500;
  }

  .row-sub {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--emerald);
    font-weight: 500;
    min-width: 70px;
    text-align: right;
  }

  .row-remove {
    background: transparent;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--ink-mute);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 180ms ease-out, color 150ms, background 150ms;
  }
  .cart-row:hover .row-remove,
  .cart-row:focus-within .row-remove { opacity: 1; }
  .row-remove:focus-visible { opacity: 1; outline: 2px solid var(--emerald); outline-offset: 2px; }
  .row-remove:hover {
    color: #B23A1F;
    background: rgba(178, 58, 31, 0.08);
  }
  /* Touch devices can't hover — always show */
  @media (hover: none) {
    .row-remove { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .qty-btn { transition: none !important; }
    .qty-btn:hover, .qty-btn:active { transform: none !important; }
  }

  /* ===== summary =====
     Desktop: sticky in the right column, follows the scroll.
     Mobile/tablet: flows naturally below the items list. */
  .cart-summary {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    box-shadow: 0 1px 3px rgba(15, 81, 50, 0.06);
  }
  @media (min-width: 1024px) {
    .cart-summary {
      position: sticky;
      top: 100px;
    }
  }
  .summary-rows { padding-bottom: 16px; }
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .summary-row.delivery.free { color: var(--emerald); }
  .summary-row.total {
    border-top: 1px solid var(--gold);
    margin-top: 14px;
    padding-top: 18px;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--ink);
  }
  .summary-row.total > span:last-child { color: var(--gold); }
  .delivery-note {
    font-size: 12px;
    color: var(--ink-mute);
    margin: 4px 0 8px;
    line-height: 1.5;
  }
  .delivery-note.success { color: var(--emerald); }

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 14px;
  }
  .cta-wa {
    width: 100%;
    min-height: 56px;
    background: #25D366 !important;
    color: #fff !important;
    border-color: #25D366 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 15px;
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6);
    animation: cta-wa-pulse 3s ease-in-out infinite;
  }
  .cta-wa:hover { background: #1ebe5b !important; border-color: #1ebe5b !important; }
  .cta-wa .wa-icon { width: 20px; height: 20px; flex-shrink: 0; }
  @keyframes cta-wa-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.55); }
    50%      { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-wa { animation: none !important; }
  }
  /* Clear-cart button — ghost style with gold border per spec. */
  #clearBtn {
    width: 100%;
    border-color: var(--gold-soft);
    color: var(--ink-soft);
  }
  #clearBtn:hover {
    background: var(--cream-soft);
    border-color: var(--gold);
    color: var(--ink);
  }
  .summary-fine {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-mute);
    font-style: italic;
  }
  /* ===== guest phone modal ===== */
  .phone-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .phone-modal[hidden] { display: none !important; }
  .phone-overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 26, 14, 0.72);
    backdrop-filter: blur(4px);
  }
  .phone-box {
    position: relative;
    background: var(--cream);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    width: 100%;
    max-width: 460px;
    padding: 32px 32px 28px;
  }
  .phone-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: var(--ink-mute);
    line-height: 1;
  }
  .phone-box h2 { font-size: 24px; margin: 6px 0 12px; }
  .phone-box > p { color: var(--ink-soft); line-height: 1.6; margin-bottom: 18px; font-size: 14px; }
  .phone-box label { display: block; }
  .phone-box label > span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .phone-box input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream-soft);
    font-family: var(--font-body);
    font-size: 14px;
    box-sizing: border-box;
  }
  .phone-box input:focus { outline: none; border-color: var(--emerald); }
  .phone-err {
    background: rgba(178, 58, 31, 0.08);
    border: 1px solid #B23A1F;
    color: #8a2a14;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin: 10px 0 0;
  }
  .phone-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .phone-actions .btn { flex: 1; min-width: 0; }

  @media (max-width: 767px) {
    .panier-hero, .panier-wrap { padding-left: 16px; padding-right: 16px; }
    .crumb-wrap { padding: 12px 16px 0; }
    .cart-summary { padding: 22px 20px; }
    .cart-row {
      grid-template-columns: 72px 1fr auto;
      grid-template-areas:
        "img info remove"
        "img qty  sub";
      gap: 10px 14px;
      padding: 14px 14px;
    }
    .row-img { width: 72px; height: 72px; grid-area: img; }
    .row-info { grid-area: info; }
    .row-qty { grid-area: qty; justify-self: start; gap: 10px; }
    .row-sub { grid-area: sub; justify-self: end; min-width: 0; }
    .row-remove { grid-area: remove; justify-self: end; opacity: 1; }
    .row-name { font-size: 16px; }
    /* Bigger tap targets for quantity on mobile */
    .qty-btn { width: 36px; height: 36px; font-size: 17px; }

    /* Sticky WhatsApp CTA at the bottom of the viewport so it stays in
       reach on long carts. Reuses the same #whatsappBtn — duplicating it
       would risk wiring two listeners; instead we relocate the existing
       button visually with position:fixed and add a spacer below the
       summary so content isn't hidden behind it. */
    #whatsappBtn.cta-wa {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
      z-index: 60;
      width: auto;
      box-shadow: 0 -6px 18px rgba(15, 81, 50, 0.18), 0 0 0 0 rgba(37, 211, 102, 0.55);
    }
    .cart-actions { padding-bottom: 84px; }
  }
</style>

<script>
  import { getCart, addItem, removeItem, clear, onChange } from '../scripts/cart.js';
  import { syncCatalogFromApi } from '../scripts/catalogSync.js';
  import { isLoggedIn, getStoredPhone, me } from '../scripts/customerApi.js';
  import { createOrder, shortOrderId } from '../scripts/ordersApi.js';

  const WA_NUMBER = '21656731891';
  const FREE_DELIVERY_THRESHOLD = 100;
  const ORDER_SAVE_TIMEOUT_MS = 3000;

  const cartBody = document.getElementById('cartBody') as HTMLElement;
  const cartEmpty = document.getElementById('cartEmpty') as HTMLElement;
  const cartItems = document.getElementById('cartItems') as HTMLElement;
  const subtotalEl = document.getElementById('cartSubtotal') as HTMLElement;
  const deliveryEl = document.getElementById('cartDelivery') as HTMLElement;
  const totalEl = document.getElementById('cartTotal') as HTMLElement;
  const deliveryNote = document.getElementById('deliveryNote') as HTMLElement;
  const deliveryRow = deliveryEl.parentElement as HTMLElement;
  const whatsappBtn = document.getElementById('whatsappBtn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clearBtn') as HTMLElement;

  // ===== Guest phone modal =====
  const phoneModal = document.getElementById('phoneModal') as HTMLElement;
  const phoneOverlay = document.getElementById('phoneOverlay') as HTMLElement;
  const phoneClose = document.getElementById('phoneClose') as HTMLButtonElement;
  const phoneForm = document.getElementById('phoneForm') as HTMLFormElement;
  const phoneInput = document.getElementById('phoneInput') as HTMLInputElement;
  const phoneSkip = document.getElementById('phoneSkip') as HTMLButtonElement;
  const phoneErr = document.getElementById('phoneErr') as HTMLElement;

  // Cart items only store slug/name/size/price/qty. To show product images
  // we look them up from the live KV catalog (with /products.json fallback).
  let productMap: Record<string, any> = {};

  function escHtml(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]);
  }

  function bottleSvg() {
    return `<svg viewBox="0 0 80 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="22" y="22" width="36" height="68" rx="2" fill="#0E3A1F"/>
      <rect x="22" y="22" width="36" height="68" rx="2" fill="none" stroke="#D4AF37" stroke-width="0.6"/>
      <rect x="28" y="46" width="24" height="32" fill="#0E3A1F" stroke="#D4AF37" stroke-width="0.4"/>
      <text x="40" y="60" text-anchor="middle" font-family="Allura, cursive" font-size="13" fill="#D4AF37">Dadios</text>
      <rect x="30" y="10" width="20" height="14" rx="1.5" fill="#A87C45"/>
    </svg>`;
  }

  function rowHtml(item: any) {
    const product = productMap[item.slug];
    const image = product?.image;
    const subtotal = (Number(item.price) || 0) * (Number(item.qty) || 1);
    return `<li class="cart-row" data-slug="${escHtml(item.slug)}" data-size="${escHtml(item.size || '')}">
      <div class="row-img">
        ${image ? `<img src="${escHtml(image)}" alt="${escHtml(item.name)}" loading="lazy"/>` : bottleSvg()}
      </div>
      <div class="row-info">
        <div class="row-name">${escHtml(item.name)}</div>
        <div class="row-size">${escHtml(item.size || '')}</div>
        <div class="row-unit">${escHtml(item.price || 0)} DT / unité</div>
      </div>
      <div class="row-qty" role="group" aria-label="Quantité">
        <button type="button" class="qty-btn dec" aria-label="Diminuer">−</button>
        <span class="qty-val">${item.qty}</span>
        <button type="button" class="qty-btn inc" aria-label="Augmenter">+</button>
      </div>
      <div class="row-sub">${subtotal} DT</div>
      <button type="button" class="row-remove" aria-label="Retirer l'article">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
          <path d="M10 11v6"/>
          <path d="M14 11v6"/>
          <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
        </svg>
      </button>
    </li>`;
  }

  function computeTotals(cart: any) {
    let subtotal = 0;
    cart.items.forEach((i: any) => {
      subtotal += (Number(i.price) || 0) * (Number(i.qty) || 1);
    });
    return { subtotal };
  }

  function buildWhatsAppMessage(cart: any) {
    const lines = ['Bonjour Dadios, je souhaite commander :', ''];
    let total = 0;
    cart.items.forEach((item: any) => {
      const sub = (Number(item.price) || 0) * (Number(item.qty) || 1);
      total += sub;
      const sizeStr = item.size ? ` (${item.size})` : '';
      lines.push(`• ${item.name}${sizeStr} × ${item.qty} — ${sub} DT`);
    });
    lines.push('');
    lines.push(`Total : ${total} DT`);
    lines.push('');
    lines.push('Merci !');
    return lines.join('\n');
  }

  function render() {
    const cart = getCart();
    if (!cart.items.length) {
      cartBody.hidden = true;
      cartEmpty.hidden = false;
      return;
    }
    cartEmpty.hidden = true;
    cartBody.hidden = false;
    cartItems.innerHTML = cart.items.map(rowHtml).join('');

    const { subtotal } = computeTotals(cart);
    const freeDelivery = subtotal >= FREE_DELIVERY_THRESHOLD;
    subtotalEl.textContent = `${subtotal} DT`;
    deliveryEl.textContent = freeDelivery ? 'Offerte' : 'Calculée à la commande';
    deliveryRow.classList.toggle('free', freeDelivery);
    if (freeDelivery) {
      deliveryNote.textContent = '✓ Livraison offerte (commande > 100 DT)';
      deliveryNote.classList.add('success');
    } else {
      const remaining = FREE_DELIVERY_THRESHOLD - subtotal;
      deliveryNote.textContent = `Plus que ${remaining} DT pour la livraison offerte.`;
      deliveryNote.classList.remove('success');
    }
    totalEl.textContent = `${subtotal} DT`;
    // (URL is built on click, since we may append an order reference after save.)
  }

  function waUrl(text: string) {
    return `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(text)}`;
  }

  // ===== Cached customer info (logged-in fast path) =====
  // We try to resolve phone + name without a network call so the checkout
  // flow stays snappy. /me only runs as a fallback or as a background refresh.
  let cachedCustomer: { phone: string; name: string } | null = null;

  async function resolveCustomerInfo() {
    if (cachedCustomer) return cachedCustomer;
    if (!isLoggedIn()) return null;
    const storedPhone = getStoredPhone();
    if (storedPhone) {
      cachedCustomer = { phone: storedPhone, name: '' };
      // Refresh name in background; not blocking.
      me().then((res) => {
        if (res.ok && res.customer) {
          cachedCustomer = { phone: res.customer.phone || storedPhone, name: res.customer.name || '' };
        }
      }).catch(() => {});
      return cachedCustomer;
    }
    const res = await me();
    if (res.ok && res.customer) {
      cachedCustomer = { phone: res.customer.phone || '', name: res.customer.name || '' };
      return cachedCustomer;
    }
    return null;
  }

  // Kick off resolve on mount so the click is instant for logged-in users.
  resolveCustomerInfo();

  // ===== Guest phone modal =====
  type GuestPhoneResult = { cancelled: true } | { cancelled: false; phone: string; skipped: boolean };
  let pendingPhoneResolve: ((r: GuestPhoneResult) => void) | null = null;

  function openPhoneModal(): Promise<GuestPhoneResult> {
    return new Promise((resolve) => {
      pendingPhoneResolve = resolve;
      phoneInput.value = '';
      phoneErr.hidden = true;
      phoneModal.hidden = false;
      setTimeout(() => phoneInput.focus(), 50);
    });
  }

  function closePhoneModal(result: GuestPhoneResult) {
    phoneModal.hidden = true;
    if (pendingPhoneResolve) {
      const r = pendingPhoneResolve;
      pendingPhoneResolve = null;
      r(result);
    }
  }

  phoneClose.addEventListener('click', () => closePhoneModal({ cancelled: true }));
  phoneOverlay.addEventListener('click', () => closePhoneModal({ cancelled: true }));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !phoneModal.hidden) closePhoneModal({ cancelled: true });
  });
  phoneSkip.addEventListener('click', () => {
    closePhoneModal({ cancelled: false, phone: '', skipped: true });
  });
  phoneForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = phoneInput.value.trim();
    if (!v) {
      phoneErr.textContent = 'Numéro requis (ou utilisez « Continuer sans suivi »).';
      phoneErr.hidden = false;
      return;
    }
    closePhoneModal({ cancelled: false, phone: v, skipped: false });
  });

  // ===== "Commander sur WhatsApp" — save first, then open =====
  async function saveOrderWithTimeout(phone: string, customerName: string, cart: any) {
    const items = cart.items.map((i: any) => ({
      slug: i.slug,
      name: i.name,
      size: i.size,
      price: Number(i.price) || 0,
      qty: Number(i.qty) || 1,
      image: (productMap[i.slug] && productMap[i.slug].image) || null,
    }));
    const { subtotal } = computeTotals(cart);
    return Promise.race([
      createOrder({ phone, customerName, items, total: subtotal }),
      new Promise<{ ok: false; _timeout: true }>((resolve) =>
        setTimeout(() => resolve({ ok: false, _timeout: true }), ORDER_SAVE_TIMEOUT_MS),
      ),
    ]);
  }

  whatsappBtn.addEventListener('click', async () => {
    const cart = getCart();
    if (!cart.items.length) return;

    // Determine phone path:
    //   - logged in → use cached customer info
    //   - guest    → modal: "Continuer" (with phone) or "Continuer sans suivi"
    let phone = '';
    let customerName = '';
    if (isLoggedIn()) {
      const info = await resolveCustomerInfo();
      if (info) {
        phone = info.phone;
        customerName = info.name;
      }
    } else {
      const result = await openPhoneModal();
      if (result.cancelled) return; // user dismissed → keep cart, do nothing
      if (!result.skipped) phone = result.phone;
    }

    // Open the WhatsApp tab synchronously so popup blockers don't interfere
    // (the click is still the active user gesture when we call window.open).
    // We point it at about:blank first and rewrite its location once we have
    // the final URL. Falls back to same-tab navigation if window.open is null.
    const newWin = window.open('about:blank', '_blank', 'noopener,noreferrer');

    const baseMessage = buildWhatsAppMessage(cart);
    let finalMessage = baseMessage;

    if (phone) {
      const saveResult: any = await saveOrderWithTimeout(phone, customerName, cart);
      if (saveResult && saveResult.ok && saveResult.orderId) {
        finalMessage = baseMessage + `\n\nRéférence: #${shortOrderId(saveResult.orderId)}`;
      } else if (saveResult && !saveResult.ok && !saveResult._timeout && saveResult.error) {
        console.warn('Order save failed:', saveResult.error);
      }
    }

    const url = waUrl(finalMessage);
    if (newWin && !newWin.closed) {
      try { newWin.location.href = url; }
      catch { window.location.href = url; }
    } else {
      window.location.href = url;
    }

    // Clear the cart now that WhatsApp is open — same UX as before.
    clear();

    // Logged-in customers go to the dashboard so they see the new order.
    if (isLoggedIn() && phone) {
      setTimeout(() => window.location.assign('/compte/dashboard?ordered=1'), 120);
    }
  });

  // Event delegation: + / − / × per row
  cartItems.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const row = target.closest('.cart-row') as HTMLElement | null;
    if (!row) return;
    const slug = row.dataset.slug!;
    const size = row.dataset.size || '';
    const cart = getCart();
    const item = cart.items.find((i: any) => i.slug === slug && (i.size || '') === size);
    if (!item) return;
    if (target.classList.contains('inc')) {
      addItem({ slug, name: item.name, size, price: item.price, qty: 1 });
    } else if (target.classList.contains('dec')) {
      if ((item.qty || 1) <= 1) {
        removeItem(slug, size);
      } else {
        addItem({ slug, name: item.name, size, price: item.price, qty: -1 });
      }
    } else if (target.closest('.row-remove')) {
      // Animate slide-out, then drop the item. The existing onChange handler
      // re-renders the list — the row that disappeared just stays gone.
      const reduceMotion = typeof matchMedia === 'function'
        && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        removeItem(slug, size);
      } else {
        row.classList.add('removing');
        setTimeout(() => removeItem(slug, size), 300);
      }
    }
  });

  clearBtn.addEventListener('click', () => {
    if (!getCart().items.length) return;
    if (!confirm('Vider tout le panier ?')) return;
    clear();
  });

  onChange(render);

  // Initial: load product map for images, then render.
  (async () => {
    try {
      const products = await syncCatalogFromApi();
      if (products && products.length) {
        productMap = Object.fromEntries(products.map((p: any) => [p.slug, p]));
      } else {
        // KV empty — fall back to the static catalog shipped with the site.
        const res = await fetch('/products.json');
        if (res.ok) {
          const data = await res.json();
          productMap = Object.fromEntries((data.products || []).map((p: any) => [p.slug, p]));
        }
      }
    } catch {}
    render();
  })();
</script>
