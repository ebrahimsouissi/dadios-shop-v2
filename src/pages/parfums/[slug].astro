---
import Base from '../../layouts/Base.astro';
import data from '../../data/products.json';

export function getStaticPaths() {
  return data.products.map((p: any) => ({
    params: { slug: p.slug },
    props: { product: p, sizes: data.sizes, all: data.products },
  }));
}

const { product, sizes, all } = Astro.props;
const min = Math.min(...sizes.map((s: any) => s.price));
const max = Math.max(...sizes.map((s: any) => s.price));

const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: `${product.name} — Dadios Fragrance`,
  description: product.shortDescription,
  brand: { '@type': 'Brand', name: 'Dadios Fragrance' },
  category: 'Beauty / Fragrance',
  offers: sizes.map((s: any) => ({
    '@type': 'Offer',
    sku: `${product.slug}-${s.code}`,
    name: `${product.name} — ${s.label}`,
    price: s.price,
    priceCurrency: 'TND',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  })),
};

const related = all.filter((p: any) => p.slug !== product.slug && p.gender === product.gender).slice(0, 3);
const allNotes = [...product.topNotes, ...product.heartNotes, ...product.baseNotes];
---
<Base
  title={`${product.name} — Parfum ${product.gender} | Dadios Fragrance Tunisie`}
  description={`${product.shortDescription} À partir de ${min} DT — disponible en 20ML et 50ML. Livraison à Tunis.`}
  jsonLd={jsonLd}
>

<div class="crumb-wrap">
  <nav class="crumbs" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a> <span>·</span>
    <a href="/parfums">Parfums</a> <span>·</span>
    <span>{product.name}</span>
  </nav>
</div>

<section class="pd-hero">
  <div class="pd-grid">
    <div class="pd-img">
      <svg viewBox="0 0 320 420" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="160" cy="410" rx="110" ry="6" fill="rgba(0,0,0,0.12)"/>
        <rect x="100" y="80" width="120" height="320" rx="5" fill="#0E3A1F"/>
        <rect x="100" y="80" width="120" height="320" rx="5" fill="none" stroke="#D4AF37" stroke-width="1.2"/>
        <rect x="118" y="170" width="84" height="138" fill="#0E3A1F"/>
        <rect x="118" y="170" width="84" height="138" fill="none" stroke="#D4AF37" stroke-width="0.8"/>
        <text x="110" y="186" font-family="Cormorant Garamond, serif" font-size="9" fill="#D4AF37" opacity="0.85">❦</text>
        <text x="200" y="186" font-family="Cormorant Garamond, serif" font-size="9" fill="#D4AF37" opacity="0.85">❦</text>
        <text x="110" y="304" font-family="Cormorant Garamond, serif" font-size="9" fill="#D4AF37" opacity="0.85">❦</text>
        <text x="200" y="304" font-family="Cormorant Garamond, serif" font-size="9" fill="#D4AF37" opacity="0.85">❦</text>
        <text x="160" y="222" text-anchor="middle" font-family="Allura, cursive" font-size="44" fill="#D4AF37">Dadios</text>
        <text x="160" y="254" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="13" letter-spacing="7" fill="#D4AF37">FRAGRANCE</text>
        <line x1="135" y1="266" x2="185" y2="266" stroke="#D4AF37" stroke-width="0.6"/>
        <text x="160" y="284" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="10" fill="#D4AF37">{product.name}</text>
        <rect x="128" y="38" width="64" height="42" rx="4" fill="#A87C45"/>
        <rect x="136" y="24" width="48" height="18" rx="3" fill="#A87C45"/>
        <ellipse cx="160" cy="80" rx="60" ry="4" fill="rgba(0,0,0,0.18)"/>
      </svg>
    </div>
    <div class="pd-info">
      <div class="eyebrow">{product.family} · {product.gender}</div>
      <h1>{product.name}</h1>
      <!-- Review stats, populated client-side from /api/reviews stats -->
      <div class="pd-stars-row" id="pdStarsRow" hidden>
        <span class="pd-stars" id="pdStarsAvg"></span>
        <span class="pd-stars-count" id="pdStarsCount"></span>
      </div>
      <p class="pd-inspiration">Inspiré par <em>{product.inspiredBy}</em></p>
      <p class="pd-desc">{product.shortDescription}</p>

      <div class="pd-pick">
        <div class="eyebrow" style="margin-bottom:12px">Choisissez votre format</div>
        <div class="size-row">
          {sizes.map((s: any, i: number) => (
            <label class={`size-opt ${i === 1 ? 'active' : ''}`}>
              <input type="radio" name="size" value={s.code} checked={i === 1}/>
              <div class="size-label">{s.label}</div>
              <div class="size-price">{s.price} <small>DT</small></div>
            </label>
          ))}
        </div>
      </div>

      <!-- Wholesale price block, populated client-side for resellers only.
           Server strips wholesalePrice for non-resellers so this is gated
           by data presence, not just CSS visibility. -->
      <div id="pdWholesale" class="pd-wholesale" hidden>
        <div class="pd-wholesale-label">Prix grossiste · Tarif réservé aux Resellers</div>
        <div class="pd-wholesale-price" id="pdWholesalePrice"></div>
      </div>

      <div class="pd-cta">
        <button
          class="btn btn-primary"
          type="button"
          id="addToCartBtn"
          data-slug={product.slug}
          data-name={product.name}
        >Ajouter au panier</button>
        <button
          class="btn btn-outline pd-fav-btn"
          type="button"
          data-wishlist-toggle
          data-slug={product.slug}
          aria-pressed="false"
        >
          <svg class="heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="pd-fav-add">Ajouter aux favoris</span>
          <span class="pd-fav-remove">Retirer des favoris</span>
        </button>
        <a href={`https://wa.me/21656731891?text=Je%20veux%20commander%20${encodeURIComponent(product.name)}`} class="btn btn-gold" target="_blank">Commander sur WhatsApp</a>
      </div>

      <div class="pd-trust">
        <div><strong>{product.longevity}</strong><span>Tenue</span></div>
        <div><strong>{product.sillage}</strong><span>Sillage</span></div>
        <div><strong>{product.seasons.join(' · ')}</strong><span>Saisons</span></div>
      </div>
    </div>
  </div>
</section>

<section class="pd-notes">
  <div class="ornament">
    <svg viewBox="0 0 24 24"><path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="currentColor"/></svg>
  </div>
  <div class="section-head">
    <div class="eyebrow">Profil olfactif</div>
    <h2>Une pyramide composée à la main</h2>
  </div>
  <div class="pyramid">
    <div class="pyr-row">
      <div class="pyr-label">Notes de tête</div>
      <div class="pyr-notes">{product.topNotes.map((n: string) => <span class="note-pill">{n}</span>)}</div>
    </div>
    <div class="pyr-row">
      <div class="pyr-label">Notes de cœur</div>
      <div class="pyr-notes">{product.heartNotes.map((n: string) => <span class="note-pill">{n}</span>)}</div>
    </div>
    <div class="pyr-row">
      <div class="pyr-label">Notes de fond</div>
      <div class="pyr-notes">{product.baseNotes.map((n: string) => <span class="note-pill">{n}</span>)}</div>
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="related">
    <div class="section-head">
      <div class="eyebrow">Vous aimerez aussi</div>
      <h2>Dans la même famille</h2>
    </div>
    <div class="related-grid">
      {related.map((r: any) => (
        <a href={`/parfums/${r.slug}`} class="rel-card">
          <div class="rel-img">
            <svg viewBox="0 0 100 130">
              <rect x="32" y="22" width="36" height="96" rx="2" fill="#0E3A1F"/>
              <rect x="38" y="58" width="24" height="40" fill="#0E3A1F" stroke="#D4AF37" stroke-width="0.4"/>
              <text x="50" y="76" text-anchor="middle" font-family="Allura, cursive" font-size="10" fill="#D4AF37">Dadios</text>
              <rect x="42" y="10" width="16" height="13" rx="1.5" fill="#A87C45"/>
            </svg>
          </div>
          <div class="rel-name">{r.name}</div>
          <div class="rel-fam">{r.family}</div>
        </a>
      ))}
    </div>
  </section>
)}

<!-- ============ AVIS CLIENTS ============ -->
<section class="rev-section" id="revSection">
  <div class="ornament">
    <span class="line"></span>
    <svg viewBox="0 0 24 24"><path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="currentColor"/></svg>
    <span class="line"></span>
  </div>
  <div class="section-head">
    <div class="eyebrow">Avis clients</div>
    <h2>Ce qu'on en dit</h2>
  </div>

  <div id="revList" class="rev-list" aria-live="polite">
    <p class="rev-empty" id="revEmpty">Soyez le premier à laisser un avis sur ce parfum.</p>
  </div>

  <!-- Submit form (or login prompt). Visibility decided client-side -->
  <div class="rev-form-wrap" id="revFormWrap" hidden>
    <h3>Laisser un avis</h3>
    <p class="rev-form-help" id="revVerifyHint" hidden>Votre avis sera vérifié avant publication.</p>
    <form id="revForm" novalidate>
      <fieldset class="rev-stars-field" aria-label="Votre note">
        <legend>Votre note *</legend>
        <div class="rev-stars-input" id="revStarsInput" role="radiogroup">
          <!-- 5 buttons rendered by JS so they share state cleanly -->
        </div>
      </fieldset>
      <label class="rev-text-field">
        <span>Votre avis *</span>
        <textarea id="revText" rows="4" maxlength="300" placeholder="Quelles sont vos impressions ? (300 caractères max)"></textarea>
        <small><span id="revTextCount">0</span>/300</small>
      </label>
      <p id="revErr" class="rev-err" hidden></p>
      <p id="revOk" class="rev-ok" hidden></p>
      <div class="rev-form-actions">
        <button type="submit" id="revSubmit" class="btn btn-primary btn-sm">Publier mon avis</button>
      </div>
    </form>
  </div>

  <div class="rev-login-wrap" id="revLoginWrap" hidden>
    <p>
      <a href="/compte" class="rev-login-link">Connectez-vous</a>
      pour laisser un avis sur ce parfum.
    </p>
  </div>
</section>

</Base>

<style>
  .crumb-wrap { max-width: 1280px; margin: 0 auto; padding: 16px 32px 0; }
  .crumbs { font-size: 12px; color: var(--ink-mute); letter-spacing: 0.06em; }
  .crumbs a:hover { color: var(--emerald); }
  .crumbs span { margin: 0 6px; opacity: 0.5; }

  .pd-hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 32px 64px;
  }
  .pd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .pd-img {
    background: var(--cream-warm);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 48px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pd-img svg { width: 80%; height: auto; }

  .pd-info .eyebrow { margin-bottom: 16px; display: block; }
  .pd-info h1 {
    font-size: clamp(36px, 4vw, 52px);
    margin-bottom: 8px;
  }
  .pd-inspiration {
    font-style: italic;
    color: var(--ink-mute);
    margin-bottom: 24px;
    font-size: 14px;
  }
  .pd-desc {
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.75;
    margin-bottom: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }
  .pd-pick { margin-bottom: 32px; }
  .size-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .size-opt {
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    cursor: pointer;
    transition: all .2s;
    background: var(--cream-soft);
  }
  .size-opt input { display: none; }
  .size-opt.active {
    border-color: var(--emerald);
    background: var(--cream);
  }
  .size-opt:hover { border-color: var(--gold-soft); }
  .size-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 6px;
  }
  .size-price {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    color: var(--emerald);
  }
  .size-price small {
    font-size: 12px;
    color: var(--ink-mute);
    margin-left: 4px;
    font-weight: 400;
  }

  .pd-wholesale {
    background: rgba(14, 58, 31, 0.06);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pd-wholesale-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .pd-wholesale-price {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--emerald);
    font-weight: 500;
  }
  .pd-wholesale-price small { font-size: 13px; color: var(--ink-mute); margin-left: 4px; }
  .pd-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
  .pd-cta .btn { flex: 1; min-width: 200px; }
  .pd-fav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all .2s;
  }
  .pd-fav-btn .heart-icon { width: 18px; height: 18px; pointer-events: none; }
  .pd-fav-btn .pd-fav-remove { display: none; }
  .pd-fav-btn.filled { background: var(--emerald); color: var(--gold); border-color: var(--emerald); }
  .pd-fav-btn.filled .heart-icon { fill: var(--gold); stroke: var(--gold); }
  .pd-fav-btn.filled .pd-fav-add { display: none; }
  .pd-fav-btn.filled .pd-fav-remove { display: inline; }
  .pd-fav-btn.bump { animation: dadiosHeartBump 180ms ease-out; }
  @keyframes dadiosHeartBump {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .pd-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pd-trust div { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pd-trust strong {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--emerald);
    font-weight: 500;
    margin-bottom: 4px;
  }
  .pd-trust span {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .pd-notes {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 32px;
  }
  .section-head { text-align: center; margin-bottom: 48px; }
  .section-head .eyebrow { margin-bottom: 14px; display: block; }
  .section-head h2 { font-size: clamp(28px, 3.5vw, 38px); }
  .pyramid {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pyr-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: center;
    gap: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .pyr-row:last-child { border-bottom: none; }
  .pyr-label {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--gold-soft);
    font-style: italic;
  }
  .pyr-notes { display: flex; gap: 8px; flex-wrap: wrap; }
  .note-pill {
    background: var(--cream-warm);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink);
  }

  .related {
    max-width: 1280px;
    margin: 64px auto 0;
    padding: 0 32px 64px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    max-width: 800px;
    margin: 0 auto;
  }
  .rel-card {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    transition: all .2s;
  }
  .rel-card:hover { transform: translateY(-3px); border-color: var(--border-strong); }
  .rel-img {
    background: var(--cream-warm);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 14px;
  }
  .rel-img svg { width: 70%; height: auto; margin: 0 auto; display: block; }
  .rel-name { font-family: var(--font-display); font-size: 18px; color: var(--ink); }
  .rel-fam { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute); margin-top: 4px; }

  @media (max-width: 880px) {
    .pd-grid { grid-template-columns: 1fr; gap: 32px; }
    .pd-img { padding: 28px; }
    .pyr-row { grid-template-columns: 1fr; gap: 12px; }
  }

  /* ===== stars under title ===== */
  .pd-stars-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 0 14px;
  }
  .pd-stars { display: inline-flex; gap: 2px; }
  .pd-stars-count {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
  }

  /* shared star styling — both header and review cards */
  :global(.rev-star) { vertical-align: middle; }
  :global(.rev-star.filled path) { fill: #D4AF37; }
  :global(.rev-star.empty path) { fill: none; }

  /* ===== avis section ===== */
  .rev-section {
    max-width: 760px;
    margin: 0 auto 96px;
    padding: 0 32px;
  }
  .rev-section .section-head { margin-bottom: 32px; }
  .rev-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }
  .rev-empty {
    text-align: center;
    color: var(--ink-mute);
    font-style: italic;
    padding: 24px;
  }
  .rev-card {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 22px;
  }
  .rev-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .rev-card-author {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .rev-card-verified {
    background: rgba(14, 58, 31, 0.08);
    color: var(--emerald);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--emerald);
  }
  .rev-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .rev-card-stars { display: inline-flex; gap: 2px; }
  .rev-card-date {
    font-size: 12px;
    color: var(--ink-mute);
  }
  .rev-card-text {
    color: var(--ink-soft);
    line-height: 1.65;
    font-size: 15px;
    margin: 0;
  }

  /* ===== submit form ===== */
  .rev-form-wrap {
    background: var(--cream-soft);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 26px 22px;
  }
  .rev-form-wrap h3 {
    font-size: 20px;
    margin: 0 0 8px;
  }
  .rev-form-help {
    color: var(--ink-mute);
    font-size: 13px;
    margin: 0 0 18px;
  }
  .rev-stars-field {
    border: none;
    padding: 0;
    margin: 0 0 16px;
  }
  .rev-stars-field legend {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
    padding: 0;
  }
  .rev-stars-input {
    display: inline-flex;
    gap: 6px;
  }
  .rev-star-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    line-height: 0;
    border-radius: 4px;
    transition: transform .15s ease-out;
  }
  .rev-star-btn:hover { transform: scale(1.1); }
  .rev-star-btn:focus-visible { outline: 2px solid var(--emerald); outline-offset: 2px; }
  .rev-text-field { display: block; margin-bottom: 14px; }
  .rev-text-field > span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .rev-text-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    resize: vertical;
    min-height: 90px;
    box-sizing: border-box;
  }
  .rev-text-field textarea:focus { outline: none; border-color: var(--emerald); }
  .rev-text-field small {
    display: block;
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 4px;
  }
  .rev-err {
    background: rgba(178, 58, 31, 0.08);
    border: 1px solid #B23A1F;
    color: #8a2a14;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin: 0 0 10px;
  }
  .rev-ok {
    background: rgba(14, 58, 31, 0.06);
    border: 1px solid var(--emerald);
    color: var(--emerald);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin: 0 0 10px;
  }
  .rev-form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .rev-login-wrap {
    background: var(--cream-warm);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 22px;
    text-align: center;
    color: var(--ink-soft);
  }
  .rev-login-link {
    color: var(--emerald);
    text-decoration: underline;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .rev-section { padding: 0 16px; }
  }
</style>

<script>
  import { addItem, showAddedToast } from '../../scripts/cart.js';
  import { syncCatalogFromApi } from '../../scripts/catalogSync.js';

  // Phase 7a: when a reseller views the detail page, the worker's
  // /api/products (POST with sessionToken) returns this product enriched
  // with a wholesalePrice field. We just look it up and reveal the block.
  // Non-resellers never see this in the API response, so the block stays
  // hidden — server-side enforcement.
  (async () => {
    try {
      const wrap = document.getElementById('pdWholesale') as HTMLElement | null;
      const priceEl = document.getElementById('pdWholesalePrice') as HTMLElement | null;
      if (!wrap || !priceEl) return;
      const slug = (document.getElementById('addToCartBtn') as HTMLElement | null)?.getAttribute('data-slug');
      if (!slug) return;
      const products = await syncCatalogFromApi();
      if (!Array.isArray(products)) return;
      const live = products.find((p: any) => p.slug === slug);
      if (live && Number(live.wholesalePrice) > 0) {
        priceEl.innerHTML = `${Number(live.wholesalePrice)} <small>DT</small>`;
        wrap.hidden = false;
      }
    } catch {}
  })();
</script>

<script>
  import { addItem, showAddedToast } from '../../scripts/cart.js';

  document.querySelectorAll('.size-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.size-opt').forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      (opt.querySelector('input') as HTMLInputElement).checked = true;
    });
  });

  // The product page bakes sizes into the DOM via the radio inputs; read the
  // selected one when adding so the cart line knows which format.
  const addBtn = document.getElementById('addToCartBtn');
  addBtn?.addEventListener('click', () => {
    const selected = document.querySelector('input[name="size"]:checked') as HTMLInputElement | null;
    const sizeCode = selected?.value || '';
    const sizeLabel = selected
      ? (selected.closest('.size-opt')?.querySelector('.size-label')?.textContent || sizeCode).trim()
      : '';
    const priceText = selected
      ? (selected.closest('.size-opt')?.querySelector('.size-price')?.textContent || '').replace(/[^\d]/g, '')
      : '';
    const price = priceText ? Number(priceText) : 0;
    addItem({
      slug: addBtn.getAttribute('data-slug') || '',
      name: addBtn.getAttribute('data-name') || '',
      size: sizeLabel || sizeCode,
      price,
      qty: 1,
    });
    showAddedToast(`Ajouté · ${addBtn.getAttribute('data-name')} (${sizeLabel || sizeCode})`);
  });
</script>

<script>
  // ============ AVIS CLIENTS ============
  import { isLoggedIn } from '../../scripts/customerApi.js';
  import {
    getReviewStats,
    listReviewsForProduct,
    submitReview,
    starsHtml,
    formatReviewDate,
  } from '../../scripts/reviewsApi.js';

  const slugAttr = (document.getElementById('addToCartBtn') as HTMLElement | null)?.getAttribute('data-slug') || '';
  const productSlug = slugAttr;

  function esc(s: any) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[c]!);
  }

  // ===== stats in the header =====
  (async () => {
    if (!productSlug) return;
    const res = await getReviewStats(productSlug);
    if (!res.ok || !res.count) return;
    const row = document.getElementById('pdStarsRow') as HTMLElement;
    const avg = document.getElementById('pdStarsAvg') as HTMLElement;
    const count = document.getElementById('pdStarsCount') as HTMLElement;
    avg.innerHTML = starsHtml(res.average, 18);
    count.textContent = `${res.average} · ${res.count} avis`;
    row.hidden = false;
  })();

  // ===== list approved reviews =====
  const revList = document.getElementById('revList') as HTMLElement;
  const revEmpty = document.getElementById('revEmpty') as HTMLElement;

  function renderReviewCards(reviews: any[]) {
    if (!reviews.length) {
      revEmpty.hidden = false;
      // Remove any previously rendered cards
      revList.querySelectorAll('.rev-card').forEach((n) => n.remove());
      return;
    }
    revEmpty.hidden = true;
    revList.querySelectorAll('.rev-card').forEach((n) => n.remove());
    const frag = document.createDocumentFragment();
    reviews.forEach((r) => {
      const card = document.createElement('article');
      card.className = 'rev-card';
      card.innerHTML = `
        <div class="rev-card-head">
          <span class="rev-card-author">
            <span class="rev-card-author-name"></span>
            ${r.verified ? '<span class="rev-card-verified">Achat vérifié</span>' : ''}
          </span>
          <div class="rev-card-meta">
            <span class="rev-card-stars">${starsHtml(r.rating, 14)}</span>
            <span class="rev-card-date">${esc(formatReviewDate(r.createdAt))}</span>
          </div>
        </div>
        <p class="rev-card-text"></p>
      `;
      // Inject author + text via textContent to guarantee no HTML
      (card.querySelector('.rev-card-author-name') as HTMLElement).textContent =
        r.customerName || 'Client Dadios';
      (card.querySelector('.rev-card-text') as HTMLElement).textContent = r.text || '';
      frag.appendChild(card);
    });
    revList.appendChild(frag);
  }

  async function loadReviews() {
    if (!productSlug) return;
    const res = await listReviewsForProduct(productSlug);
    if (!res.ok) return;
    renderReviewCards(res.reviews || []);
  }
  loadReviews();

  // ===== Submit form / login prompt =====
  const formWrap = document.getElementById('revFormWrap') as HTMLElement;
  const loginWrap = document.getElementById('revLoginWrap') as HTMLElement;
  const starsInput = document.getElementById('revStarsInput') as HTMLElement;
  const revText = document.getElementById('revText') as HTMLTextAreaElement;
  const revTextCount = document.getElementById('revTextCount') as HTMLElement;
  const revSubmit = document.getElementById('revSubmit') as HTMLButtonElement;
  const revErr = document.getElementById('revErr') as HTMLElement;
  const revOk = document.getElementById('revOk') as HTMLElement;
  const revVerifyHint = document.getElementById('revVerifyHint') as HTMLElement;
  const revForm = document.getElementById('revForm') as HTMLFormElement;

  let currentRating = 0;

  function renderStarButtons() {
    starsInput.innerHTML = '';
    for (let i = 1; i <= 5; i++) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'rev-star-btn';
      b.setAttribute('role', 'radio');
      b.setAttribute('aria-label', `${i} étoile${i > 1 ? 's' : ''}`);
      b.setAttribute('data-rating', String(i));
      b.setAttribute('aria-checked', i === currentRating ? 'true' : 'false');
      b.innerHTML = starsHtml(i <= currentRating ? 5 : 0, 26).split('</svg>')[0] + '</svg>';
      // (We use a single star icon per button; the helper renders 5 — slice
      // to the first one.) Simpler: render manually.
      b.innerHTML = `<svg class="rev-star ${i <= currentRating ? 'filled' : 'empty'}" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path d="M12 2 L14.39 8.96 L21.8 9.27 L15.96 13.97 L17.91 21.02 L12 17.06 L6.09 21.02 L8.04 13.97 L2.2 9.27 L9.61 8.96 Z"
          fill="${i <= currentRating ? '#D4AF37' : 'none'}" stroke="#D4AF37" stroke-width="1.4" stroke-linejoin="round"/>
      </svg>`;
      starsInput.appendChild(b);
    }
  }
  starsInput.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.rev-star-btn') as HTMLElement | null;
    if (!btn) return;
    currentRating = Number(btn.getAttribute('data-rating')) || 0;
    renderStarButtons();
  });
  renderStarButtons();

  revText.addEventListener('input', () => {
    revTextCount.textContent = String(revText.value.length);
  });

  revForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    revErr.hidden = true; revOk.hidden = true;
    if (!currentRating) {
      revErr.textContent = 'Sélectionnez une note (1 à 5 étoiles).';
      revErr.hidden = false;
      return;
    }
    const text = revText.value.trim();
    if (!text) {
      revErr.textContent = 'Écrivez votre avis avant de publier.';
      revErr.hidden = false;
      return;
    }
    revSubmit.disabled = true;
    revSubmit.textContent = 'Envoi…';
    try {
      const res = await submitReview({ productId: productSlug, rating: currentRating, text });
      if (!res.ok) {
        revErr.textContent = res.error || 'Impossible de publier votre avis.';
        revErr.hidden = false;
        return;
      }
      if (res.review && res.review.status === 'approved') {
        revOk.textContent = '✓ Votre avis a été publié. Merci !';
      } else {
        revOk.textContent = '✓ Votre avis a bien été envoyé et sera publié après vérification.';
      }
      revOk.hidden = false;
      currentRating = 0;
      revText.value = '';
      revTextCount.textContent = '0';
      renderStarButtons();
      // Refresh visible list + stats so an auto-approved review appears now
      loadReviews();
      const stats = await getReviewStats(productSlug);
      if (stats.ok && stats.count) {
        (document.getElementById('pdStarsAvg') as HTMLElement).innerHTML = starsHtml(stats.average, 18);
        (document.getElementById('pdStarsCount') as HTMLElement).textContent = `${stats.average} · ${stats.count} avis`;
        (document.getElementById('pdStarsRow') as HTMLElement).hidden = false;
      }
    } finally {
      revSubmit.disabled = false;
      revSubmit.textContent = 'Publier mon avis';
    }
  });

  // ===== Decide which CTA to show (login link or form) =====
  if (isLoggedIn()) {
    formWrap.hidden = false;
    // Best-effort: tell the user up-front whether their review will be
    // auto-approved or held for moderation. We can't know without asking
    // the worker (the verified check happens server-side), so we just show
    // the generic hint — keeps the page snappy and copy clear.
    revVerifyHint.hidden = false;
  } else {
    loginWrap.hidden = false;
  }
</script>
