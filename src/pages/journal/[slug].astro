---
/**
 * Article detail page.
 *
 * Phase 10 bugfix: the previous version baked the full article body into
 * the static HTML via Astro.props. That meant any slug not enumerated at
 * build time hit a hard 404, and during a failed build-time fetch even
 * known slugs went missing.
 *
 * New strategy:
 *   - getStaticPaths enumerates whatever slugs we can find (seed +
 *     whatever the public list_published endpoint returns at build time).
 *     If the Worker is unreachable during the build, we still pre-render
 *     the seed slug so /journal/<seed> always exists.
 *   - The page itself ships only an empty skeleton. The client script
 *     reads the slug from the URL, fetches /api/articles get_published,
 *     and fills in title / body / hero / meta / related.
 *   - Slugs that were published *between* builds 404 in static, but the
 *     404 page also mounts the same skeleton + renderer (see 404.astro),
 *     so the user still reads the article — URL bar stays at
 *     /journal/<slug>.
 */
import Base from '../../layouts/Base.astro';
import ArticleSkeleton from '../../components/ArticleSkeleton.astro';

// NOTE: getStaticPaths runs *before* and is fully isolated from the rest
// of the frontmatter — module-level consts (imports, variables) declared
// outside it are NOT visible inside. The Worker URL is inlined here on
// purpose. Don't refactor it out.
export async function getStaticPaths() {
  const WORKER_URL = 'https://cold-cloud-895a.dadios-fragrances.workers.dev';
  let slugs = [];
  try {
    const res = await fetch(`${WORKER_URL}/api/articles`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'list_published', limit: 200 }),
    });
    if (res.ok) {
      const data = await res.json();
      if (data && data.ok && Array.isArray(data.articles)) {
        slugs = [...new Set(data.articles.map((a) => a.slug).filter(Boolean))];
      }
    }
  } catch {
    // Build-time fetch failed (network, CORS, Access, …). 404.astro
    // catches any /journal/<slug> hit at runtime.
  }
  return slugs.map((slug) => ({ params: { slug } }));
}
---
<Base
  title="Journal — Dadios Fragrance"
  description="Récits, conseils et inspirations autour de la parfumerie artisanale Dadios."
>

<ArticleSkeleton />

</Base>

<script>
  import { initArticlePage, slugFromCurrentPath } from '../../scripts/articlePage.js';

  const slug = slugFromCurrentPath();
  const isPreview = new URLSearchParams(window.location.search).get('preview') === '1';
  initArticlePage(slug, { isPreview });
</script>
